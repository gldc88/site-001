---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  eager?: boolean;
  class?: string;
  sizes?: string;
}

const {
  src,
  alt,
  width,
  height,
  eager = false,
  class: className = '',
  sizes,
} = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : 'auto'}
  sizes={sizes}
  class={className}
/>
