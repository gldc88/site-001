---
/**
 * Estimator , GROUNDSPEC's live CAD takeoff (website25, round 2). Pick a shape + finish, drag the
 * dimensions, toggle a perimeter fence; the SVG morphs and area / fence run / indicative budget update
 * live. The spec is saved to localStorage so it travels to the quote page.
 */
import { TEXTURES, SHEET } from '../../data/groundspec';
---
<div class="grid lg:grid-cols-12 border border-white/10 bg-[#161616]/80 backdrop-blur-sm shadow-2xl rounded-sm overflow-hidden ring-1 ring-white/5">
  <div class="lg:col-span-7 border-b lg:border-b-0 lg:border-r border-white/10 bg-black/40 min-h-[360px]">
    <div class="w-full h-full flex items-center justify-center p-6">
      <svg id="cadCanvas" viewBox="0 0 800 600" class="w-full h-full max-w-[600px]" preserveAspectRatio="xMidYMid meet">
        <defs>
          <pattern id="brickPattern" width="20" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="19" height="9" fill="#2a2a2a" stroke="#444" stroke-width="1"/></pattern>
          <pattern id="slabPattern" width="40" height="40" patternUnits="userSpaceOnUse"><rect width="39" height="39" fill="#1f1f1f" stroke="#3a3a3a" stroke-width="1"/></pattern>
          <pattern id="herringPattern" width="30" height="30" patternUnits="userSpaceOnUse" patternTransform="rotate(30)"><path d="M0 0 L15 0 L15 30 L0 30 Z M15 15 L30 15" stroke="#444" fill="#262626"/></pattern>
          <marker id="arrowHead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto"><path d="M0,0 L0,6 L9,3 z" fill="#aaa" /></marker>
        </defs>
        <rect x="50" y="50" width="700" height="500" fill="none" stroke="#222" stroke-width="1" stroke-dasharray="8 4" />
        <g id="projectGroup" transform="translate(400, 300)">
          <g id="fences" fill="none" stroke="#10b981" stroke-width="4" opacity="0"></g>
          <path id="svgMainPath" fill="url(#brickPattern)" stroke="#eab308" stroke-width="3" d="" />
          <g id="dims" opacity="0.7">
            <line id="dimW" stroke="#888" marker-start="url(#arrowHead)" marker-end="url(#arrowHead)" />
            <text id="txtW" fill="#eab308" font-family="monospace" font-size="16" font-weight="bold" text-anchor="middle"></text>
            <line id="dimL" stroke="#888" marker-start="url(#arrowHead)" marker-end="url(#arrowHead)" />
            <text id="txtL" fill="#eab308" font-family="monospace" font-size="16" font-weight="bold" text-anchor="middle"></text>
          </g>
        </g>
      </svg>
    </div>
  </div>
  <div class="lg:col-span-5 flex flex-col bg-[#141414]/90">
    <div class="p-6 flex-1 space-y-8">
      <div>
        <div class="flex justify-between items-center mb-4"><h3 class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest">Layout & finish</h3><span class="font-mono text-yellow-600 text-[10px] font-bold tracking-widest">{SHEET.id}</span></div>
        <div class="grid grid-cols-2 gap-2 mb-3">
          <button class="shape-btn h-10 border border-white/10 bg-black/50 text-[10px] font-black uppercase transition-colors active" data-shape="rect">Rectangle</button>
          <button class="shape-btn h-10 border border-white/10 bg-black/50 text-[10px] font-black uppercase transition-colors" data-shape="lshape">L-Shape</button>
        </div>
        <select id="inTexture" aria-label="Paving finish" class="w-full h-10 bg-black/50 border border-white/10 text-xs font-bold text-zinc-300 px-3 uppercase outline-none focus:border-yellow-500 transition-colors">
          {TEXTURES.map((t) => <option value={t.value} data-rate={String(t.rate)}>{t.label}</option>)}
        </select>
        <button id="fenceToggle" type="button" class="mt-3 w-full h-10 border border-white/10 bg-black/50 text-[10px] font-black uppercase transition-colors text-zinc-300" aria-pressed="false">+ Fence the perimeter</button>
      </div>
      <div>
        <h3 class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest mb-4">Dimensions</h3>
        <div class="space-y-5">
          <div><div class="flex justify-between text-[10px] font-black text-zinc-400 mb-2 uppercase tracking-widest"><span>Width</span><span id="valWidth" class="text-yellow-500 font-mono">6.0m</span></div><input id="inWidth" type="range" min="3" max="15" step="0.5" value="6" aria-label="Width in metres" class="w-full" /></div>
          <div><div class="flex justify-between text-[10px] font-black text-zinc-400 mb-2 uppercase tracking-widest"><span>Length</span><span id="valLength" class="text-yellow-500 font-mono">4.0m</span></div><input id="inLength" type="range" min="3" max="10" step="0.5" value="4" aria-label="Length in metres" class="w-full" /></div>
          <div id="lControls" class="hidden space-y-5 pt-4 border-t border-white/10">
            <div><div class="flex justify-between text-[10px] font-black text-zinc-400 mb-2 uppercase tracking-widest"><span>Inset Width</span><span id="valOffW" class="text-yellow-500 font-mono">2.0m</span></div><input id="inOffW" type="range" min="1" max="5" step="0.5" value="2" aria-label="Inset width in metres" class="w-full" /></div>
            <div><div class="flex justify-between text-[10px] font-black text-zinc-400 mb-2 uppercase tracking-widest"><span>Inset Length</span><span id="valOffL" class="text-yellow-500 font-mono">2.0m</span></div><input id="inOffL" type="range" min="1" max="5" step="0.5" value="2" aria-label="Inset length in metres" class="w-full" /></div>
          </div>
        </div>
      </div>
    </div>
    <div class="bg-black/80 p-6 border-t border-white/10">
      <div class="grid grid-cols-2 gap-5 mb-5">
        <div><span class="block text-[10px] font-bold text-zinc-500 uppercase mb-1">Paving area</span><span id="outArea" class="text-2xl font-black text-yellow-500 font-mono tracking-tighter">--</span></div>
        <div><span class="block text-[10px] font-bold text-zinc-500 uppercase mb-1">Fence run</span><span id="outFenceLen" class="text-2xl font-black text-emerald-500 font-mono tracking-tighter">--</span></div>
      </div>
      <div class="border-t border-white/10 pt-4 mb-5">
        <span class="block text-[10px] font-bold text-zinc-500 uppercase mb-1">Indicative budget <span class="text-zinc-600">· materials + base + labour</span></span>
        <span id="outBudget" class="text-xl font-black text-white font-mono tracking-tight">--</span>
      </div>
      <a href="/website25/quote" id="toQuote" class="block w-full bg-white text-black py-4 text-center text-sm font-black uppercase tracking-[0.2em] hover:bg-yellow-500 transition-all shadow-xl">Request a detailed quote →</a>
    </div>
  </div>
</div>

<script>
  const PPM = 35;
  const $ = (id: string) => document.getElementById(id);
  const inWidth = $('inWidth') as HTMLInputElement | null, inLength = $('inLength') as HTMLInputElement | null;
  if (inWidth && inLength) {
    const inOffW = $('inOffW') as HTMLInputElement, inOffL = $('inOffL') as HTMLInputElement;
    const inTexture = $('inTexture') as HTMLSelectElement;
    const shapeBtns = Array.from(document.querySelectorAll<HTMLElement>('.shape-btn'));
    const fenceToggle = $('fenceToggle');
    const lControls = $('lControls');
    const svgMainPath = $('svgMainPath'), fencesG = $('fences');
    const dimW = $('dimW'), txtW = $('txtW'), dimL = $('dimL'), txtL = $('txtL');
    const outArea = $('outArea'), outFence = $('outFenceLen'), outBudget = $('outBudget');
    let shape = 'rect', fenceOn = false;
    const fmt = (n: number) => new Intl.NumberFormat('nl-NL', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);

    function update() {
      const w = parseFloat(inWidth!.value), l = parseFloat(inLength!.value);
      const ow = parseFloat(inOffW.value), ol = parseFloat(inOffL.value);
      $('valWidth')!.textContent = w.toFixed(1) + 'm'; $('valLength')!.textContent = l.toFixed(1) + 'm';
      $('valOffW')!.textContent = ow.toFixed(1) + 'm'; $('valOffL')!.textContent = ol.toFixed(1) + 'm';
      const hW = (w * PPM) / 2, hL = (l * PPM) / 2, pxOw = ow * PPM, pxOl = ol * PPM;
      let pathData = '', area = 0, perimeter = 0;
      if (shape === 'rect') {
        pathData = `M${-hW} ${-hL} L${hW} ${-hL} L${hW} ${hL} L${-hW} ${hL} Z`;
        area = w * l; perimeter = w * 2 + l * 2; lControls!.classList.add('hidden');
      } else {
        pathData = `M${-hW} ${-hL} L${hW} ${-hL} L${hW} ${hL - pxOl} L${hW - pxOw} ${hL - pxOl} L${hW - pxOw} ${hL} L${-hW} ${hL} Z`;
        area = w * l - ow * ol; perimeter = w * 2 + l * 2; lControls!.classList.remove('hidden');
      }
      svgMainPath!.setAttribute('d', pathData);
      svgMainPath!.setAttribute('fill', `url(#${inTexture.value})`);
      if (fenceOn) {
        fencesG!.setAttribute('opacity', '1');
        const off = 7; let fp = '';
        if (shape === 'rect') fp = `M${-hW - off} ${-hL - off} L${hW + off} ${-hL - off} L${hW + off} ${hL + off} L${-hW - off} ${hL + off} Z`;
        else fp = `M${-hW - off} ${-hL - off} L${hW + off} ${-hL - off} L${hW + off} ${hL - pxOl} L${hW - pxOw + off} ${hL - pxOl} L${hW - pxOw + off} ${hL + off} L${-hW - off} ${hL + off} Z`;
        fencesG!.innerHTML = `<path d="${fp}" stroke-dasharray="2 9" stroke-linecap="round" /><path d="${fp}" opacity="0.25" />`;
      } else { fencesG!.setAttribute('opacity', '0'); fencesG!.innerHTML = ''; }
      dimW!.setAttribute('x1', String(-hW)); dimW!.setAttribute('x2', String(hW)); dimW!.setAttribute('y1', String(-hL - 22)); dimW!.setAttribute('y2', String(-hL - 22));
      txtW!.setAttribute('x', '0'); txtW!.setAttribute('y', String(-hL - 32)); txtW!.textContent = w.toFixed(1) + 'm';
      dimL!.setAttribute('x1', String(-hW - 22)); dimL!.setAttribute('x2', String(-hW - 22)); dimL!.setAttribute('y1', String(-hL)); dimL!.setAttribute('y2', String(hL));
      txtL!.setAttribute('x', String(-hW - 34)); txtL!.setAttribute('y', '0'); txtL!.setAttribute('transform', `rotate(-90, ${-hW - 34}, 0)`); txtL!.textContent = l.toFixed(1) + 'm';
      const rate = parseFloat(inTexture.selectedOptions[0].dataset.rate || '100');
      const paving = area * (rate + 42);
      const fence = fenceOn ? perimeter * 95 : 0;
      const total = paving + fence;
      outArea!.textContent = area.toFixed(1) + ' m²';
      outFence!.textContent = fenceOn ? perimeter.toFixed(1) + ' m' : ',';
      outBudget!.textContent = `${fmt(total * 0.9)} – ${fmt(total * 1.12)}`;
      const finish = inTexture.selectedOptions[0].textContent;
      const lastSpec = `${shape === 'rect' ? 'Rectangle' : 'L-shape'} · ${finish} · ${area.toFixed(1)}m²${fenceOn ? ` · fence ${perimeter.toFixed(1)}m` : ''} · ${outBudget!.textContent}`;
      try { localStorage.setItem('groundspec-spec', lastSpec); } catch (e) {}
    }
    [inWidth, inLength, inOffW, inOffL, inTexture].forEach((el) => el.addEventListener('input', update));
    shapeBtns.forEach((b) => b.addEventListener('click', () => { shapeBtns.forEach((x) => x.classList.remove('active')); b.classList.add('active'); shape = b.dataset.shape || 'rect'; update(); }));
    fenceToggle?.addEventListener('click', () => { fenceOn = !fenceOn; fenceToggle.classList.toggle('on', fenceOn); fenceToggle.setAttribute('aria-pressed', String(fenceOn)); fenceToggle.textContent = fenceOn ? '✓ Fencing the perimeter' : '+ Fence the perimeter'; update(); });
    update();
  }
</script>