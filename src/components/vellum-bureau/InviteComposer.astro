---
/**
 * InviteComposer , VELLUM's live save-the-date composer (website27, round 2). Names + date + city render a
 * live invitation card; the values persist to localStorage so the inquiry page can prefill date + city.
 */
---
<div class="grid lg:grid-cols-2 gap-8 items-stretch">
  <div class="flex flex-col">
    <div class="rounded-2xl border border-[var(--line)] bg-[#fbf8f3]/70 p-7">
      <h2 class="font-display text-3xl font-semibold">Effortless is engineered.</h2>
      <p class="mt-3 text-[var(--mut)] leading-relaxed">We take ownership of the full production, so the day stays calm , every moving part has a brief, a timing, and a contingency.</p>
      <p class="mt-3 font-display italic text-lg text-[var(--ink)]">Begin with the happy part. Set your names and date, and watch your save-the-date take shape.</p>
    </div>
    <div class="mt-5 flex flex-col gap-4">
      <div class="grid sm:grid-cols-2 gap-4">
        <label class="block text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--mut)]">First partner
          <input id="cA" type="text" value="Sophie" maxlength="22" autocomplete="off" class="mt-2 w-full bg-white/60 border border-[var(--line)] rounded-lg px-4 py-3 text-sm text-[var(--ink)] outline-none focus:border-[var(--champ)] transition-colors normal-case tracking-normal" /></label>
        <label class="block text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--mut)]">Second partner
          <input id="cB" type="text" value="Julian" maxlength="22" autocomplete="off" class="mt-2 w-full bg-white/60 border border-[var(--line)] rounded-lg px-4 py-3 text-sm text-[var(--ink)] outline-none focus:border-[var(--champ)] transition-colors normal-case tracking-normal" /></label>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <label class="block text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--mut)]">Wedding date
          <input id="cDate" type="date" value="2026-09-12" class="mt-2 w-full bg-white/60 border border-[var(--line)] rounded-lg px-4 py-3 text-sm text-[var(--ink)] outline-none focus:border-[var(--champ)] transition-colors" /></label>
        <label class="block text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--mut)]">Venue / city
          <input id="cCity" type="text" value="Amsterdam" maxlength="28" autocomplete="off" class="mt-2 w-full bg-white/60 border border-[var(--line)] rounded-lg px-4 py-3 text-sm text-[var(--ink)] outline-none focus:border-[var(--champ)] transition-colors normal-case tracking-normal" /></label>
      </div>
      <a href="/website27/inquiry" class="mt-2 inline-flex w-fit text-[11px] font-semibold uppercase tracking-[0.2em] text-[var(--ink)] border-b border-[var(--champ)] pb-1 hover:text-[var(--champ-d)] transition-colors">Carry this into an inquiry →</a>
    </div>
  </div>

  <figure id="inviteCard" class="relative m-0 rounded-2xl border border-[var(--champ)]/40 bg-gradient-to-br from-[#fffdf8] to-[#f3ead8] p-10 flex flex-col items-center justify-center text-center shadow-[0_30px_70px_-30px_rgba(199,161,102,0.5)] min-h-[420px]" aria-live="polite">
    <span class="absolute inset-3 rounded-xl border border-[var(--champ)]/30 pointer-events-none"></span>
    <span class="text-[10px] uppercase tracking-[0.44em] text-[var(--mut)]">Save the Date</span>
    <span id="inMono" class="font-display text-5xl font-semibold gold-text mt-6 tracking-[0.15em]">S J</span>
    <span id="inNames" class="font-display italic font-semibold text-3xl mt-5 leading-tight text-[var(--ink)]">Sophie<span class="text-[var(--champ)] mx-2">&amp;</span>Julian</span>
    <span class="block w-16 h-px bg-[var(--champ)]/50 my-5"></span>
    <span id="inDate" class="font-display text-xl text-[var(--ink)]">Saturday, 12 September 2026</span>
    <span id="inCity" class="text-[11px] uppercase tracking-[0.26em] text-[var(--mut)] mt-2">AMSTERDAM</span>
  </figure>
</div>

<script>
  const cA = document.getElementById('cA') as HTMLInputElement | null;
  const cB = document.getElementById('cB') as HTMLInputElement | null;
  const cDate = document.getElementById('cDate') as HTMLInputElement | null;
  const cCity = document.getElementById('cCity') as HTMLInputElement | null;
  const inMono = document.getElementById('inMono'), inNames = document.getElementById('inNames');
  const inDate = document.getElementById('inDate'), inCity = document.getElementById('inCity');
  if (cA && cB && cDate && cCity && inNames) {
    const initial = (s: string) => (s.trim()[0] || '').toUpperCase();
    const clean = (s: string) => s.replace(/[<>&]/g, '');
    const fmt = (v: string) => { if (!v) return 'The date, set in time'; const d = new Date(v + 'T00:00:00'); return isNaN(d.getTime()) ? 'The date, set in time' : d.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }); };
    const render = () => {
      const a = cA.value.trim() || 'Your name', b = cB.value.trim() || 'Their name';
      inNames!.innerHTML = clean(a) + '<span class="text-[var(--champ)] mx-2">&amp;</span>' + clean(b);
      if (inMono) inMono.textContent = (initial(a) + ' ' + initial(b)).trim() || '&';
      if (inDate) inDate.textContent = fmt(cDate.value);
      if (inCity) inCity.textContent = (cCity.value.trim() || 'The place').toUpperCase();
      try { localStorage.setItem('vellum-invite', JSON.stringify({ a, b, date: cDate.value, city: cCity.value.trim() })); } catch (e) {}
    };
    [cA, cB, cDate, cCity].forEach((el) => el.addEventListener('input', render));
    render();
  }
</script>