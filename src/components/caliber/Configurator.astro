---
/**
 * Configurator , CALIBER's live watch builder (website29, round 2). Case / dial / hands / strap options
 * drive a live SVG watch (CSS vars), a build ticket, a price, and a ref code; the spec persists to
 * localStorage so the commission page can read it. Data-attribute driven (no inline onclick).
 */
import { OPTIONS, BASE_PRICE, EMAIL } from '../../data/caliber';
const GROUPS = Object.keys(OPTIONS);
---
<div class="grid lg:grid-cols-[1fr_0.9fr] gap-8 items-start">
  <div class="flex flex-col gap-7">
    {GROUPS.map((g) => (
      <div class="config-group">
        <h4 class="text-[10px] font-semibold uppercase tracking-[0.2em] text-[var(--mut)] mb-3">{OPTIONS[g].title}</h4>
        <div class="grid sm:grid-cols-2 gap-2.5">
          {OPTIONS[g].opts.map((o, i) => (
            <button type="button" data-group={g} data-val={o.v} class={`opt-btn text-left text-[12px] px-4 py-3 rounded border transition-colors ${i === 0 ? 'selected border-[var(--accent)] bg-[var(--accent)]/10 text-[var(--ink)]' : 'border-[var(--line)] bg-white/[0.02] text-[var(--mut)] hover:border-[var(--accent)]/50'}`}>{o.label}{o.price > 0 ? <span class="block text-[10px] accent mt-0.5">+€{o.price}</span> : ''}</button>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="flex flex-col gap-6">
    <div class="rounded-2xl border border-[var(--line)] bg-black/40 p-6 flex flex-col items-center">
      <svg class="watch-svg w-full max-w-[240px] h-auto" id="watch" viewBox="0 0 260 360" role="img" aria-label="Live preview of your configured watch"
        style="--case-fill:#c2ccd6;--case-edge:#9aa6b2;--dial-fill:#0c0e12;--marker-fill:rgba(238,242,246,0.85);--sun-op:0;--avn-op:0;--hand-fill:#e8edf2;--strap-fill:#3a4654;--strap-tex:rgba(255,255,255,0.22)">
        <defs><radialGradient id="sun29" cx="50%" cy="40%" r="62%"><stop offset="0" stop-color="rgba(255,255,255,0.4)" /><stop offset="58%" stop-color="rgba(255,255,255,0)" /></radialGradient></defs>
        <path d="M95 72 L90 0 L170 0 L165 72 Z" fill="var(--strap-fill)" stroke="rgba(0,0,0,0.35)" stroke-width="1" />
        <path d="M95 278 L90 360 L170 360 L165 278 Z" fill="var(--strap-fill)" stroke="rgba(0,0,0,0.35)" stroke-width="1" />
        <g stroke="var(--strap-tex)" stroke-width="1.2" fill="none"><line x1="100" y1="22" x2="160" y2="22" /><line x1="100" y1="46" x2="160" y2="46" /><line x1="100" y1="314" x2="160" y2="314" /><line x1="100" y1="338" x2="160" y2="338" /></g>
        <rect x="226" y="166" width="14" height="18" rx="3" fill="var(--case-edge)" stroke="rgba(0,0,0,0.35)" />
        <circle cx="130" cy="175" r="104" fill="var(--case-fill)" stroke="rgba(0,0,0,0.4)" stroke-width="2" />
        <circle cx="130" cy="175" r="92" fill="var(--case-edge)" />
        <circle cx="130" cy="175" r="84" fill="var(--dial-fill)" />
        <circle cx="130" cy="175" r="84" fill="url(#sun29)" opacity="var(--sun-op)" />
        <g opacity="var(--avn-op)" fill="#dbe7ff"><circle cx="96" cy="150" r="1.1" /><circle cx="150" cy="132" r="0.9" /><circle cx="168" cy="190" r="1.2" /><circle cx="110" cy="210" r="1" /><circle cx="140" cy="200" r="0.8" /><circle cx="92" cy="186" r="0.9" /><circle cx="158" cy="160" r="1" /><circle cx="124" cy="138" r="0.8" /><circle cx="176" cy="214" r="0.9" /><circle cx="104" cy="168" r="0.7" /></g>
        <g fill="var(--marker-fill)">
          <rect x="127" y="97" width="6" height="15" rx="1" transform="rotate(0 130 175)" /><rect x="128" y="99" width="4" height="12" rx="1" transform="rotate(30 130 175)" /><rect x="128" y="99" width="4" height="12" rx="1" transform="rotate(60 130 175)" /><rect x="127" y="97" width="6" height="15" rx="1" transform="rotate(90 130 175)" /><rect x="128" y="99" width="4" height="12" rx="1" transform="rotate(120 130 175)" /><rect x="128" y="99" width="4" height="12" rx="1" transform="rotate(150 130 175)" /><rect x="127" y="97" width="6" height="15" rx="1" transform="rotate(180 130 175)" /><rect x="128" y="99" width="4" height="12" rx="1" transform="rotate(210 130 175)" /><rect x="128" y="99" width="4" height="12" rx="1" transform="rotate(240 130 175)" /><rect x="127" y="97" width="6" height="15" rx="1" transform="rotate(270 130 175)" /><rect x="128" y="99" width="4" height="12" rx="1" transform="rotate(300 130 175)" /><rect x="128" y="99" width="4" height="12" rx="1" transform="rotate(330 130 175)" />
        </g>
        <text x="130" y="148" text-anchor="middle" fill="var(--marker-fill)" font-family="ui-sans-serif,system-ui" font-size="10" letter-spacing="3" opacity="0.9">CALIBER</text>
        <text x="130" y="214" text-anchor="middle" fill="var(--marker-fill)" font-family="ui-monospace,monospace" font-size="7" letter-spacing="2" opacity="0.6">AUTOMATIC</text>
        <g transform="rotate(305 130 175)"><rect x="126" y="108" width="8" height="74" rx="4" fill="var(--hand-fill)" /></g>
        <g transform="rotate(60 130 175)"><rect x="127.5" y="92" width="5" height="90" rx="2.5" fill="var(--hand-fill)" /></g>
        <g id="watchSec" class="sec"><rect x="129" y="86" width="2" height="104" fill="#ff6b6b" /><rect x="128.5" y="175" width="3" height="22" fill="#ff6b6b" /></g>
        <circle cx="130" cy="175" r="6" fill="var(--hand-fill)" stroke="#ff6b6b" stroke-width="1" />
      </svg>
      <div class="text-[10px] uppercase tracking-[0.12em] text-[var(--mut)] mt-4">Live preview · <span id="watch-cap-ref">REF-STL-BLK-POL-NATO</span></div>
    </div>

    <div class="rounded-2xl border border-[var(--line)] bg-white/[0.02] p-6">
      <div class="text-[10px] font-semibold uppercase tracking-[0.2em] accent mb-4">Build Ticket</div>
      <div class="flex flex-col gap-2 text-sm">
        <div class="flex justify-between"><span class="text-[var(--mut)]">Case</span><span id="out-case">316L Steel</span></div>
        <div class="flex justify-between"><span class="text-[var(--mut)]">Dial</span><span id="out-dial">Matte Black</span></div>
        <div class="flex justify-between"><span class="text-[var(--mut)]">Hands</span><span id="out-hands">Polished</span></div>
        <div class="flex justify-between"><span class="text-[var(--mut)]">Strap</span><span id="out-strap">NATO Nylon</span></div>
      </div>
      <div class="flex items-center justify-between mt-5 pt-4 border-t border-[var(--line)]"><span class="text-[10px] uppercase tracking-[0.2em] text-[var(--mut)]">Estimate</span><div id="out-price" class="text-2xl font-bold accent">€1.450</div></div>
      <div id="ref-code" class="mt-3 text-[11px] font-mono text-[var(--mut)] tracking-widest">REF-STL-BLK-POL-NATO</div>
      <a id="mail-link" href="/website29/commission" class="block w-full text-center mt-5 bg-[var(--accent)] text-black px-5 py-3.5 text-[11px] font-bold uppercase tracking-[0.2em] rounded hover:bg-white transition-colors">Take to commission →</a>
    </div>
  </div>
</div>

<script>
  import { OPTIONS, BASE_PRICE, EMAIL } from '../../data/caliber';
  const state: Record<string, string> = {};
  Object.keys(OPTIONS).forEach((g) => { state[g] = OPTIONS[g].opts[0].v; });
  const find = (g: string, v: string) => OPTIONS[g].opts.find((o) => o.v === v);

  const price = () => {
    let total = BASE_PRICE;
    Object.keys(state).forEach((g) => { total += find(g, state[g])?.price || 0; });
    return total.toLocaleString('de-DE');
  };
  const refCode = () => `REF-${['case', 'dial', 'hands', 'strap'].map((g) => find(g, state[g])?.code).join('-')}`;

  const apply = (g: string) => {
    const o = find(g, state[g]); if (!o) return;
    const watch = document.getElementById('watch');
    if (watch) Object.entries(o.vis).forEach(([k, val]) => watch.style.setProperty(k, val));
    const outEl = document.getElementById('out-' + g); if (outEl) outEl.textContent = state[g];
  };
  const render = () => {
    Object.keys(state).forEach(apply);
    const ref = refCode(), pr = '€' + price();
    const pEl = document.getElementById('out-price'); if (pEl) pEl.textContent = pr;
    const rEl = document.getElementById('ref-code'); if (rEl) rEl.textContent = ref;
    const cap = document.getElementById('watch-cap-ref'); if (cap) cap.textContent = ref;
    try { localStorage.setItem('caliber-build', JSON.stringify({ ...state, ref, price: pr })); } catch (e) {}
    const ml = document.getElementById('mail-link');
    if (ml) {
      const body = encodeURIComponent(`Hello,\n\nI'd like to request a quote for the configuration below:\n\nReference: ${ref}\nCase: ${state.case}\nDial: ${state.dial}\nHands: ${state.hands}\nStrap: ${state.strap}\n\nEstimated Configuration Price: ${pr}\n\nPlease share lead time and deposit terms.\n\nThank you.`);
      ml.setAttribute('data-mailto', `mailto:${EMAIL}?subject=${encodeURIComponent('Commission Inquiry: ' + ref)}&body=${body}`);
    }
  };

  document.querySelectorAll<HTMLElement>('.opt-btn').forEach((btn) => btn.addEventListener('click', () => {
    const g = btn.dataset.group!, v = btn.dataset.val!;
    state[g] = v;
    document.querySelectorAll<HTMLElement>(`.opt-btn[data-group="${g}"]`).forEach((b) => {
      const on = b === btn;
      b.classList.toggle('selected', on);
      b.classList.toggle('border-[var(--accent)]', on); b.classList.toggle('bg-[var(--accent)]/10', on); b.classList.toggle('text-[var(--ink)]', on);
      b.classList.toggle('border-[var(--line)]', !on); b.classList.toggle('bg-white/[0.02]', !on); b.classList.toggle('text-[var(--mut)]', !on);
    });
    render();
  }));
  render();
</script>