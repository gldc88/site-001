---
/**
 * HEARTH & GROVE , Home (website21, round 2 multi-page). Tailwind + scroll-season.
 * Hero + services / specimens / process teasers + contact CTA. Scrolling shifts the season (stone -> forest).
 */
import HearthLayout from '../../layouts/HearthLayout.astro';
import { SERVICES, SPECIMENS, PROCESS } from '../../data/hearth.ts';
---

<HearthLayout title="Hearth & Grove , Landscape Architecture" description="Landscape architecture: garden design, build, and care. Planned in advance, executed without noise. The survey behind this page greens as the seasons turn.">
  <section class="relative min-h-screen flex items-center pt-28 pb-20 px-6">
    <div class="max-w-7xl mx-auto w-full grid lg:grid-cols-[1.2fr_1fr] gap-16 items-center">
      <div data-reveal="up">
        <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full border text-[10px] uppercase tracking-[0.2em] mb-10" style="border-color: var(--border-color); color: var(--text-muted)">
          <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background-color: var(--accent-color)"></span>
          Landscape architecture · est. 2009
        </div>
        <h1 class="font-serif text-5xl lg:text-7xl leading-[1.02] text-white mb-8">Gardens, planned in advance , <span class="italic" style="color: var(--accent-color)">built with restraint.</span></h1>
        <p class="text-lg max-w-md mb-12" style="color: var(--text-muted)">Garden design, build, and care. Planned in advance, executed without noise , the survey behind this page greens as the seasons turn. Scroll, and watch it change.</p>
        <div class="flex flex-wrap items-center gap-6">
          <a href="/website21/contact" class="px-8 py-4 text-black text-xs font-bold uppercase tracking-widest rounded transition-transform hover:-translate-y-0.5" style="background-color: var(--accent-color)">Initiate project</a>
          <a href="/website21/specimens" class="text-xs font-bold uppercase tracking-widest border-b pb-1 transition-colors hover:text-white" style="color: var(--text-muted); border-color: var(--border-color)">Browse specimens</a>
        </div>
      </div>
      <div class="relative aspect-square rounded-2xl border overflow-hidden" style="border-color: var(--border-color); background-color: var(--card-bg)" data-reveal="up">
        <svg viewBox="0 0 400 400" class="w-full h-full opacity-70" fill="none" stroke="currentColor" style="color: var(--text-muted)" stroke-width="0.6">
          {Array.from({ length: 9 }).map((_, i) => <ellipse cx="200" cy="210" rx={40 + i * 22} ry={26 + i * 15} />)}
          <circle cx="300" cy="100" r="40" style="stroke: var(--accent-color); opacity: 0.5" stroke-width="1" />
          <path d="M40 360 L360 40" stroke-dasharray="3 6" style="opacity:0.5" />
        </svg>
        <div class="absolute bottom-6 left-6 text-[10px] font-mono uppercase" style="color: var(--accent-color); opacity: 0.85">Fig 01 · Site topography analysis</div>
      </div>
    </div>
  </section>

  <section class="px-6 py-28 border-t" style="border-color: var(--border-color)">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-end justify-between mb-14" data-reveal="up">
        <h2 class="font-serif text-4xl lg:text-5xl text-white">What we do.</h2>
        <a href="/website21/services" class="text-xs font-bold uppercase tracking-widest hover:text-white transition-colors" style="color: var(--accent-color)">All services →</a>
      </div>
      <div class="grid md:grid-cols-3 gap-px rounded-2xl overflow-hidden border" style="border-color: var(--border-color); background-color: var(--border-color)">
        {SERVICES.map((s) => (
          <div class="p-8 transition-colors" style="background-color: var(--card-bg-dark)" data-reveal="up">
            <h3 class="font-serif text-2xl text-white mb-3">{s.title}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--text-muted)">{s.line}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 py-28 border-t" style="border-color: var(--border-color)">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
      <div data-reveal="up">
        <span class="text-[10px] font-bold uppercase tracking-widest" style="color: var(--accent-color)">Botanical curation</span>
        <h2 class="font-serif text-4xl lg:text-5xl text-white mt-4 mb-6">A library you can plant.</h2>
        <p class="text-base max-w-md mb-8" style="color: var(--text-muted)">Mature, characterful specimens , sourced, held, and placed by hand. Compose a grove of your own and bring it to the inquiry.</p>
        <a href="/website21/specimens" class="text-xs font-bold uppercase tracking-widest border-b pb-1 hover:text-white transition-colors" style="color: var(--accent-color); border-color: var(--accent-color)">Compose a grove →</a>
      </div>
      <div class="grid grid-cols-2 gap-3" data-reveal="up">
        {SPECIMENS.slice(0, 4).map((s) => (
          <div class="p-5 rounded-xl border" style="border-color: var(--border-color); background-color: var(--card-bg)">
            <div class="font-serif italic text-white text-lg leading-tight">{s.common}</div>
            <div class="text-[11px] font-mono mt-2" style="color: var(--text-muted)">{s.height} · {s.age}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 py-28 border-t" style="border-color: var(--border-color)">
    <div class="max-w-7xl mx-auto">
      <h2 class="font-serif text-4xl lg:text-5xl text-white mb-14" data-reveal="up">How a garden happens.</h2>
      <div class="grid md:grid-cols-4 gap-8" data-stagger="0.1">
        {PROCESS.map((p, idx) => (
          <div data-reveal="up">
            <span class="text-4xl font-serif" style="color: var(--accent-color); opacity: 0.7">0{idx + 1}</span>
            <h3 class="font-serif text-xl text-white mt-4 mb-3">{p.step}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--text-muted)">{p.line}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 py-32 border-t" style="border-color: var(--border-color)">
    <div class="max-w-4xl mx-auto text-center" data-reveal="up">
      <h2 class="font-serif text-4xl lg:text-6xl text-white mb-6">Plant something that lasts.</h2>
      <p class="text-lg max-w-xl mx-auto mb-10" style="color: var(--text-muted)">Tell us about the site. We reply within two working days with a plan and a way forward.</p>
      <a href="/website21/contact" class="inline-block px-10 py-4 text-black text-xs font-bold uppercase tracking-widest rounded transition-transform hover:-translate-y-0.5" style="background-color: var(--accent-color)">Start a project</a>
    </div>
  </section>
</HearthLayout>