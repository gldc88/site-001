---
/**
 * HEARTH & GROVE , Services (website21, round 2). The six services.
 */
import HearthLayout from '../../layouts/HearthLayout.astro';
import { SERVICES } from '../../data/hearth.ts';
---

<HearthLayout title="Services | Hearth & Grove" description="Garden design, planting & soil, hardscaping, drainage & irrigation, lighting, and maintenance , the full landscape practice." active="services">
  <section class="px-6 pt-36 pb-16">
    <div class="max-w-7xl mx-auto">
      <span class="text-[10px] font-bold uppercase tracking-widest" style="color: var(--accent-color)">Services</span>
      <h1 class="font-serif text-5xl lg:text-7xl text-white mt-5 leading-[1.04]">Design, build, and <span class="italic" style="color: var(--accent-color)">care.</span></h1>
      <p class="text-lg max-w-xl mt-8" style="color: var(--text-muted)">One practice across the whole life of a garden , from the first survey to the maintenance that keeps it stable. Scroll the page and the survey behind it greens.</p>
    </div>
  </section>

  <section class="px-6 pb-28">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-px rounded-2xl overflow-hidden border" style="border-color: var(--border-color); background-color: var(--border-color)">
      {SERVICES.map((s, i) => (
        <div class="p-10 group transition-colors" style="background-color: var(--card-bg-dark)" data-reveal="up">
          <div class="flex items-baseline justify-between mb-4">
            <h3 class="font-serif text-3xl text-white">{s.title}</h3>
            <span class="text-xs font-mono" style="color: var(--accent-color); opacity: 0.7">0{i + 1}</span>
          </div>
          <p class="text-base leading-relaxed max-w-md" style="color: var(--text-muted)">{s.line}</p>
        </div>
      ))}
    </div>
    <div class="max-w-7xl mx-auto mt-16 flex justify-center" data-reveal="up">
      <a href="/website21/contact" class="px-10 py-4 text-black text-xs font-bold uppercase tracking-widest rounded transition-transform hover:-translate-y-0.5" style="background-color: var(--accent-color)">Discuss a project</a>
    </div>
  </section>
</HearthLayout>