---
/**
 * HEARTH & GROVE , Specimens (website21, round 2). Signature: compose a grove (multi-select) , the
 * selection persists to localStorage and is attached to the inquiry on the Contact page.
 */
import HearthLayout from '../../layouts/HearthLayout.astro';
import { SPECIMENS } from '../../data/hearth.ts';
---

<HearthLayout title="Specimens | Hearth & Grove" description="A buildable specimen library , mature, characterful trees. Compose a grove and bring it to your inquiry." active="specimens">
  <section class="px-6 pt-36 pb-12">
    <div class="max-w-7xl mx-auto">
      <span class="text-[10px] font-bold uppercase tracking-widest" style="color: var(--accent-color)">Botanical curation</span>
      <h1 class="font-serif text-5xl lg:text-7xl text-white mt-5 leading-[1.04]">Compose your <span class="italic" style="color: var(--accent-color)">grove.</span></h1>
      <p class="text-lg max-w-xl mt-8" style="color: var(--text-muted)">Mature, characterful specimens, sourced and placed by hand. Tap to add them to a grove , it follows you to the inquiry, so we already know what you're picturing.</p>
    </div>
  </section>

  <section class="px-6 pb-10">
    <div class="max-w-7xl mx-auto rounded-xl border p-6 md:p-8 grid md:grid-cols-[auto_1fr] gap-8 items-center" style="border-color: var(--border-color); background-color: var(--card-bg)" id="siteReading">
      <div class="relative w-40 h-40 mx-auto">
        <svg viewBox="0 0 160 160" class="w-full h-full" aria-hidden="true">
          <circle cx="80" cy="80" r="72" fill="none" stroke="var(--border-color)" />
          <circle cx="80" cy="80" r="4" fill="var(--accent-color)" />
          <line id="compassNeedle" x1="80" y1="80" x2="80" y2="22" stroke="var(--accent-color)" stroke-width="3" stroke-linecap="round" style="transform-origin: 80px 80px; transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);" />
        </svg>
        <button type="button" class="aspect-btn absolute left-1/2 top-0 -translate-x-1/2 -translate-y-1/2" data-aspect="N" role="radio" aria-checked="false">N</button>
        <button type="button" class="aspect-btn absolute right-0 top-1/2 translate-x-1/2 -translate-y-1/2" data-aspect="E" role="radio" aria-checked="false">E</button>
        <button type="button" class="aspect-btn absolute left-1/2 bottom-0 -translate-x-1/2 translate-y-1/2" data-aspect="S" role="radio" aria-checked="false">S</button>
        <button type="button" class="aspect-btn absolute left-0 top-1/2 -translate-x-1/2 -translate-y-1/2" data-aspect="W" role="radio" aria-checked="false">W</button>
      </div>
      <div>
        <span class="text-[10px] font-mono uppercase tracking-[0.2em]" style="color: var(--accent-color)">Site Reading</span>
        <h2 class="font-serif text-2xl text-white mt-2">Which way does your garden face?</h2>
        <p class="mt-3 text-sm leading-relaxed" style="color: var(--text-muted)">Point the needle and the library re-reads itself ,
          what thrives in your light rises to the top.</p>
        <p class="mt-4 font-serif italic" style="color: var(--accent-color)" id="aspectNote" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <section class="px-6 pb-28">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center justify-between mb-8 flex-wrap gap-4">
        <h2 class="font-serif text-2xl text-white">The library</h2>
        <div id="groveSummary" class="text-sm font-serif italic text-right" style="color: var(--accent-color)">No specimens yet , tap to plant.</div>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {SPECIMENS.map((s) => (
          <button data-specimen data-char={s.char} data-height={s.height} data-latin={s.latin} data-light={s.light} aria-pressed="false"
            class="text-left p-6 rounded-xl border transition-colors group relative" style="border-color: var(--border-color); background-color: var(--card-bg)">
            <div class="flex items-start justify-between">
              <div>
                <div class="font-serif italic text-xl text-white leading-tight">{s.common}</div>
                <div class="text-[11px] font-mono mt-1" style="color: var(--text-muted)">{s.latin}</div>
              </div>
              <span class="grove-tick w-6 h-6 rounded-full border flex items-center justify-center text-transparent flex-shrink-0 transition-colors" style="border-color: var(--border-color)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="w-3.5 h-3.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
            </div>
            <div class="flex gap-4 mt-6 text-[11px] font-mono uppercase tracking-wider" style="color: var(--text-muted)">
              <span>{s.height}</span><span>·</span><span>{s.age}</span><span>·</span><span class="truncate">{s.char}</span>
            </div>
            <span class="light-badge hidden absolute top-3 right-12 text-[9px] font-mono uppercase tracking-widest px-2 py-1 rounded" style="background-color: var(--accent-color); color: #06120d">Suits your light</span>
          </button>
        ))}
      </div>
      <div class="mt-12 flex justify-center" data-reveal="up">
        <a href="/website21/contact" class="px-10 py-4 text-black text-xs font-bold uppercase tracking-widest rounded transition-transform hover:-translate-y-0.5" style="background-color: var(--accent-color)">Bring this grove to an inquiry</a>
      </div>
    </div>
  </section>

  <style>
    .aspect-btn { width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--border-color); background: var(--card-bg); color: var(--text-muted); font-family: ui-monospace, monospace; font-size: 11px; cursor: pointer; transition: color .3s, border-color .3s; }
    .aspect-btn:hover { color: #fff; }
    .aspect-btn[aria-checked='true'] { color: #06120d; background: var(--accent-color); border-color: var(--accent-color); }
    .aspect-btn:focus-visible { outline: 1px solid var(--accent-color); outline-offset: 2px; }
    @media (prefers-reduced-motion: reduce) { #compassNeedle { transition: none !important; } }
  </style>

  <script>
    /* R3 "Site Reading" , oriënteer het kompas; de bibliotheek leest zich opnieuw. */
    (() => {
      const KEY = 'hearth-aspect';
      const DEG: Record<string, number> = { N: 0, E: 90, S: 180, W: 270 };
      const PREF: Record<string, string> = { N: 'shade', E: 'part-shade', S: 'full-sun', W: 'part-shade' };
      const NOTE: Record<string, string> = {
        N: 'North-facing: quiet light. Yew and understory lead.',
        E: 'East-facing: gentle morning sun. Maples and blossom first.',
        S: 'South-facing: full light. Pine, ironwood and birch lead.',
        W: 'West-facing: warm afternoons. Maples and blossom carry it.',
      };
      const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.aspect-btn'));
      const needle = document.getElementById('compassNeedle');
      const note = document.getElementById('aspectNote');
      const grid = document.querySelector('[data-specimen]')?.parentElement;
      if (!btns.length || !grid) return;
      const apply = (aspect: string) => {
        btns.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.aspect === aspect)));
        if (needle) needle.style.transform = `rotate(${DEG[aspect] || 0}deg)`;
        if (note) note.textContent = NOTE[aspect] || '';
        const pref = PREF[aspect];
        const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-specimen]'));
        cards
          .slice()
          .sort((a, b) => Number(b.dataset.light === pref) - Number(a.dataset.light === pref))
          .forEach((card) => grid.appendChild(card));
        cards.forEach((card) => {
          const badge = card.querySelector('.light-badge');
          badge?.classList.toggle('hidden', card.dataset.light !== pref);
        });
      };
      btns.forEach((b) => b.addEventListener('click', () => {
        const a = b.dataset.aspect || 'S';
        try { localStorage.setItem(KEY, a); } catch { /* private mode */ }
        apply(a);
      }));
      try { const saved = localStorage.getItem(KEY); if (saved) apply(saved); } catch { /* private mode */ }
    })();
  </script>

  <script>
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-specimen]'));
    const summary = document.getElementById('groveSummary');
    const KEY = 'hearth-grove';
    const saved = new Set<string>(JSON.parse(localStorage.getItem(KEY) || '[]'));

    function paintBtn(b: HTMLElement, on: boolean) {
      b.setAttribute('aria-pressed', String(on));
      const tick = b.querySelector<HTMLElement>('.grove-tick');
      if (on) { b.style.backgroundColor = 'color-mix(in srgb, var(--accent-color) 8%, transparent)'; if (tick) { tick.style.color = '#04140d'; tick.style.backgroundColor = 'var(--accent-color)'; tick.style.borderColor = 'var(--accent-color)'; } }
      else { b.style.backgroundColor = 'var(--card-bg)'; if (tick) { tick.style.color = 'transparent'; tick.style.backgroundColor = 'transparent'; tick.style.borderColor = 'var(--border-color)'; } }
    }
    function update() {
      if (!summary) return;
      const chosen = items.filter((b) => b.getAttribute('aria-pressed') === 'true');
      if (chosen.length === 0) { summary.textContent = 'No specimens yet , tap to plant.'; }
      else {
        const chars = chosen.map((g) => (g.dataset.char || '').split(' · ')[0].toLowerCase());
        const heights = chosen.map((g) => parseFloat(g.dataset.height || '0')).filter(Boolean);
        const lo = Math.min(...heights), hi = Math.max(...heights);
        summary.textContent = `${chosen.length} specimen${chosen.length > 1 ? 's' : ''} · ${[...new Set(chars)].join(', ')} · ${lo.toFixed(1)}–${hi.toFixed(1)}m`;
      }
      localStorage.setItem(KEY, JSON.stringify(chosen.map((b) => b.dataset.latin)));
    }
    items.forEach((b) => {
      if (saved.has(b.dataset.latin || '')) paintBtn(b, true);
      b.addEventListener('click', () => { paintBtn(b, b.getAttribute('aria-pressed') !== 'true'); update(); });
    });
    update();
  </script>
</HearthLayout>