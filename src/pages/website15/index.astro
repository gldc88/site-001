---
/**
 * VULCANIC ATELIER , Home (website15, round 2 multi-page).
 * The reservation surface: strata tiles raise the thermal circuit (feed the magma), a heat slider feeds
 * it directly, forge teaser, reserve CTA. The chosen heat persists across pages.
 */
import VulcanLayout from '../../layouts/VulcanLayout.astro';
import { STRATA, FORGE, PILLS } from '../../data/vulcan';
---

<VulcanLayout title="Vulcanic Atelier , Reservation-Only Volcanic Retreat" description="A reservation-only volcanic retreat over a living magma surface: basalt suites, a thermal circuit, obsidian dining. Warmth without the noise.">
  <header class="hero">
    <div class="hero-inner">
      <span class="kicker" id="heroKicker">Reservation-only · volcanic retreat</span>
      <h1 class="hero-title" id="heroTitle">Warmth, kept quiet.</h1>
      <p class="hero-copy" id="heroCopy">A retreat over a living magma surface. Choose a stratum and the heat behind everything rises to it , and follows you across the night. Or feed the forge yourself.</p>

      <div class="surface" id="heroActions">
        <div class="strata-row" role="group" aria-label="Choose a stratum">
          {STRATA.map((s) => (
            <button class="strata" data-suite data-key={s.key} data-heat={String(s.heat)} aria-pressed="false">
              <div class="st-top"><span class="st-name">{s.name}</span><span class="st-heat">{s.heat}°</span></div>
              <span class="st-stat">{s.stat}</span>
            </button>
          ))}
        </div>

        <div class="forge-tool panel ember">
          <div class="ft-head"><span class="kicker">Feed the forge</span><b id="heatVal">84°</b></div>
          <input id="heatSlider" class="heat" type="range" min="0" max="100" value="84" aria-label="Heat" />
          <div class="ft-foot"><span>cooled basalt</span><span>open magma</span></div>
          <div class="now-line"><span>NOW ◇</span><b id="nowName">Thermal Deck</b></div>
        </div>
      </div>

      <div class="pills" id="heroPills">{PILLS.map((p) => <span class="pill">{p}</span>)}</div>
    </div>
  </header>

  <section class="section tight">
    <div class="sec-head"><div><span class="kicker">The Forge</span><h2>Engineered to be quiet.</h2></div><p>Heat you can feel, noise you can't hear. <a class="inline-link" href="/website15/forge">Inside the forge →</a></p></div>
    <div class="forge-strip panel">
      {FORGE.map((f) => (<div class="forge-spec"><span class="fs-k">{f.k}</span><span class="fs-v">{f.v}</span></div>))}
    </div>
  </section>

  <section class="section tight">
    <div class="sec-head"><div><span class="kicker">Strata</span><h2>Five ways to spend a night.</h2></div><p><a class="inline-link" href="/website15/strata">All strata →</a></p></div>
    <div class="strata-teaser">
      {STRATA.map((s) => (
        <a href="/website15/strata" class="stt-row" data-reveal="up"><span class="stt-name">{s.name}</span><span class="stt-stat">{s.stat}</span><span class="stt-heat">{s.heat}°</span><span class="stt-arw">→</span></a>
      ))}
    </div>
  </section>

  <section class="section tight reserve-cta">
    <div class="rc-inner panel ember" data-reveal="up">
      <span class="kicker c">Reserve</span>
      <h2>A night is held, not sold.</h2>
      <p>Capacity is capped at twenty-four guests. Request a night and we confirm by hand.</p>
      <a href="/website15/reserve" class="btn-cta" style="margin-top:26px;">Request a night</a>
    </div>
  </section>

  <style>
    .hero { position: relative; min-height: 100svh; display: flex; align-items: center; padding: 90px clamp(20px,5vw,56px) 40px; }
    .hero-inner { position: relative; z-index: 10; max-width: 1240px; margin: 0 auto; width: 100%; }
    .hero-title { font-size: clamp(3rem, 9vw, 7.5rem); line-height: 0.96; color: #fff; margin: 16px 0 18px; }
    .hero-title .ch { display: inline-block; will-change: transform; }
    .hero-copy { color: var(--muted); max-width: 50ch; font-size: 1.1rem; }
    .surface { margin-top: 34px; display: grid; grid-template-columns: 1.5fr 1fr; gap: 16px; align-items: stretch; }
    .strata-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; min-width: 0; }
    .strata { text-align: left; padding: 15px 16px; border: 1px solid var(--line2); border-radius: 5px; background: var(--panel); transition: all 0.3s; }
    .strata:hover { border-color: var(--line); }
    .strata[aria-pressed='true'] { border-color: var(--magma1); box-shadow: inset 0 0 40px -24px var(--magma1); }
    .st-top { display: flex; justify-content: space-between; align-items: baseline; }
    .st-name { font-family: var(--disp); font-size: 1.2rem; color: #fff; }
    .st-heat { font-family: var(--mono); font-size: 11px; color: var(--magma2); }
    .st-stat { font-family: var(--mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }

    .forge-tool { padding: 22px; display: flex; flex-direction: column; }
    .ft-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .ft-head b { font-family: var(--mono); font-size: 1.3rem; color: var(--magma2); }
    .ft-foot { display: flex; justify-content: space-between; margin-top: 10px; font-family: var(--mono); font-size: 8px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); }
    .now-line { margin-top: auto; padding-top: 20px; display: flex; align-items: baseline; gap: 10px; }
    .now-line span { font-family: var(--mono); font-size: 9px; letter-spacing: 0.16em; color: var(--muted); }
    .now-line b { font-family: var(--disp); font-size: 1.5rem; color: #fff; }

    .pills { margin-top: 22px; display: flex; gap: 8px; flex-wrap: wrap; }
    .pill { font-family: var(--mono); font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--magma2); border: 1px solid var(--line); padding: 7px 12px; border-radius: 100px; }

    .forge-strip { display: grid; grid-template-columns: repeat(4, 1fr); }
    .forge-spec { padding: 26px clamp(16px,2.4vw,28px); border-right: 1px solid var(--line2); }
    .forge-spec:last-child { border-right: none; }
    .fs-k { font-family: var(--mono); font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--magma2); display: block; }
    .fs-v { font-family: var(--disp); font-size: 1.6rem; color: #fff; margin-top: 8px; display: block; }

    .strata-teaser { display: flex; flex-direction: column; }
    .stt-row { display: grid; grid-template-columns: 1.4fr 1fr auto auto; gap: 22px; align-items: center; padding: 22px 8px; border-top: 1px solid var(--line2); transition: background 0.3s, padding-left 0.3s; }
    .stt-row:last-child { border-bottom: 1px solid var(--line2); }
    .stt-row:hover { background: rgba(255,122,24,0.05); padding-left: 14px; }
    .stt-name { font-family: var(--disp); font-size: 1.5rem; color: #fff; }
    .stt-stat { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
    .stt-heat { font-family: var(--mono); font-size: 12px; color: var(--magma2); }
    .stt-arw { color: var(--magma2); opacity: 0; transition: opacity 0.3s, transform 0.3s; }
    .stt-row:hover .stt-arw { opacity: 1; transform: translateX(4px); }

    .reserve-cta { display: flex; justify-content: center; }
    .rc-inner { text-align: center; padding: clamp(40px,6vw,72px) clamp(24px,4vw,56px); max-width: 700px; }
    .rc-inner .kicker { justify-content: center; }
    .rc-inner h2 { font-size: clamp(2rem,4vw,3.2rem); color: #fff; margin-top: 14px; }
    .rc-inner p { color: var(--muted); margin-top: 14px; }

    @media (max-width: 900px) { .surface { grid-template-columns: 1fr; } .forge-strip { grid-template-columns: 1fr 1fr; } .forge-spec:nth-child(2) { border-right: none; } .forge-spec:nth-child(1), .forge-spec:nth-child(2) { border-bottom: 1px solid var(--line2); } .stt-row { grid-template-columns: 1fr auto; } .stt-stat, .stt-arw { display: none; } }
    @media (max-width: 540px) { .strata-row { grid-template-columns: 1fr; } }
  </style>

  <script>
    import { gsap, SplitText, ScrollTrigger } from '../../lib/motion/gsap-plus';
    import { STRATA } from '../../data/vulcan';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const byKey = Object.fromEntries(STRATA.map((s) => [s.key, s]));

    const heroTitle = document.getElementById('heroTitle');
    const fades = ['heroKicker', 'heroCopy', 'heroActions', 'heroPills'].map((id) => document.getElementById(id));
    if (heroTitle && !reduce) {
      const split = new SplitText(heroTitle, { type: 'chars', charsClass: 'ch' });
      const tl = gsap.timeline({ delay: 0.15, defaults: { ease: 'power4.out' } });
      if (fades[0]) tl.to(fades[0], { opacity: 1, y: 0, duration: 0.7 }, 0);
      tl.from(split.chars, { yPercent: 120, opacity: 0, stagger: 0.035, duration: 0.9 }, 0.1);
      tl.to(fades[1], { opacity: 1, duration: 0.8 }, 0.5).to(fades[2], { opacity: 1, duration: 0.8 }, 0.65).to(fades[3], { opacity: 1, duration: 0.6 }, 0.8);
    }
    ScrollTrigger.refresh();

    const nowName = document.getElementById('nowName')!, heatVal = document.getElementById('heatVal')!;
    const slider = document.getElementById('heatSlider') as HTMLInputElement;
    const setName = (k: string) => { nowName.textContent = byKey[k]?.name || k; };
    const savedSuite = localStorage.getItem('vulcan-suite') || 'thermal';
    const savedHeat = Number(localStorage.getItem('vulcan-heat') || byKey[savedSuite]?.heat || 84);
    setName(savedSuite);
    if (slider) slider.value = String(savedHeat);
    heatVal.textContent = savedHeat + '°';
    document.addEventListener('vulcan:suite', (e) => setName((e as CustomEvent).detail));
    document.addEventListener('vulcan:heat', (e) => { const v = (e as CustomEvent).detail; heatVal.textContent = v + '°'; if (slider && document.activeElement !== slider) slider.value = String(v); });
  </script>
</VulcanLayout>