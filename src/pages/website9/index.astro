---
/**
 * ORBITAL ARCHIVE , Home (website9, round 2 multi-page).
 * Spiral-galaxy WebGL hero, collections, field method, access teaser.
 */
import CosmosLayout from '../../layouts/CosmosLayout.astro';

const COLLECTIONS = [
  { tag: 'Briefings', coord: 'RA 02h', title: 'Deep Field Briefings', line: 'Long-range research notes distilled from primary sources. Calm synthesis, minimal opinion , built for decisions that age well.', c: 'c1' },
  { tag: 'Maps', coord: 'RA 11h', title: 'Solar Cartography', line: 'System maps: actors, incentives, constraints. A navigable surface for strategy, updated as new data locks in.', c: 'c2' },
  { tag: 'Alerts', coord: 'RA 19h', title: 'Anomaly Index', line: 'Early signals that matter. Each alert carries a chain of evidence, a confidence level, and what to watch next.', c: 'c3' },
];
const FIELD = [
  { k: 'Sources', v: 'Primary first. Secondary always labelled.' },
  { k: 'Filters', v: 'Noise removed before a word is written.' },
  { k: 'Structure', v: 'Map → notes → actions. Nothing loose.' },
];
const ACCESS = [
  { k: 'Entry', v: 'Application reviewed weekly' },
  { k: 'Sessions', v: '45 min, timeboxed' },
  { k: 'Output', v: 'Briefing + map packet' },
  { k: 'Channel', v: 'Private correspondence' },
];
---

<CosmosLayout title="Orbital Archive , Private Research Observatory" description="A private observatory for research: deep-field briefings, system maps, and an anomaly index , delivered with restraint and evidence.">
  <header class="hero" id="hero">
    <span class="overline c" id="heroEye">Private Observatory · Research · By Application</span>
    <h1 class="hero-title" id="heroTitle">A quiet place<br />to see <em>further.</em></h1>
    <p class="hero-tag" id="heroTag">Deep-field briefings, system cartography, and an anomaly index , synthesis with evidence, for people who make decisions that have to age well.</p>
    <div class="hero-actions" id="heroActions">
      <a href="/website9/access" class="btn-cta">Request access</a>
      <a href="/website9/field" class="btn-ghost">Open the field map</a>
    </div>
    <div class="hero-read" id="heroRead">
      <span class="coord">SIGNAL ◇ NOMINAL</span><span class="coord">RA 17h 42m</span><span class="coord">DEC −29° 00′</span><span class="coord">Z 0.0014</span>
    </div>
  </header>

  <section class="section" id="collections">
    <div class="sec-head">
      <div><span class="overline" data-reveal="fade">Collections</span><h2 data-reveal="up">Three ways to look.</h2></div>
      <p data-reveal="up">Briefings to read, maps to navigate, alerts to watch. <a class="inline-link" href="/website9/collections">Enter the archive →</a></p>
    </div>
    <div class="col-grid">
      {COLLECTIONS.map((c) => (
        <a href="/website9/collections" class={`col panel ticked ${c.c}`} data-reveal="up">
          <div class="col-top"><span class="col-tag">{c.tag}</span><span class="coord">{c.coord}</span></div>
          <h3>{c.title}</h3><p>{c.line}</p>
          <span class="col-arw">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section tight" id="field">
    <div class="field-band">
      <div class="fb-copy">
        <span class="overline v" data-reveal="fade">Method</span>
        <h2 data-reveal="up">How the field is kept.</h2>
        <p data-reveal="up">The archive is small on purpose. Less published, more checked. Every entry passes the same three gates before it reaches you.</p>
        <a href="/website9/field" class="inline-link" data-reveal="fade" style="margin-top:6px;">See the field map →</a>
      </div>
      <div class="fb-gates">
        {FIELD.map((f, i) => (
          <div class="gate" data-reveal="up"><span class="gate-n">{String(i + 1).padStart(2, '0')}</span><div><h4>{f.k}</h4><p>{f.v}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section access-cta" id="access">
    <div class="ac-inner panel lit ticked" data-reveal="up">
      <span class="overline p c">Access</span>
      <h2>Entry is by application.</h2>
      <p>Sessions are timeboxed and private. Tell us what you're trying to see and we'll tell you whether the archive can help.</p>
      <div class="ac-specs">
        {ACCESS.map((a) => (<div class="ac-spec"><span class="as-k">{a.k}</span><span class="as-v">{a.v}</span></div>))}
      </div>
      <a href="/website9/access" class="btn-cta" style="margin-top:34px;">Request access</a>
    </div>
  </section>

  <style>
    .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 0 20px; }
    .hero .overline { opacity: 0; transform: translateY(8px); }
    .hero-title { font-size: clamp(2.8rem, 8.5vw, 7.5rem); letter-spacing: -0.03em; line-height: 1.0; color: #fff; margin: 22px 0; }
    .hero-title em { font-style: normal; background: linear-gradient(100deg, var(--c1), var(--c2), var(--c3)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .hero-title .ch { display: inline-block; will-change: transform; }
    .hero-tag { font-size: clamp(0.95rem, 1.7vw, 1.2rem); color: var(--muted); max-width: 54ch; opacity: 0; line-height: 1.6; }
    .hero-actions { margin-top: 38px; display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; opacity: 0; }
    .hero-read { margin-top: 40px; display: flex; gap: clamp(14px,3vw,32px); flex-wrap: wrap; justify-content: center; opacity: 0; }
    .hero-read .coord { color: var(--faint); }

    .col-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    .col { position: relative; padding: 32px 28px 30px; overflow: hidden; transition: border-color 0.35s, transform 0.35s; min-height: 230px; }
    .col:hover { transform: translateY(-4px); }
    .col.c1:hover { border-color: var(--hair-c1); } .col.c2:hover { border-color: rgba(180,107,255,0.3); } .col.c3:hover { border-color: rgba(255,94,168,0.3); }
    .col-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
    .col-tag { font-family: var(--mono); font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; padding: 5px 10px; border-radius: 2px; }
    .col.c1 .col-tag { color: var(--c1); border: 1px solid var(--hair-c1); }
    .col.c2 .col-tag { color: var(--c2); border: 1px solid rgba(180,107,255,0.3); }
    .col.c3 .col-tag { color: var(--c3); border: 1px solid rgba(255,94,168,0.3); }
    .col h3 { font-size: 1.5rem; color: #fff; }
    .col p { color: var(--muted); margin-top: 12px; font-size: 0.9rem; line-height: 1.6; }
    .col-arw { position: absolute; bottom: 24px; right: 26px; color: var(--c1); opacity: 0; transition: opacity 0.3s, transform 0.3s; }
    .col:hover .col-arw { opacity: 1; transform: translateX(4px); }

    .field-band { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(28px,5vw,60px); align-items: center; }
    .fb-copy { min-width: 0; }
    .fb-copy h2 { font-size: clamp(1.9rem,3.6vw,3rem); color: #fff; margin: 12px 0 18px; }
    .fb-copy > p { color: var(--muted); line-height: 1.7; max-width: 46ch; }
    .fb-gates { display: flex; flex-direction: column; gap: 12px; }
    .gate { display: grid; grid-template-columns: 52px 1fr; gap: 18px; padding: 22px 24px; border: 1px solid var(--hair); border-radius: 6px; background: rgba(10,14,31,0.35); transition: border-color 0.3s; }
    .gate:hover { border-color: var(--hair-c1); }
    .gate-n { font-family: var(--mono); font-size: 12px; color: var(--c2); }
    .gate h4 { font-size: 1.15rem; color: #fff; }
    .gate p { color: var(--muted); font-size: 0.9rem; margin-top: 4px; }

    .access-cta { display: flex; justify-content: center; }
    .ac-inner { text-align: center; padding: clamp(40px,6vw,72px) clamp(24px,4vw,56px); max-width: 820px; width: 100%; }
    .ac-inner .overline { justify-content: center; }
    .ac-inner h2 { font-size: clamp(2rem,4.2vw,3.4rem); color: #fff; margin-top: 16px; }
    .ac-inner > p { color: var(--muted); margin-top: 16px; max-width: 52ch; margin-inline: auto; }
    .ac-specs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--hair); border: 1px solid var(--hair); margin-top: 34px; border-radius: 6px; overflow: hidden; }
    .ac-spec { background: rgba(7,9,24,0.6); padding: 20px 14px; display: flex; flex-direction: column; gap: 7px; }
    .as-k { font-family: var(--mono); font-size: 8px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--c3); }
    .as-v { font-size: 0.92rem; color: #fff; }

    @media (max-width: 900px) { .col-grid { grid-template-columns: 1fr; } .field-band { grid-template-columns: 1fr; } .ac-specs { grid-template-columns: 1fr 1fr; } }
    @media (prefers-reduced-motion: reduce) { .hero .overline, .hero-tag, .hero-actions, .hero-read { opacity: 1 !important; transform: none !important; } }
  </style>

  <script>
    import { gsap, ScrollTrigger, SplitText } from '../../lib/motion/gsap-plus';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const heroTitle = document.getElementById('heroTitle');
    const fades = ['heroEye', 'heroTag', 'heroActions', 'heroRead'].map((id) => document.getElementById(id));
    if (heroTitle && !reduce) {
      const split = new SplitText(heroTitle, { type: 'words,chars', charsClass: 'ch' });
      const tl = gsap.timeline({ delay: 0.15, defaults: { ease: 'power4.out' } });
      if (fades[0]) tl.to(fades[0], { opacity: 1, y: 0, duration: 0.7 }, 0);
      tl.from(split.chars, { yPercent: 130, opacity: 0, stagger: 0.04, duration: 1 }, 0.1);
      tl.to(fades[1], { opacity: 1, duration: 0.8 }, 0.6).to(fades[2], { opacity: 1, duration: 0.8 }, 0.8).to(fades[3], { opacity: 1, duration: 0.8 }, 1.0);
    } else {
      fades.forEach((el) => el && (el.style.opacity = '1'));
    }
    ScrollTrigger.refresh();
  </script>
</CosmosLayout>