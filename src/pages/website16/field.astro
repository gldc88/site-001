---
/**
 * FIELD STUDIO , The Field (website16, round 2). The interactive showpiece: the season dial retunes
 * the live field + theme, the flow trail (wind/water/light) overlays a transient mood.
 */
import FieldLayout from '../../layouts/FieldLayout.astro';
import { SEASONS, TRAIL } from '../../data/field';
---

<FieldLayout title="The Field | Field Studio" description="The living field , retune its season (dawn, canopy, dusk) and feel the air change. Wind, water, and light overlay the mood." active="field">
  <section class="intro">
    <span class="eyebrow">The Field · live</span>
    <h1>The air, <em>retuned</em>.</h1>
    <p>This whole site reads from one field. Change its season and the speed, turbulence, scale, and colour shift with it , across every page. Move through the flow trail to overlay a mood.</p>
  </section>

  <section class="sec tight">
    <div class="field-grid">
      <div class="fg-left">
        <span class="eyebrow">Season</span>
        <div class="big-dial" role="group" aria-label="Season">
          {SEASONS.map((s) => (
            <button class="bd-btn" data-season={s.key} aria-pressed="false">
              <span class="bd-label">{s.label}</span>
              <span class="bd-note">{s.note}</span>
            </button>
          ))}
        </div>
      </div>

      <aside class="fg-right card">
        <div class="rd-head"><span class="eyebrow">Readings</span><span class="rd-live"><span class="dot"></span>live</span></div>
        <div class="rd-rows">
          <div class="rd"><span>Season</span><b id="rdSeason">Canopy</b></div>
          <div class="rd"><span>Density</span><b id="rdDensity">2.6k</b></div>
          <div class="rd"><span>Drift</span><b id="rdDrift">0.42</b></div>
          <div class="rd"><span>Mood</span><b id="rdMood">Wind</b></div>
        </div>
        <p class="rd-note" id="rdSeasonNote">Green density · spore traffic · active air</p>
      </aside>
    </div>
  </section>

  <section class="sec tight">
    <div class="sec-top"><span class="eyebrow">Flow trail</span><a class="inline-link" href="/website16/method">Read the method →</a></div>
    <h2 class="sec-h">Hover the trail. Feel it move.</h2>
    <div class="trail-row" id="trailRow">
      {TRAIL.map((t) => (
        <button class="trail-card" data-flow={t.type}>
          <span class="tc-type">{t.title}</span>
          <p>{t.line}</p>
          <span class="tc-mark">→ overlay</span>
        </button>
      ))}
    </div>
  </section>

  <section class="section press" id="press">
    <div class="pr-head">
      <span class="kicker">Specimen Press</span>
      <h2>Press this moment.</h2>
      <p>The field never repeats itself. Catch the lines it is drawing <em>right now</em> ,
        season, mood and minute , and press them flat. The press holds four.</p>
      <button type="button" class="btn-cta pr-btn" id="prBtn">Press a specimen</button>
      <span class="pr-note" id="prNote" aria-live="polite"></span>
    </div>
    <div class="pr-cards" id="prCards"></div>
  </section>

  <style>
    /* ===== R3: "Specimen Press" ===== */
    .press .pr-head { max-width: 640px; margin-bottom: 24px; }
    .press h2 { font-size: clamp(1.9rem,3.4vw,2.7rem); margin: 10px 0 12px; }
    .press p { line-height: 1.75; }
    .press p em { font-style: italic; }
    .pr-btn { margin-top: 16px; }
    .pr-note { display: inline-block; margin-left: 14px; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; opacity: 0.75; }
    .pr-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 14px; }
    .pr-card { border: 1px solid rgba(60, 70, 55, 0.25); border-radius: 6px; background: rgba(250, 248, 242, 0.65); padding: 12px; display: flex; flex-direction: column; gap: 8px; }
    .pr-card svg { width: 100%; height: auto; display: block; background: rgba(255, 255, 255, 0.5); border-radius: 4px; }
    .pr-meta { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.7; display: flex; justify-content: space-between; gap: 8px; }
    .pr-release { align-self: flex-end; font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; background: none; border: none; opacity: 0.55; cursor: pointer; padding: 2px 4px; }
    .pr-release:hover { opacity: 1; }

    .field-grid { display: grid; grid-template-columns: 1.4fr 0.9fr; gap: clamp(24px,4vw,56px); align-items: start; }
    .fg-left .eyebrow { margin-bottom: 20px; }
    .big-dial { display: flex; flex-direction: column; gap: 10px; }
    .bd-btn { text-align: left; border: 1px solid var(--line); border-radius: 6px; padding: 22px 24px; transition: all 0.3s; background: color-mix(in srgb, var(--bg0) 50%, transparent); display: flex; flex-direction: column; gap: 6px; }
    .bd-btn:hover { border-color: var(--line-strong); }
    .bd-btn[aria-pressed='true'] { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); }
    .bd-label { font-family: var(--serif); font-size: 2rem; color: #fff; }
    .bd-note { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; color: var(--muted); }
    .bd-btn[aria-pressed='true'] .bd-note { color: var(--accent); }

    .fg-right { padding: 26px; position: sticky; top: 24px; }
    .rd-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .rd-live { font-family: var(--mono); font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); display: inline-flex; align-items: center; gap: 7px; }
    .rd-live .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px var(--accent); animation: pulse 1.6s ease-in-out infinite; }
    .rd-rows { margin-top: 10px; }
    .rd { display: flex; justify-content: space-between; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--line); }
    .rd:last-child { border-bottom: none; }
    .rd span { font-family: var(--mono); font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
    .rd b { font-family: var(--serif); font-size: 1.4rem; color: #fff; }
    .rd-note { font-family: var(--mono); font-size: 10px; letter-spacing: 0.06em; color: var(--accent); margin-top: 16px; transition: color 0.6s ease; }

    .sec-top { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
    .sec-h { font-size: clamp(2rem,4.4vw,3.4rem); color: #fff; margin: 14px 0 36px; }
    .trail-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .trail-card { text-align: left; border: 1px solid var(--line); border-radius: 6px; padding: 28px 26px; transition: all 0.3s; background: color-mix(in srgb, var(--bg0) 50%, transparent); position: relative; }
    .trail-card:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 6%, transparent); transform: translateY(-3px); }
    .tc-type { font-family: var(--serif); font-size: 1.9rem; color: #fff; }
    .trail-card p { color: var(--muted); margin-top: 10px; font-size: 0.9rem; line-height: 1.55; }
    .tc-mark { font-family: var(--mono); font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); display: block; margin-top: 16px; opacity: 0; transition: opacity 0.3s; }
    .trail-card:hover .tc-mark { opacity: 1; }

    @media (max-width: 900px) { .field-grid { grid-template-columns: 1fr; } .fg-right { position: static; } .trail-row { grid-template-columns: 1fr; } }
  </style>

  <script>
    import { SEASONS } from '../../data/field';
    const byKey = Object.fromEntries(SEASONS.map((s) => [s.key, s]));
    const rd = { season: document.getElementById('rdSeason')!, density: document.getElementById('rdDensity')!, drift: document.getElementById('rdDrift')!, mood: document.getElementById('rdMood')!, note: document.getElementById('rdSeasonNote')! };
    function render(k: string) { const s = byKey[k]; if (!s) return; rd.season.textContent = s.label; rd.density.textContent = s.density; rd.note.textContent = s.note; }
    render(localStorage.getItem('field-season') || 'canopy');
    document.addEventListener('field:season', (e) => render((e as CustomEvent).detail));
    document.addEventListener('field:flow', (e) => { const m = (e as CustomEvent).detail; rd.mood.textContent = m.charAt(0).toUpperCase() + m.slice(1); });
    const trailRow = document.getElementById('trailRow');
    trailRow?.addEventListener('mouseover', (e) => { const el = (e.target as HTMLElement).closest<HTMLElement>('[data-flow]'); if (el) rd.mood.textContent = (el.dataset.flow || '').replace(/^./, (c) => c.toUpperCase()); });

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let drift = 0.42;
    if (!reduce) setInterval(() => { drift += (Math.random() - 0.5) * 0.06; drift = Math.max(0.12, Math.min(0.92, drift)); rd.drift.textContent = drift.toFixed(2); }, 1100);
  </script>

  <script>

    /* R3 gedeelde specimen-renderer: seeded PRNG -> geperst lijnwerk (deterministisch). */
    function specimenSvg(seed: number, hue: string): string {
      let s = seed >>> 0;
      const rnd = () => { s = (s * 1664525 + 1013904223) >>> 0; return s / 4294967296; };
      let paths = '';
      const n = 3 + Math.floor(rnd() * 3);
      for (let i = 0; i < n; i++) {
        const x0 = 12 + rnd() * 30, y0 = 14 + rnd() * 60;
        let d = `M ${x0.toFixed(1)} ${y0.toFixed(1)}`;
        let x = x0, y = y0;
        const segs = 3 + Math.floor(rnd() * 3);
        for (let j = 0; j < segs; j++) {
          const cx = x + 10 + rnd() * 22, cy = y + (rnd() - 0.5) * 34;
          x = cx + 8 + rnd() * 18; y = cy + (rnd() - 0.5) * 26;
          d += ` Q ${cx.toFixed(1)} ${cy.toFixed(1)}, ${x.toFixed(1)} ${y.toFixed(1)}`;
        }
        const w = (0.7 + rnd() * 1.2).toFixed(2);
        const op = (0.45 + rnd() * 0.5).toFixed(2);
        paths += `<path d="${d}" fill="none" stroke="${hue}" stroke-width="${w}" opacity="${op}" stroke-linecap="round" />`;
      }
      return `<svg viewBox="0 0 120 88" xmlns="http://www.w3.org/2000/svg">${paths}</svg>`;
    }
    const SEASON_HUE: Record<string, string> = { dawn: '#c98a5a', canopy: '#5a8a5f', dusk: '#7a6a9a' };

    /* R3 "Specimen Press" , bevries een uniek moment uit het levende veld. */
    (() => {
      const KEY = 'field-specimens';
      const btn = document.getElementById('prBtn');
      const note = document.getElementById('prNote');
      const cards = document.getElementById('prCards');
      if (!btn || !cards) return;
      type Spec = { seed: number; season: string; flow: string; ts: number };
      const read = (): Spec[] => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } };
      const write = (v: Spec[]) => { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch { /* private mode */ } };

      const render = () => {
        const specs = read();
        cards.innerHTML = specs.map((sp, i) => {
          const d = new Date(sp.ts);
          const when = d.toLocaleString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
          return `<div class="pr-card">${specimenSvg(sp.seed, SEASON_HUE[sp.season] || '#5a8a5f')}
            <div class="pr-meta"><span>${sp.season} · ${sp.flow}</span><span>${when}</span></div>
            <button type="button" class="pr-release" data-i="${i}">Release</button></div>`;
        }).join('');
      };
      render();

      btn.addEventListener('click', () => {
        const specs = read();
        if (specs.length >= 4) { if (note) note.textContent = 'The press holds four. Release one first.'; return; }
        const season = localStorage.getItem('field-season') || 'canopy';
        const flowEl = document.querySelector('.trail-card[aria-pressed=true], .trail-card.active');
        const flow = (flowEl instanceof HTMLElement && flowEl.dataset.flow) || 'still air';
        const ts = Date.now();
        specs.push({ seed: (ts ^ season.length * 2654435761) >>> 0, season, flow, ts });
        write(specs);
        render();
        if (note) note.textContent = 'Pressed. This exact minute will never draw itself again.';
      });
      cards.addEventListener('click', (e) => {
        const rel = (e.target as HTMLElement).closest<HTMLElement>('.pr-release');
        if (!rel) return;
        const specs = read();
        specs.splice(Number(rel.dataset.i), 1);
        write(specs);
        render();
        if (note) note.textContent = 'Released back to the field.';
      });
    })();
  </script>
</FieldLayout>