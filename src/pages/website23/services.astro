---
/**
 * RIDGELINE ROOFING , Services (website23, round 2). The six service lines in full.
 */
import RidgelineLayout from '../../layouts/RidgelineLayout.astro';
import { SERVICES } from '../../data/ridgeline';
---

<RidgelineLayout title="Services | Ridgeline Roofing" description="Roof repair, full replacement, flashing and detail work, flat roofs, gutters and drainage, and storm damage." active="services">
  <section class="mx-auto max-w-7xl px-6 pt-16 pb-12">
    <span class="text-amber-600 font-bold uppercase tracking-widest text-xs block mb-3">What we handle</span>
    <h1 class="text-5xl lg:text-7xl font-black tracking-tighter leading-[0.92]">Roof repairs <br />& replacement.</h1>
    <p class="mt-6 max-w-lg text-base text-slate-600">Six service lines, one principle: fix the detail that caused the leak, not just the surface around it.</p>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-20">
    <div class="grid gap-6 md:grid-cols-2">
      {SERVICES.map((s, i) => (
        <div class="hover-lift reveal-on-scroll rounded-xl border border-stone-200 bg-white p-8">
          <div class="flex items-baseline justify-between mb-5"><div class="text-xl font-bold">{s.title}</div><span class="text-2xl font-black text-amber-200">{String(i + 1).padStart(2, '0')}</span></div>
          <ul class="space-y-3">{s.bullets.map((b) => <li class="flex items-start gap-3 text-sm text-slate-600"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span><span>{b}</span></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="mt-14 rounded-2xl bg-slate-900 text-white p-10 lg:p-14 flex flex-col lg:flex-row items-center justify-between gap-6">
      <div><h2 class="text-3xl lg:text-4xl font-black tracking-tight">Not sure what's failing?</h2><p class="mt-3 text-slate-300 max-w-md">Try the roof-section diagnostic on the home page, or book an inspection and we'll trace it for you.</p></div>
      <div class="flex gap-4 shrink-0">
        <a href="/website23" class="rounded-sm border border-white/30 px-7 py-4 text-xs font-black uppercase tracking-widest hover:bg-white hover:text-slate-900 transition-all">Diagnostic</a>
        <a href="/website23/contact" class="rounded-sm bg-amber-600 px-7 py-4 text-xs font-black uppercase tracking-widest hover:bg-amber-500 transition-colors">Request estimate</a>
      </div>
    </div>
  </section>
</RidgelineLayout>