---
/**
 * RIDGELINE ROOFING , Contact / estimate request (website23, round 2). Validated -> reference + toast.
 */
import RidgelineLayout from '../../layouts/RidgelineLayout.astro';
import { ROOF_TYPES, EMAIL, PHONE, TEL, SERVICE_AREA } from '../../data/ridgeline';

const ISSUES = ['Active leak', 'Storm / wind damage', 'Flashing / detail', 'Flat roof', 'Gutters & drainage', 'Full replacement', 'Inspection only'];
---

<RidgelineLayout title="Request an Estimate | Ridgeline Roofing" description="Book a roof inspection or request an estimate. Tell us the roof type and the symptom; we trace the cause.">
  <section class="mx-auto max-w-7xl px-6 pt-16 pb-24 grid lg:grid-cols-[1fr_1.1fr] gap-12 lg:gap-20 items-start">
    <div>
      <span class="text-amber-600 font-bold uppercase tracking-widest text-xs block mb-3">Request an estimate</span>
      <h1 class="text-5xl lg:text-7xl font-black tracking-tighter leading-[0.92]">Book an <br />inspection.</h1>
      <p class="mt-6 max-w-md text-base text-slate-600">Tell us the roof type and what you're seeing. We trace the leak to its cause, scope it in writing, and verify the fix.</p>
      <div class="mt-10 flex flex-col gap-4 text-sm">
        <a href={`mailto:${EMAIL}`} class="flex items-center gap-3 text-slate-700 hover:text-amber-600"><span class="text-[10px] font-mono uppercase tracking-widest text-slate-400 w-16">Email</span>{EMAIL}</a>
        <a href={`tel:${TEL}`} class="flex items-center gap-3 text-slate-700 hover:text-amber-600"><span class="text-[10px] font-mono uppercase tracking-widest text-slate-400 w-16">Phone</span>{PHONE}</a>
        <div class="flex items-center gap-3 text-slate-700"><span class="text-[10px] font-mono uppercase tracking-widest text-slate-400 w-16">Area</span>{SERVICE_AREA}</div>
      </div>
    </div>

    <form id="roofForm" class="rounded-2xl border border-stone-200 bg-white p-8 lg:p-10 shadow-[0_24px_60px_-30px_rgba(0,0,0,0.4)]" novalidate>
      <div class="grid sm:grid-cols-2 gap-5">
        <label class="flex flex-col gap-2"><span class="text-[10px] font-mono uppercase tracking-widest text-slate-500">Name</span>
          <input name="name" type="text" class="rounded-lg border border-stone-300 px-4 py-3 text-sm outline-none focus:border-amber-500" /><span data-err-for="name" class="text-[11px] text-amber-600"></span></label>
        <label class="flex flex-col gap-2"><span class="text-[10px] font-mono uppercase tracking-widest text-slate-500">Email</span>
          <input name="email" type="email" class="rounded-lg border border-stone-300 px-4 py-3 text-sm outline-none focus:border-amber-500" /><span data-err-for="email" class="text-[11px] text-amber-600"></span></label>
      </div>
      <div class="grid sm:grid-cols-2 gap-5 mt-5">
        <label class="flex flex-col gap-2"><span class="text-[10px] font-mono uppercase tracking-widest text-slate-500">Roof type</span>
          <select name="rooftype" class="rounded-lg border border-stone-300 px-4 py-3 text-sm bg-white outline-none focus:border-amber-500">{ROOF_TYPES.map((r) => <option>{r.name}</option>)}</select></label>
        <label class="flex flex-col gap-2"><span class="text-[10px] font-mono uppercase tracking-widest text-slate-500">Issue</span>
          <select name="issue" class="rounded-lg border border-stone-300 px-4 py-3 text-sm bg-white outline-none focus:border-amber-500">{ISSUES.map((i) => <option>{i}</option>)}</select></label>
      </div>
      <label class="flex flex-col gap-2 mt-5"><span class="text-[10px] font-mono uppercase tracking-widest text-slate-500">What are you seeing? (optional)</span>
        <textarea name="note" rows="4" class="rounded-lg border border-stone-300 px-4 py-3 text-sm outline-none focus:border-amber-500 resize-y" placeholder="Where the water shows, when it started, what's above it…"></textarea></label>
      <button type="submit" class="w-full mt-7 rounded-sm bg-slate-900 hover:bg-amber-600 text-white py-4 text-xs font-black uppercase tracking-widest transition-colors">Send request</button>
      <p id="rStatus" class="mt-4 text-[11px] font-mono uppercase tracking-widest text-slate-400 text-center">Written scope, no obligation · {SERVICE_AREA}</p>
      <p class="yw-ref" id="ywRef" hidden></p>
      </form>
  </section>

  <script>
    /* R3 Roof Year: het daktype reist mee. */
    try {
      const roof = localStorage.getItem('ridgeline-roof');
      if (roof) {
        const el = document.getElementById('ywRef');
        if (el) { el.textContent = `Your ${roof} roof is on our year wheel , we will time the visit to its season.`; el.hidden = false; }
      }
    } catch { /* private mode */ }

    const form = document.getElementById('roofForm') as HTMLFormElement;
    const status = document.getElementById('rStatus')!;
    const setErr = (n: string, m: string) => { const el = form.querySelector<HTMLElement>(`[data-err-for="${n}"]`); const i = form.querySelector<HTMLElement>(`[name="${n}"]`); if (el) el.textContent = m; if (i) (i as HTMLElement).style.borderColor = m ? '#d97706' : ''; };
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const name = String(d.get('name') || '').trim();
      const email = String(d.get('email') || '').trim();
      let ok = true;
      if (name.length < 2) { setErr('name', 'Your name, please.'); ok = false; } else setErr('name', '');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setErr('email', 'A valid email.'); ok = false; } else setErr('email', '');
      if (!ok) return;
      const ref = 'RL-' + Math.random().toString(36).slice(2, 6).toUpperCase();
      status.textContent = `Request ${ref} logged , we'll be in touch shortly.`;
      (window as any).showToast?.(`Thanks, <b>${name.split(' ')[0]}</b>. Request <b>${ref}</b> received , ${String(d.get('issue'))} on ${String(d.get('rooftype'))}. We'll confirm an inspection slot.`);
      form.reset();
    });
  </script>
<style>
  .yw-ref { font-family: ui-monospace, monospace; font-size: 11px; color: #7a4a12; border-top: 1px solid rgba(120, 100, 70, 0.25); padding-top: 12px; }
</style>
</RidgelineLayout>