---
/**
 * OBSIDIAN MOTORS , The House (website30, round 2). Philosophy + the practical Q&A.
 */
import ObsidianMotorsLayout from '../../layouts/ObsidianMotorsLayout.astro';
import { PRODUCTS, carSvg } from '../../data/obsidian-motors';
import { ANSWERS, TAGLINE } from '../../data/obsidian-motors';

// R3 "The Reveal": de auto van de week (ISO-weeknummer bepaalt welke , elke week een andere).
const now = new Date();
const jan1 = new Date(now.getFullYear(), 0, 1);
const week = Math.ceil(((now.getTime() - jan1.getTime()) / 86400000 + jan1.getDay() + 1) / 7);
const weekCar = PRODUCTS[week % PRODUCTS.length];
const weekCarSvg = carSvg(weekCar.shape, weekCar.paint, 'reveal');
---

<ObsidianMotorsLayout title="The House | Obsidian Motors" description="How Obsidian works: a curated floor, honest documentation, and unhurried acquisition. Plus financing, trade-in, and warranty answers." active="house">
  <section class="mx-auto max-w-[1320px] px-6 pt-14 pb-12">
    <span class="text-[11px] font-semibold uppercase tracking-[0.3em] accent">The House</span>
    <h1 class="text-5xl md:text-7xl font-black tracking-tighter leading-[0.92] mt-4">{TAGLINE}</h1>
    <p class="mt-7 max-w-2xl text-[var(--mut)] text-lg leading-relaxed">Most showrooms optimise for the sale today. We optimise for the car being right , because the next car, and the referral, matter more than this month's number.</p>
  </section>

  <section class="mx-auto max-w-[1320px] px-6 pb-14 grid md:grid-cols-3 gap-6">
    {[['No pressure desk', 'You will never be rushed across a finish line. We would rather you walk away clear than sign unsure.'], ['Honest condition', 'Every car carries its real story , service history, wear, and what was put right. No surprises after handover.'], ['Right, not most', 'We will talk you out of the wrong car. The brief comes first; the inventory serves it, not the reverse.']].map(([t, d]) => (
      <div class="reveal-on-scroll rounded-2xl border border-[var(--line)] bg-white/[0.02] p-7">
        <h2 class="text-xl font-bold tracking-tight">{t}</h2>
        <p class="mt-3 text-sm text-[var(--mut)] leading-relaxed">{d}</p>
      </div>
    ))}
  </section>

  <section class="mx-auto max-w-[1320px] px-6 pb-20 border-t border-[var(--line)] pt-12">
    <h2 class="text-3xl md:text-4xl font-black tracking-tight mb-8">Straight answers.</h2>
    <div class="flex flex-col gap-3 max-w-3xl">
      {ANSWERS.map((a, i) => (
        <details class="reveal-on-scroll group rounded-xl border border-[var(--line)] bg-white/[0.02] p-6" open={i === 0}>
          <summary class="cursor-pointer list-none flex items-center justify-between"><b class="text-lg">{a.title}</b><span class="text-xl accent group-open:rotate-45 transition-transform">+</span></summary>
          <p class="mt-3 pt-3 border-t border-[var(--line)] text-[var(--mut)] leading-relaxed">{a.body}</p>
        </details>
      ))}
    </div>
    <div class="mt-12 flex flex-wrap gap-4"><a href="/website30/showroom" class="bg-[var(--accent)] text-white px-8 py-4 text-[11px] font-bold uppercase tracking-[0.2em] rounded hover:bg-[#3d63d8] transition-colors">Browse the floor</a><a href="/website30/acquisition" class="border border-[var(--line)] px-8 py-4 text-[11px] font-bold uppercase tracking-[0.2em] rounded hover:border-[var(--accent)] transition-all">How acquisition works</a></div>
  </section>

  <section class="px-8 py-20" id="reveal">
    <div class="max-w-[1200px] mx-auto">
      <span class="text-[10px] uppercase tracking-[0.25em] text-sky-400 font-mono">This week under the cover</span>
      <h2 class="text-3xl md:text-5xl font-semibold text-white mt-3">One car. One cloth. Pull.</h2>
      <p class="text-slate-400 mt-4 max-w-xl">Every week we put a different car under the cover.
        Drag the cloth aside , the reveal is half the pleasure of the house.</p>

      <div class="mt-10 relative rounded-2xl border border-white/10 bg-white/[0.03] overflow-hidden select-none" id="revealStage" tabindex="0" role="button" aria-label="Pull the cover off this week's car , drag sideways, or hold Enter">
        <div class="rv-car" set:html={weekCarSvg} />
        <div class="rv-spot" aria-hidden="true"></div>
        <div class="rv-cloth" id="rvCloth" aria-hidden="true">
          <svg viewBox="0 0 600 260" preserveAspectRatio="none" class="w-full h-full">
            <path d="M0 30 Q80 6 160 22 T320 18 T480 26 T600 20 L600 260 L0 260 Z" fill="rgba(24, 28, 38, 0.98)" />
            <path d="M40 60 q60 90 10 190 M140 48 q40 100 -6 210 M260 44 q50 110 16 214 M390 48 q30 100 -12 210 M500 52 q46 96 8 206" stroke="rgba(70, 80, 100, 0.5)" fill="none" stroke-width="2" />
          </svg>
          <span class="rv-hint">DRAG →</span>
        </div>
        <div class="rv-card" id="rvCard" hidden>
          <b>{weekCar.name}</b>
          <span class="rv-meta">{weekCar.body} · {weekCar.power} · €{weekCar.price.toLocaleString('de-DE')}</span>
          <p>{weekCar.note}</p>
          <a href="/website30/reserve" class="rv-link">Arrange this week's viewing →</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    #revealStage { aspect-ratio: 600 / 260; max-height: 420px; }
    #revealStage:focus-visible { outline: 2px solid #38bdf8; outline-offset: 4px; }
    .rv-car { position: absolute; inset: 6% 4%; }
    .rv-car :global(svg) { width: 100%; height: 100%; }
    .rv-spot { position: absolute; inset: 0; background: radial-gradient(60% 80% at 50% 20%, rgba(56, 189, 248, 0.12), transparent 65%); opacity: 0; transition: opacity 1.2s ease; pointer-events: none; }
    .rv-cloth { position: absolute; inset: -2% -1%; cursor: grab; transition: transform 0.25s ease-out, opacity 0.5s ease; will-change: transform; }
    .rv-cloth:active { cursor: grabbing; }
    .rv-cloth.gone { transform: translateX(112%) rotate(4deg) !important; opacity: 0; pointer-events: none; }
    .rv-hint { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); font-family: ui-monospace, monospace; font-size: 12px; letter-spacing: 0.3em; color: rgba(148, 180, 210, 0.7); }
    @media (prefers-reduced-motion: reduce) { .rv-cloth { transition: opacity 0.2s ease; } .rv-cloth.gone { transform: none !important; } .rv-spot { transition: none; } }
    #revealStage.revealed .rv-spot { opacity: 1; }
    .rv-card { position: absolute; right: 16px; bottom: 16px; max-width: 300px; background: rgba(8, 12, 20, 0.92); border: 1px solid rgba(56, 189, 248, 0.35); border-radius: 8px; padding: 14px 16px; backdrop-filter: blur(8px); }
    .rv-card b { color: #e2f3ff; font-size: 15px; display: block; }
    .rv-meta { font-family: ui-monospace, monospace; font-size: 10px; letter-spacing: 0.1em; color: #7dd3fc; display: block; margin-top: 4px; }
    .rv-card p { font-size: 12px; line-height: 1.55; color: rgba(200, 220, 240, 0.8); margin: 8px 0; }
    .rv-link { font-family: ui-monospace, monospace; font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: #38bdf8; text-decoration: none; }
  </style>

  <script>
    /* R3 "The Reveal" , trek het doek eraf; één theatraal gebaar. */
    (() => {
      const stage = document.getElementById('revealStage');
      const cloth = document.getElementById('rvCloth');
      const card = document.getElementById('rvCard');
      if (!stage || !cloth || !card) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let dragging = false, startX = 0, dx = 0;
      let holdT = 0;

      const revealed = () => {
        cloth.classList.add('gone');
        stage.classList.add('revealed');
        card.hidden = false;
        stage.setAttribute('aria-label', 'This week\'s car is revealed');
        try { localStorage.setItem('obsidian-reveal', new Date().toDateString()); } catch { /* private mode */ }
      };
      cloth.addEventListener('pointerdown', (e) => {
        dragging = true; startX = e.clientX; dx = 0;
      });
      window.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        dx = Math.max(0, e.clientX - startX);
        if (!reduce) cloth.style.transform = `translateX(${dx}px) rotate(${Math.min(3, dx / 90)}deg)`;
        if (dx > stage.clientWidth * 0.45) { dragging = false; revealed(); }
      }, { passive: true });
      window.addEventListener('pointerup', () => {
        if (!dragging) return;
        dragging = false;
        if (!cloth.classList.contains('gone')) cloth.style.transform = '';
      }, { passive: true });
      // toetsenbord: houd Enter ~1s vast
      stage.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' || cloth.classList.contains('gone')) return;
        if (!holdT) holdT = window.setTimeout(revealed, reduce ? 150 : 900);
      });
      stage.addEventListener('keyup', () => { clearTimeout(holdT); holdT = 0; });
    })();
  </script>
</ObsidianMotorsLayout>