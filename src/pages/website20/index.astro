---
/**
 * NORTHRIDGE , Home (website20, round 2 multi-page). Tailwind + islands.
 * Hero with the live RenovationCalculator (Vue island), a detailing band, section teasers, contact CTA.
 */
import NorthridgeLayout from '../../layouts/NorthridgeLayout.astro';
import RenovationCalculator from '../../components/RenovationCalculator.vue';

const TEASERS = [
  { key: 'materials', label: 'Materials library', href: '/website20/materials', line: 'Curated stone, wood, metal, and plaster , the palette we build from.' },
  { key: 'process', label: 'How we work', href: '/website20/process', line: 'Survey to handover, four clean stages with daily updates.' },
  { key: 'projects', label: 'Recent work', href: '/website20/projects', line: 'Canal houses, apartments, and villas across the city.' },
];
---

<NorthridgeLayout title="Northridge , Architectural Renovations" description="High-end architectural renovations for homes and apartments. Planned clean, built tight, finished like it matters. Live scope estimate and site-visit booking.">
  <section class="relative min-h-screen flex items-center pt-32 pb-20 px-8 overflow-x-clip">
    <div class="max-w-[1400px] mx-auto w-full grid lg:grid-cols-[1.3fr_1fr] gap-24 items-center">
      <div class="relative">
        <div class="inline-flex items-center gap-4 px-5 py-2 rounded-full border-[0.5px] border-white/[0.1] bg-white/[0.01] backdrop-blur-md text-[10px] uppercase tracking-[0.2em] font-semibold text-neutral-400 mb-12">
          <span class="relative flex h-2 w-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span></span>
          Booking window: open
        </div>
        <h1 class="text-7xl lg:text-[9rem] font-bold tracking-tighter leading-[0.9] mb-10 text-transparent bg-clip-text bg-gradient-to-br from-white via-white to-neutral-600">Renovate <br />without chaos.</h1>
        <p class="text-xl text-neutral-400 leading-relaxed max-w-lg mb-16 font-light border-l-2 border-white/20 pl-6">High-end renovations for homes and apartments , planned clean, built tight, finished like it matters.</p>
        <div class="flex items-center gap-8">
          <a href="/website20/projects" class="group relative inline-flex items-center gap-4 text-sm font-bold uppercase tracking-widest text-white overflow-hidden">
            <span class="relative z-10">See recent projects</span>
            <div class="w-12 h-[1px] bg-white group-hover:w-24 transition-all duration-500"></div>
          </a>
        </div>
      </div>
      <div class="relative group perspective-[1000px]" data-reveal="up">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[140%] h-[140%] bg-gradient-radial from-white/5 to-transparent blur-3xl -z-10 pointer-events-none"></div>
        <div class="relative bg-[#080808]/70 backdrop-blur-xl border-[0.5px] border-white/[0.1] rounded-[2.5rem] p-3 shadow-[0_40px_100px_-30px_rgba(0,0,0,1)]">
          <div class="absolute inset-0 rounded-[2.5rem] bg-gradient-to-br from-white/10 via-transparent to-black/50 opacity-50 pointer-events-none"></div>
          <RenovationCalculator client:visible />
        </div>
      </div>
    </div>
  </section>

  <section class="px-8 py-24 border-y border-white/[0.05]">
    <div class="max-w-[1400px] mx-auto grid lg:grid-cols-2 gap-12 items-center">
      <div class="aspect-[4/3] relative rounded-3xl overflow-hidden border-[0.5px] border-white/[0.1] bg-gradient-to-br from-[#0c0e10] to-[#050607]" data-reveal="up">
        <div class="absolute inset-0 opacity-90" style="background: linear-gradient(100deg, #1a1c1e 0 38%, #0a0b0c 38% 40%, #14161a 40% 70%, #0a0b0c 70% 72%, #1a1c1e 72%);"></div>
        <div class="absolute inset-0" style="background: radial-gradient(700px 360px at 24% 22%, rgba(255,255,255,0.06), transparent 60%);"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 to-transparent"></div>
        <div class="absolute bottom-8 left-8">
          <span class="block text-xs uppercase tracking-widest text-neutral-400 mb-2">Detailing note 001</span>
          <h3 class="text-2xl text-white font-medium">Shadow gaps, done right.</h3>
        </div>
      </div>
      <div class="lg:pl-12" data-reveal="up">
        <h2 class="text-4xl font-light text-white mb-6">Details are the difference.</h2>
        <p class="text-neutral-400 leading-relaxed max-w-md">We sweat the corners, the lines, the transitions. Clean junctions between stone and wood, perfect reveals, no filler trim hiding lazy work. It reads quiet because it was built right.</p>
        <a href="/website20/materials" class="inline-flex items-center gap-3 mt-8 text-sm font-bold uppercase tracking-widest text-white group">Explore materials <div class="w-10 h-[1px] bg-white group-hover:w-20 transition-all duration-500"></div></a>
      </div>
    </div>
  </section>

  <section class="px-8 py-32">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-5xl font-extralight text-white tracking-tight mb-16" data-reveal="up">The studio.</h2>
      <div class="grid md:grid-cols-3 gap-4">
        {TEASERS.map((t) => (
          <a href={t.href} class="group relative p-10 rounded-3xl border-[0.5px] border-white/[0.08] bg-white/[0.01] hover:bg-white/[0.04] hover:border-white/20 transition-all duration-500 min-h-[220px] flex flex-col justify-between" data-reveal="up">
            <span class="text-[10px] uppercase tracking-[0.2em] text-emerald-400 font-mono">{t.key}</span>
            <div>
              <h3 class="text-3xl font-light text-white mb-3">{t.label}</h3>
              <p class="text-sm text-neutral-400 leading-relaxed">{t.line}</p>
            </div>
            <span class="absolute top-8 right-8 text-white/20 group-hover:text-white group-hover:translate-x-1 transition-all">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="px-8 pb-40">
    <div class="max-w-[1400px] mx-auto relative bg-[#080808]/85 backdrop-blur-md border-[0.5px] border-white/[0.08] rounded-[3rem] p-12 md:p-20 overflow-hidden text-center" data-reveal="up">
      <div class="absolute top-[-20%] right-[-10%] w-[700px] h-[700px] bg-gradient-to-bl from-emerald-500/[0.06] to-transparent rounded-full blur-[150px] pointer-events-none"></div>
      <div class="relative z-10">
        <div class="inline-block px-4 py-1.5 rounded-full border border-white/10 bg-white/5 text-[10px] font-mono text-emerald-400 mb-8 uppercase tracking-widest">Bookings: open</div>
        <h2 class="text-5xl md:text-6xl font-bold text-white tracking-tighter mb-6 leading-none">Renovate it properly.</h2>
        <p class="text-neutral-400 text-lg max-w-xl mx-auto mb-10 font-light">Get a scope estimate in minutes, then book a site visit. We confirm timing and budget within one business day.</p>
        <a href="/website20/contact" class="inline-flex items-center gap-3 pl-7 pr-2 py-2 bg-white text-black text-sm font-bold uppercase tracking-wide rounded-full hover:bg-neutral-200 transition-all duration-300 group">
          <span>Book a site visit</span>
          <div class="w-9 h-9 rounded-full bg-black flex items-center justify-center text-white group-hover:rotate-45 transition-transform duration-500">→</div>
        </a>
      </div>
    </div>
  </section>
</NorthridgeLayout>