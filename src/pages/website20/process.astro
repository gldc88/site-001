---
/**
 * NORTHRIDGE , Process (website20, round 2). The four stages, survey to handover.
 */
import NorthridgeLayout from '../../layouts/NorthridgeLayout.astro';

const PROCESS = [
  { step: 'Survey & measure.', line: 'Laser measures, moisture checks, and a clear plan from day one , before a single quote line is written.' },
  { step: 'Scope & quote.', line: 'Line-by-line scope and transparent pricing. You see exactly what you are paying for, with no vague surprises later.' },
  { step: 'Build & finish.', line: 'Dust control, tight scheduling, and daily updates with photos. The site stays clean and you stay informed.' },
  { step: 'Handover & aftercare.', line: 'A final punch list walked together, a care guide for every finish, and a team you can still reach after delivery.' },
];
const PROMISES = [
  { k: 'Fixed scope', v: 'Priced line by line, agreed before we start.' },
  { k: 'Daily updates', v: 'Photos and progress, every working day.' },
  { k: 'Clean site', v: 'Dust control and a tidy hand-back, always.' },
  { k: 'Reachable after', v: 'A care guide and a team that answers.' },
];
---

<NorthridgeLayout title="Process | Northridge" description="How Northridge works , survey, scope, build, handover. Fixed scope, daily updates, clean sites, real aftercare." active="process">
  <section class="px-8 pt-40 pb-16">
    <div class="max-w-[1400px] mx-auto">
      <span class="text-[10px] uppercase tracking-[0.2em] text-emerald-400 font-mono">Process</span>
      <h1 class="text-6xl lg:text-8xl font-bold tracking-tighter leading-[0.95] mt-6 text-transparent bg-clip-text bg-gradient-to-br from-white via-white to-neutral-600">No chaos, by design.</h1>
      <p class="text-lg text-neutral-400 leading-relaxed max-w-xl mt-8 font-light border-l-2 border-white/20 pl-6">Renovation goes wrong when it's improvised. Four clean stages stand between your first call and a finished room , and you always know which one you're in.</p>
    </div>
  </section>

  <section class="px-8 py-24 bg-[#050505]/80 backdrop-blur-sm border-y border-white/[0.05]">
    <div class="max-w-[1400px] mx-auto">
      <div class="grid md:grid-cols-4 gap-12" data-stagger="0.1">
        {PROCESS.map((p, idx) => (
          <div class="relative group">
            <div class="text-[8rem] font-bold text-white/[0.03] absolute -top-20 -left-4 select-none group-hover:text-white/[0.06] transition-colors duration-500">0{idx + 1}</div>
            <div class="relative pt-12 border-t-[0.5px] border-white/[0.1] group-hover:border-white/30 transition-colors duration-500">
              <span class="absolute top-[-3px] left-0 w-1.5 h-1.5 bg-emerald-400 rounded-full shadow-[0_0_15px_#34d399] group-hover:scale-150 transition-transform"></span>
              <h3 class="text-2xl text-white font-medium mb-4">{p.step}</h3>
              <p class="text-sm text-neutral-400 leading-relaxed max-w-xs">{p.line}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="px-8 py-32">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-4xl font-light text-white mb-16" data-reveal="up">What you can count on.</h2>
      <div class="grid md:grid-cols-4 gap-4">
        {PROMISES.map((p) => (
          <div class="p-8 rounded-3xl border-[0.5px] border-white/[0.08] bg-white/[0.01] hover:border-white/20 transition-colors" data-reveal="up">
            <h3 class="text-lg text-white font-medium mb-3">{p.k}</h3>
            <p class="text-sm text-neutral-400 leading-relaxed">{p.v}</p>
          </div>
        ))}
      </div>
      <div class="mt-16 flex" data-reveal="up">
        <a href="/website20/contact" class="inline-flex items-center gap-3 text-sm font-bold uppercase tracking-widest text-white group">Book a survey <div class="w-12 h-[1px] bg-white group-hover:w-24 transition-all duration-500"></div></a>
      </div>
    </div>
  </section>
  <section class="px-8 py-16" id="timeline">
    <div class="max-w-[1400px] mx-auto">
      <span class="text-[10px] uppercase tracking-[0.2em] text-emerald-400 font-mono">The Build, Scrubbed</span>
      <h2 class="text-3xl md:text-5xl font-semibold text-white mt-3">Drag through your renovation.</h2>
      <p class="text-slate-400 mt-4 max-w-xl">Five phases, one room. Scrub the timeline and watch the
        work land layer by layer , with the weeks and the budget running along.</p>

      <div class="mt-10 grid lg:grid-cols-[1.2fr_0.8fr] gap-10 items-center">
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
          <svg viewBox="0 0 420 260" class="w-full h-auto" aria-hidden="true" id="scrubSvg">
            <rect x="20" y="20" width="380" height="220" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="2" />
            <line x1="20" y1="200" x2="400" y2="200" stroke="rgba(255,255,255,0.25)" stroke-width="2" />
            <g data-layer="0"><path d="M40 200 l18 -12 l14 12 Z M80 200 l12 -8 l10 8 Z M340 200 l16 -10 l13 10 Z" fill="rgba(148,163,184,0.35)" /><line x1="60" y1="60" x2="120" y2="110" stroke="rgba(148,163,184,0.5)" stroke-width="2" stroke-dasharray="6 5" /></g>
            <g data-layer="1"><line x1="140" y1="200" x2="140" y2="70" stroke="rgba(226,232,240,0.6)" stroke-width="4" /><line x1="220" y1="200" x2="220" y2="70" stroke="rgba(226,232,240,0.6)" stroke-width="4" /><line x1="300" y1="200" x2="300" y2="70" stroke="rgba(226,232,240,0.6)" stroke-width="4" /><line x1="122" y1="70" x2="318" y2="70" stroke="rgba(226,232,240,0.6)" stroke-width="4" /></g>
            <g data-layer="2"><path d="M30 190 h360" stroke="rgba(52,211,153,0.7)" stroke-width="2" stroke-dasharray="4 6" /><path d="M140 90 v-14 h80" stroke="rgba(96,165,250,0.7)" stroke-width="2" fill="none" /><circle cx="160" cy="120" r="5" fill="rgba(96,165,250,0.8)" /><circle cx="280" cy="120" r="5" fill="rgba(96,165,250,0.8)" /></g>
            <g data-layer="3"><rect x="22" y="196" width="376" height="6" fill="rgba(180,140,90,0.75)" /><rect x="22" y="22" width="376" height="10" fill="rgba(226,232,240,0.25)" /></g>
            <g data-layer="4"><rect x="60" y="160" width="90" height="40" rx="4" fill="rgba(52,211,153,0.5)" /><rect x="250" y="145" width="60" height="55" rx="3" fill="rgba(148,163,184,0.5)" /><circle cx="210" cy="52" r="9" fill="rgba(253,224,71,0.85)" /><path d="M350 200 q6 -26 -4 -40 q16 8 12 40 Z" fill="rgba(52,211,153,0.7)" /></g>
          </svg>
        </div>
        <div>
          <div class="flex items-baseline justify-between gap-6">
            <span class="text-white text-xl font-semibold" id="scrubPhase">Demolition</span>
            <span class="font-mono text-emerald-400 text-sm" id="scrubMeta">wk 0–2 · €4.5k</span>
          </div>
          <input type="range" id="scrubRange" min="0" max="100" value="0" step="1"
            class="w-full mt-6 accent-emerald-400" aria-label="Renovation timeline"
            aria-valuetext="Demolition" />
          <div class="flex justify-between mt-3 font-mono text-[9px] uppercase tracking-widest text-slate-500">
            <span>Demo</span><span>Shell</span><span>Systems</span><span>Finish</span><span>Handover</span>
          </div>
          <p class="text-slate-400 text-sm mt-6 leading-relaxed" id="scrubNote">Strip it back to honest bones. Everything that leaves now never haunts the budget later.</p>
        </div>
      </div>
    </div>
  </section>

  <style>
    #scrubSvg g[data-layer] { opacity: 0; transition: opacity 0.5s ease; }
    #scrubSvg g[data-layer].on { opacity: 1; }
    @media (prefers-reduced-motion: reduce) { #scrubSvg g[data-layer] { transition: none; } }
  </style>

  <script>
    /* R3 "The Build, Scrubbed" , scrub door vijf renovatiefasen. */
    (() => {
      const PHASES = [
        { name: 'Demolition', meta: 'wk 0–2 · €4.5k', note: 'Strip it back to honest bones. Everything that leaves now never haunts the budget later.' },
        { name: 'Shell & structure', meta: 'wk 2–5 · €18k', note: 'New walls, straightened lines. The room finds its final shape here.' },
        { name: 'Systems', meta: 'wk 5–7 · €29k', note: 'Heating, water, power , the quiet nervous system behind the plaster.' },
        { name: 'Finish', meta: 'wk 7–10 · €41k', note: 'Floors down, walls skimmed and painted. Suddenly it smells like a home.' },
        { name: 'Handover', meta: 'wk 10–12 · €52k', note: 'Furnished, lit, planted. You get the keys; we get out of your way.' },
      ];
      const range = document.getElementById('scrubRange');
      const layers = Array.from(document.querySelectorAll('#scrubSvg g[data-layer]'));
      const phaseEl = document.getElementById('scrubPhase');
      const metaEl = document.getElementById('scrubMeta');
      const noteEl = document.getElementById('scrubNote');
      if (!(range instanceof HTMLInputElement) || !layers.length) return;
      const KEY = 'northridge-phase-max';
      const sync = () => {
        const v = Number(range.value);
        const phase = Math.min(4, Math.floor(v / 20));
        layers.forEach((g) => g.classList.toggle('on', Number(g.getAttribute('data-layer')) <= phase));
        const ph = PHASES[phase];
        if (phaseEl) phaseEl.textContent = ph.name;
        if (metaEl) metaEl.textContent = ph.meta;
        if (noteEl) noteEl.textContent = ph.note;
        range.setAttribute('aria-valuetext', ph.name);
        try {
          const max = Number(localStorage.getItem(KEY) || '-1');
          if (phase > max) localStorage.setItem(KEY, String(phase));
        } catch { /* private mode */ }
      };
      range.addEventListener('input', sync);
      sync();
    })();
  </script>
</NorthridgeLayout>