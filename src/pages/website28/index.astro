---
/**
 * CIVIL HOUSE MAKELAARS , Home (website28, round 2). Hero + the "system, not listings" thesis + tool and
 * approach teasers.
 */
import CivilHouseLayout from '../../layouts/CivilHouseLayout.astro';
import { TAGLINE, AREA, PHONE, TEL, REPRESENTATION } from '../../data/civilhouse';
---

<CivilHouseLayout title="Civil House Makelaars , Real Estate, Run Like a Desk" description="A Dutch real estate office built like an execution desk: evidence-led pricing, careful presentation, disciplined negotiation, and a clean handover.">
  <section class="mx-auto max-w-[1480px] px-6 pt-16 pb-14">
    <div class="grid lg:grid-cols-[1.1fr_1fr] gap-12 items-center border-b border-[var(--line)] pb-14">
      <div>
        <span class="text-[11px] font-semibold uppercase tracking-[0.3em] brass-text">Makelaars · {AREA}</span>
        <h1 class="text-5xl md:text-7xl font-black tracking-tighter leading-[0.92] mt-5">Most sites show <span class="text-[var(--mut)]">listings.</span><br />Ours shows the <span class="brass-text">system.</span></h1>
        <p class="mt-7 max-w-md text-[var(--mut)] text-lg leading-relaxed">{TAGLINE} Evidence-led pricing, careful presentation, disciplined negotiation, and a clean handover , the machinery that prevents friction.</p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href="/website28/dossier" class="bg-[var(--brass)] text-black px-7 py-4 text-[11px] font-bold uppercase tracking-[0.2em] rounded-md hover:bg-[var(--brass2)] transition-colors">Build a dossier</a>
          <a href="/website28/offer-signal" class="border border-[var(--line)] px-7 py-4 text-[11px] font-bold uppercase tracking-[0.2em] rounded-md hover:border-[var(--brass)] hover:text-[var(--brass)] transition-all">Test an offer</a>
        </div>
      </div>
      <figure class="spotlight rounded-2xl border border-[var(--line)] bg-black/30 p-6 m-0">
        <svg viewBox="0 0 600 320" class="w-full h-auto" role="img" aria-label="Stylised canal houses at dusk">
          <defs>
            <linearGradient id="ch-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#11141c"/><stop offset="1" stop-color="#0c0e14"/></linearGradient>
            <linearGradient id="ch-water" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="rgba(202,168,109,0.25)"/><stop offset="1" stop-color="rgba(170,210,255,0.05)"/></linearGradient>
          </defs>
          <rect width="600" height="320" fill="url(#ch-sky)"/>
          <circle cx="500" cy="70" r="34" fill="rgba(234,215,181,0.18)"/>
          <g stroke="#caa86d" fill="none" stroke-width="2" stroke-linejoin="round">
            <path d="M40 230 V120 h70 V230 M40 120 l35 -26 l35 26"/>
            <path d="M120 230 V100 h60 V230 M120 100 l30 -22 l30 22"/>
            <path d="M190 230 V130 h80 V230 M190 130 l40 -24 l40 24"/>
            <path d="M280 230 V90 h64 V230 M280 90 l32 -24 l32 24"/>
            <path d="M354 230 V120 h70 V230 M354 120 l35 -26 l35 26"/>
            <path d="M434 230 V108 h58 V230 M434 108 l29 -22 l29 22"/>
            <path d="M502 230 V134 h72 V230 M502 134 l36 -26 l36 26"/>
          </g>
          <g fill="rgba(202,168,109,0.5)">
            <rect x="56" y="140" width="14" height="18"/><rect x="80" y="140" width="14" height="18"/><rect x="56" y="174" width="14" height="18"/><rect x="80" y="174" width="14" height="18"/>
            <rect x="136" y="124" width="12" height="16"/><rect x="156" y="124" width="12" height="16"/><rect x="136" y="156" width="12" height="16"/><rect x="156" y="156" width="12" height="16"/>
            <rect x="300" y="116" width="14" height="18"/><rect x="322" y="116" width="14" height="18"/><rect x="300" y="150" width="14" height="18"/><rect x="322" y="150" width="14" height="18"/>
            <rect x="450" y="132" width="12" height="16"/><rect x="470" y="132" width="12" height="16"/>
          </g>
          <rect y="230" width="600" height="90" fill="url(#ch-water)"/>
          <g stroke="rgba(234,215,181,0.25)" stroke-width="1"><line x1="40" y1="250" x2="110" y2="250"/><line x1="280" y1="262" x2="344" y2="262"/><line x1="502" y1="256" x2="574" y2="256"/></g>
        </svg>
        <figcaption class="mt-4 text-[11px] uppercase tracking-[0.2em] text-[var(--mut)]">Presentation posture , less decoration, more signal.</figcaption>
      </figure>
    </div>
  </section>

  <!-- tools teaser -->
  <section class="mx-auto max-w-[1480px] px-6 py-16 grid md:grid-cols-2 gap-6">
    <a href="/website28/dossier" class="spotlight reveal-on-scroll rounded-2xl border border-[var(--line)] bg-white/[0.03] p-9 hover:border-[var(--brass)]/50 transition-colors group">
      <span class="text-[11px] font-semibold uppercase tracking-[0.25em] brass-text">Tool 01</span>
      <h2 class="text-3xl font-black tracking-tight mt-3 group-hover:text-[var(--brass)] transition-colors">Client Dossier Builder</h2>
      <p class="mt-3 text-[var(--mut)] leading-relaxed">A one-page brief , document checklist + first-week plan , generated on your device. Cuts the back-and-forth.</p>
      <span class="mt-5 inline-block text-[11px] font-semibold uppercase tracking-[0.2em] border-b border-[var(--brass)] pb-1">Open the builder →</span>
    </a>
    <a href="/website28/offer-signal" class="spotlight reveal-on-scroll rounded-2xl border border-[var(--line)] bg-white/[0.03] p-9 hover:border-[var(--brass)]/50 transition-colors group">
      <span class="text-[11px] font-semibold uppercase tracking-[0.25em] brass-text">Tool 02</span>
      <h2 class="text-3xl font-black tracking-tight mt-3 group-hover:text-[var(--brass)] transition-colors">Offer Signal Dashboard</h2>
      <p class="mt-3 text-[var(--mut)] leading-relaxed">See how an offer reads to a seller. Price matters , but certainty and conditions often decide the win.</p>
      <span class="mt-5 inline-block text-[11px] font-semibold uppercase tracking-[0.2em] border-b border-[var(--brass)] pb-1">Test an offer →</span>
    </a>
  </section>

  <!-- representation teaser -->
  <section class="mx-auto max-w-[1480px] px-6 py-16 border-t border-[var(--line)]">
    <div class="flex items-end justify-between mb-10"><h2 class="text-3xl md:text-5xl font-black tracking-tight">Selected representation.</h2><a href="/website28/approach" class="hidden sm:inline text-[11px] font-semibold uppercase tracking-[0.2em] text-[var(--mut)] c-link hover:text-[var(--ink)]">Our approach →</a></div>
    <div class="grid md:grid-cols-3 gap-5">
      {REPRESENTATION.map((r) => (
        <div class="spotlight reveal-on-scroll rounded-2xl border border-[var(--line)] bg-white/[0.03] p-7">
          <b class="block text-lg">{r.title}</b>
          <span class="block text-[11px] uppercase tracking-[0.2em] brass-text mt-1">{r.meta}</span>
          <p class="mt-4 text-sm text-[var(--mut)] leading-relaxed">{r.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[1480px] px-6 py-20 text-center">
    <h2 class="text-4xl md:text-6xl font-black tracking-tighter">Sell without chaos. Buy without guessing.</h2>
    <p class="mt-4 text-[var(--mut)] max-w-lg mx-auto">Leave your details and we reply with one clear next step , not a brochure.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/website28/callback" class="bg-[var(--brass)] text-black px-9 py-4 text-[11px] font-bold uppercase tracking-[0.2em] rounded-md hover:bg-[var(--brass2)] transition-colors">Request a call</a>
      <a href={`tel:${TEL}`} class="border border-[var(--line)] px-9 py-4 text-[11px] font-bold uppercase tracking-[0.2em] rounded-md hover:border-[var(--brass)] transition-all">Call {PHONE}</a>
    </div>
  </section>
</CivilHouseLayout>