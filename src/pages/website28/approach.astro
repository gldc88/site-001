---
/**
 * CIVIL HOUSE MAKELAARS , Approach (website28, round 2). Standards (expandable) + representation ribbon.
 */
import CivilHouseLayout from '../../layouts/CivilHouseLayout.astro';
import { STANDARDS, REPRESENTATION } from '../../data/civilhouse';
---

<CivilHouseLayout title="Approach | Civil House Makelaars" description="The non-negotiable standards behind every Civil House engagement: brief first, presentation direction, negotiation discipline, handover hygiene." active="approach">
  <section class="mx-auto max-w-[1480px] px-6 pt-16 pb-12">
    <span class="text-[11px] font-semibold uppercase tracking-[0.3em] brass-text">Approach</span>
    <h1 class="text-5xl md:text-8xl font-black tracking-tighter leading-[0.9] mt-4">Small offices win <br />by <span class="brass-text">execution.</span></h1>
    <p class="mt-7 max-w-xl text-[var(--mut)] text-lg leading-relaxed">These are our non-negotiables , the standards that keep a sale or a purchase calm, clear, and closed.</p>
  </section>

  <section class="mx-auto max-w-[1480px] px-6 pb-16">
    <div class="grid md:grid-cols-2 gap-5">
      {STANDARDS.map((s, i) => (
        <details class="spotlight reveal-on-scroll group rounded-2xl border border-[var(--line)] bg-white/[0.03] p-7" open={i === 0}>
          <summary class="cursor-pointer list-none flex items-start justify-between gap-4">
            <div><span class="text-[11px] font-mono brass-text">{String(i + 1).padStart(2, '0')}</span><b class="block text-2xl font-black tracking-tight mt-1">{s.t}</b><p class="mt-2 text-[var(--mut)] leading-relaxed">{s.lead}</p></div>
            <span class="text-2xl text-[var(--brass)] group-open:rotate-45 transition-transform shrink-0">+</span>
          </summary>
          <div class="mt-4 pt-4 border-t border-[var(--line)] text-sm text-[var(--mut)] leading-relaxed">{s.body}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[1480px] px-6 pb-20 border-t border-[var(--line)] pt-14">
    <h2 class="text-3xl md:text-5xl font-black tracking-tight mb-3">Selected representation.</h2>
    <p class="text-[var(--mut)] max-w-xl mb-10">Not a noisy feed. Just the kinds of homes we take , and the execution posture behind them.</p>
    <div class="flex flex-col divide-y divide-[var(--line)] border-y border-[var(--line)]">
      {REPRESENTATION.map((r) => (
        <div class="reveal-on-scroll py-7 grid md:grid-cols-[1fr_1.4fr] gap-3 md:gap-10 items-baseline">
          <div><b class="text-xl font-black tracking-tight">{r.title}</b><span class="block text-[11px] uppercase tracking-[0.2em] brass-text mt-1">{r.meta}</span></div>
          <p class="text-[var(--mut)] leading-relaxed">{r.body}</p>
        </div>
      ))}
    </div>
    <div class="mt-12 flex flex-wrap gap-4"><a href="/website28/dossier" class="bg-[var(--brass)] text-black px-8 py-4 text-[11px] font-bold uppercase tracking-[0.2em] rounded-md hover:bg-[var(--brass2)] transition-colors">Build your dossier</a><a href="/website28/callback" class="border border-[var(--line)] px-8 py-4 text-[11px] font-bold uppercase tracking-[0.2em] rounded-md hover:border-[var(--brass)] transition-all">Request a call</a></div>
  </section>

  <section class="section" id="otherside">
    <div class="os-head">
      <span class="kicker">The Other Side of the Table</span>
      <h2>Read your offer with their eyes.</h2>
      <p>Sellers do not read offers , they sort them into piles. Set yours below and watch
        which pile it lands in, line by line. This is the half of the deal most buyers never see.</p>
    </div>
    <div class="os-panel">
      <div class="os-controls">
        <div class="os-ctl">
          <label for="osPrice">Price vs. asking <b id="osPriceVal">at asking</b></label>
          <input type="range" id="osPrice" min="-10" max="10" step="1" value="0" aria-label="Price relative to asking, percent" />
        </div>
        <div class="os-ctl">
          <label for="osCond">Conditions <b id="osCondVal">finance clause</b></label>
          <input type="range" id="osCond" min="0" max="2" step="1" value="1" aria-label="Conditions: none, finance clause, or finance plus inspection" />
        </div>
        <div class="os-ctl">
          <label for="osFlex">Completion flexibility <b id="osFlexVal">some give</b></label>
          <input type="range" id="osFlex" min="0" max="2" step="1" value="1" aria-label="Completion flexibility: fixed, some give, or their choice" />
        </div>
      </div>
      <div class="os-mirror">
        <span class="os-pile" id="osPile">The maybe pile</span>
        <ul class="os-reads" id="osReads"></ul>
      </div>
    </div>
  </section>

  <style>
    #otherside .os-head { max-width: 640px; margin-bottom: 24px; }
    #otherside h2 { margin: 10px 0 12px; }
    .os-panel { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(22px,4vw,48px); border: 1px solid rgba(200, 170, 110, 0.25); border-radius: 6px; padding: clamp(22px,3vw,36px); background: rgba(16, 14, 10, 0.65); }
    .os-ctl { margin-bottom: 22px; }
    .os-ctl label { display: flex; justify-content: space-between; font-family: ui-monospace, monospace; font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(220, 205, 175, 0.75); margin-bottom: 8px; }
    .os-ctl label b { color: #d9b878; font-variant-numeric: tabular-nums; }
    .os-ctl input { width: 100%; accent-color: #d9b878; }
    .os-mirror { border-left: 1px solid rgba(200, 170, 110, 0.25); padding-left: clamp(18px,3vw,36px); }
    .os-pile { display: inline-block; font-family: ui-monospace, monospace; font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; border: 1px solid; }
    .os-pile.top { color: #6fd598; border-color: rgba(111, 213, 152, 0.5); background: rgba(111, 213, 152, 0.08); }
    .os-pile.maybe { color: #d9b878; border-color: rgba(217, 184, 120, 0.5); background: rgba(217, 184, 120, 0.08); }
    .os-pile.bottom { color: #e08a6a; border-color: rgba(224, 138, 106, 0.5); background: rgba(224, 138, 106, 0.08); }
    .os-reads { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
    .os-reads li { font-size: 13px; line-height: 1.6; color: rgba(230, 218, 195, 0.85); padding-left: 18px; position: relative; }
    .os-reads li::before { content: ','; position: absolute; left: 0; color: #d9b878; }
    @media (max-width: 760px) { .os-panel { grid-template-columns: 1fr; } .os-mirror { border-left: none; padding-left: 0; border-top: 1px solid rgba(200, 170, 110, 0.25); padding-top: 18px; } }
  </style>

  <script>
    /* R3 "The Other Side of the Table" , jouw bod, gelezen door de verkoper. */
    (() => {
      const price = document.getElementById('osPrice') as HTMLInputElement | null;
      const cond = document.getElementById('osCond') as HTMLInputElement | null;
      const flex = document.getElementById('osFlex') as HTMLInputElement | null;
      const priceVal = document.getElementById('osPriceVal');
      const condVal = document.getElementById('osCondVal');
      const flexVal = document.getElementById('osFlexVal');
      const pile = document.getElementById('osPile');
      const reads = document.getElementById('osReads');
      if (!price || !cond || !flex || !pile || !reads) return;
      const CONDS = ['clean , no conditions', 'finance clause', 'finance + inspection'];
      const FLEXS = ['fixed date', 'some give', 'their choice'];
      const sync = () => {
        const pv = Number(price.value), cv = Number(cond.value), fv = Number(flex.value);
        if (priceVal) priceVal.textContent = pv === 0 ? 'at asking' : `${pv > 0 ? '+' : ''}${pv}%`;
        if (condVal) condVal.textContent = CONDS[cv];
        if (flexVal) flexVal.textContent = FLEXS[fv];
        const lines: string[] = [];
        if (pv >= 3) lines.push(`"${pv}% over asking , they are serious, and they did the maths before they came."`);
        else if (pv >= 0) lines.push('"At asking. Fine. But three others are too , the number alone will not carry this."');
        else if (pv >= -5) lines.push(`"${Math.abs(pv)}% under. A tester. They are hoping we are tired."`);
        else lines.push(`"${Math.abs(pv)}% under asking , either they know something about the roof, or they are wasting my Sunday."`);
        if (cv === 0) lines.push('"No conditions. This one can actually close. That is worth more than a point of price."');
        else if (cv === 1) lines.push('"Finance clause , normal, but it means six more weeks of maybe."');
        else lines.push('"Finance AND inspection? Two doors for them to walk out of. The notary will love this."');
        if (fv === 2) lines.push('"Completion on our terms , they made the move easy for us. Smart."');
        else if (fv === 1) lines.push('"Some flexibility on the date. Workable."');
        else lines.push('"A fixed date that suits them, not us. Every clause is about them so far."');
        reads.innerHTML = lines.map((l) => `<li>${l}</li>`).join('');
        const score = pv * 1.2 + (2 - cv) * 4 + fv * 2.5;
        const bucket = score >= 9 ? 'top' : score >= 0 ? 'maybe' : 'bottom';
        pile.textContent = bucket === 'top' ? 'The take-it-seriously pile' : bucket === 'maybe' ? 'The maybe pile' : 'The bottom of the stack';
        pile.className = `os-pile ${bucket}`;
        try { localStorage.setItem('civilhouse-otherside', JSON.stringify({ pv, cv, fv, bucket })); } catch { /* private mode */ }
      };
      [price, cond, flex].forEach((el) => el.addEventListener('input', sync));
      sync();
    })();
  </script>
</CivilHouseLayout>