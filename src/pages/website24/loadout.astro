---
/**
 * NIGHTWATCH , Loadout (website24, round 2). What rides in the van + the non-destructive-first ethos.
 */
import NightwatchLayout from '../../layouts/NightwatchLayout.astro';
import { LOADOUT, TEL, PHONE } from '../../data/nightwatch';

const ETHOS = [
  { n: '01', t: 'Pick before drill', d: 'Every callout starts non-destructive. Tension, picks, and bypass tools come out first , the drill is a last resort, and you are told before it is ever used.' },
  { n: '02', t: 'Price before work', d: 'You get a confirmed price before any tool touches the lock. No "we will see at the end", no climbing invoice once the door is open.' },
  { n: '03', t: 'Upgrade the weak point', d: 'We do not just restore what failed , where a lock or frame was the weak point, we say so and offer the SKG-rated upgrade that stops a repeat.' },
];
---

<NightwatchLayout title="Loadout | Nightwatch" description="The non-destructive entry tools, anti-snap cylinders, mobile key cutting, and frame repair kit that ride in every van." active="loadout">
  <section class="mx-auto max-w-[1800px] px-6 lg:px-24 pt-16 pb-12">
    <h2 class="text-sm font-bold text-yellow-500 uppercase tracking-widest mb-4">/ Loadout</h2>
    <h1 class="text-5xl lg:text-7xl font-black tracking-tighter text-white leading-[0.9]">What rides <br />in the van.</h1>
    <p class="mt-6 max-w-lg text-zinc-400 text-lg">A van that turns up with the right kit ends most jobs without a drill , and never with a second trip.</p>
  </section>

  <section class="mx-auto max-w-[1800px] px-6 lg:px-24 pb-16 grid md:grid-cols-2 gap-px bg-white/5 border border-white/5 rounded-2xl overflow-hidden">
    {LOADOUT.map((l) => (
      <div class="bg-[#0a0a0a] p-8 flex items-center justify-between gap-6">
        <div><div class="text-white font-black text-xl tracking-tight">{l.item}</div><div class="text-sm font-mono text-zinc-500 mt-1.5">{l.spec}</div></div>
        <span class="text-[10px] font-mono uppercase tracking-widest text-yellow-500 border border-yellow-500/30 rounded px-3 py-1.5 shrink-0">{l.status}</span>
      </div>
    ))}
  </section>

  <section class="mx-auto max-w-[1800px] px-6 lg:px-24 pb-20">
    <h2 class="text-3xl font-black text-white tracking-tight mb-8">How we work.</h2>
    <div class="grid md:grid-cols-3 gap-6">
      {ETHOS.map((e) => (
        <div class="reveal-on-scroll rounded-2xl border border-white/10 bg-[#0a0a0a] p-7">
          <div class="text-3xl font-black text-yellow-500">{e.n}</div>
          <h3 class="mt-3 text-lg font-black text-white tracking-tight">{e.t}</h3>
          <p class="mt-2 text-sm text-zinc-400 leading-relaxed">{e.d}</p>
        </div>
      ))}
    </div>
    <div class="mt-12 flex justify-center"><a href={`tel:${TEL}`} class="rounded bg-yellow-500 px-10 py-5 text-xs font-black uppercase tracking-widest text-black hover:bg-yellow-400 transition-colors">Call {PHONE}</a></div>
  </section>

  <section class="section" id="triage">
    <div class="tr-head">
      <span class="kicker">The Triage Board</span>
      <h2>Order these like a locksmith.</h2>
      <p>Five upgrades, one budget. Number them in YOUR order of priority , then see how
        the trade orders them, and why. Most people guard the wrong thing first.</p>
    </div>
    <div class="tr-board">
      <ol class="tr-list" id="trList">
        <li class="tr-item" data-key="camera"><span class="tr-rank" aria-hidden="true">,</span><span class="tr-name">Doorbell camera</span><button type="button" class="tr-pick" aria-label="Set priority for doorbell camera">Set</button></li>
        <li class="tr-item" data-key="cylinder"><span class="tr-rank" aria-hidden="true">,</span><span class="tr-name">Anti-snap cylinder</span><button type="button" class="tr-pick" aria-label="Set priority for anti-snap cylinder">Set</button></li>
        <li class="tr-item" data-key="strike"><span class="tr-rank" aria-hidden="true">,</span><span class="tr-name">Reinforced strike plate</span><button type="button" class="tr-pick" aria-label="Set priority for strike plate">Set</button></li>
        <li class="tr-item" data-key="window"><span class="tr-rank" aria-hidden="true">,</span><span class="tr-name">Window locks (rear)</span><button type="button" class="tr-pick" aria-label="Set priority for window locks">Set</button></li>
        <li class="tr-item" data-key="lighting"><span class="tr-rank" aria-hidden="true">,</span><span class="tr-name">Sensor lighting</span><button type="button" class="tr-pick" aria-label="Set priority for sensor lighting">Set</button></li>
      </ol>
      <div class="tr-actions">
        <button type="button" class="tr-check" id="trCheck" disabled>Compare with the trade</button>
        <button type="button" class="tr-reset" id="trReset">Start over</button>
      </div>
      <ul class="tr-result" id="trResult" hidden></ul>
    </div>
  </section>

  <style>
    #triage .tr-head { max-width: 640px; margin-bottom: 24px; }
    #triage h2 { margin: 10px 0 12px; }
    .tr-board { border: 1px solid rgba(230, 200, 60, 0.25); border-radius: 6px; padding: clamp(20px,3vw,32px); background: rgba(14, 14, 10, 0.6); }
    .tr-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
    .tr-item { display: flex; align-items: center; gap: 14px; padding: 11px 14px; border: 1px solid rgba(230, 200, 60, 0.2); border-radius: 4px; }
    .tr-rank { font-family: ui-monospace, monospace; font-size: 15px; color: #e6c83c; min-width: 22px; text-align: center; font-variant-numeric: tabular-nums; }
    .tr-name { flex: 1; font-size: 13px; letter-spacing: 0.04em; }
    .tr-pick { font-family: ui-monospace, monospace; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: #e6c83c; background: rgba(230, 200, 60, 0.08); border: 1px solid rgba(230, 200, 60, 0.35); border-radius: 3px; padding: 6px 12px; cursor: pointer; }
    .tr-pick:disabled { opacity: 0.35; cursor: default; }
    .tr-pick:focus-visible { outline: 1px solid #e6c83c; outline-offset: 2px; }
    .tr-actions { display: flex; gap: 10px; margin-top: 16px; }
    .tr-check { font-family: ui-monospace, monospace; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: #0e0e0a; background: #e6c83c; border: none; border-radius: 3px; padding: 10px 16px; cursor: pointer; }
    .tr-check:disabled { opacity: 0.4; cursor: default; }
    .tr-reset { font-family: ui-monospace, monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(230, 210, 160, 0.6); background: none; border: 1px solid rgba(230, 200, 60, 0.25); border-radius: 3px; padding: 10px 14px; cursor: pointer; }
    .tr-result { list-style: none; margin: 18px 0 0; padding: 14px 0 0; border-top: 1px solid rgba(230, 200, 60, 0.2); display: flex; flex-direction: column; gap: 10px; }
    .tr-result li { font-size: 12.5px; line-height: 1.6; padding-left: 22px; position: relative; }
    .tr-result li::before { content: ''; position: absolute; left: 0; top: 5px; width: 10px; height: 10px; border-radius: 50%; }
    .tr-result li.hit::before { background: #56c992; }
    .tr-result li.miss::before { background: #e0963c; }
  </style>

  <script>
    /* R3 "Triage Board" , vergelijk je instinct met het vak. */
    (() => {
      const PRO = ['cylinder', 'strike', 'window', 'lighting', 'camera'];
      const WHY: Record<string, string> = {
        cylinder: 'The trade puts the anti-snap cylinder first: snapping is the loudest number in every burglary report, and it takes seconds.',
        strike: 'The strike plate second - a good cylinder in a soft frame still kicks in.',
        window: 'Rear window locks third: the back of the house is where quiet entries happen.',
        lighting: 'Sensor lighting fourth - it deters before anything is touched.',
        camera: 'The camera last: it records what the first four should have prevented.',
      };
      const items = Array.from(document.querySelectorAll<HTMLElement>('.tr-item'));
      const checkBtn = document.getElementById('trCheck') as HTMLButtonElement | null;
      const resetBtn = document.getElementById('trReset');
      const result = document.getElementById('trResult');
      if (!items.length || !checkBtn || !result) return;
      let order: string[] = [];

      const sync = () => {
        items.forEach((it) => {
          const idx = order.indexOf(it.dataset.key || '');
          const rank = it.querySelector('.tr-rank');
          const btn = it.querySelector<HTMLButtonElement>('.tr-pick');
          if (rank) rank.textContent = idx >= 0 ? String(idx + 1) : ',';
          if (btn) btn.disabled = idx >= 0;
        });
        checkBtn.disabled = order.length !== 5;
      };
      items.forEach((it) => it.querySelector('.tr-pick')?.addEventListener('click', () => {
        const k = it.dataset.key || '';
        if (!order.includes(k)) order.push(k);
        sync();
      }));
      checkBtn.addEventListener('click', () => {
        result.hidden = false;
        result.innerHTML = PRO.map((k, i) => {
          const yours = order.indexOf(k) + 1;
          const hit = yours === i + 1;
          return `<li class="${hit ? 'hit' : 'miss'}"><b>#${i + 1} ${k === 'cylinder' ? 'Anti-snap cylinder' : k === 'strike' ? 'Strike plate' : k === 'window' ? 'Window locks' : k === 'lighting' ? 'Sensor lighting' : 'Doorbell camera'}</b> (you said #${yours}) , ${WHY[k]}</li>`;
        }).join('');
        const hits = PRO.filter((k, i) => order[i] === k).length;
        try { localStorage.setItem('nightwatch-triage', JSON.stringify({ order, hits })); } catch { /* private mode */ }
      });
      resetBtn?.addEventListener('click', () => { order = []; result.hidden = true; result.innerHTML = ''; sync(); });
      sync();
    })();
  </script>
</NightwatchLayout>