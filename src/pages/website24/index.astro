---
/**
 * NIGHTWATCH , Home (website24, round 2). Hero with the interactive lock-pick, plus service / scenario /
 * loadout teasers and a 24/7 callback CTA.
 */
import NightwatchLayout from '../../layouts/NightwatchLayout.astro';
import LockPick from '../../components/nightwatch/LockPick.astro';
import { SERVICES, INCIDENTS, LOADOUT, ICONS, PHONE, TEL, SERVICE_AREA } from '../../data/nightwatch';
---

<NightwatchLayout title="Nightwatch , 24/7 Locksmith Dispatch" description="24/7 emergency locksmith. Non-destructive entry by default. Pick the lock to see how we work, then request a callback.">
  <section class="relative border-b border-white/5">
    <div class="mx-auto max-w-[1800px] grid lg:grid-cols-2">
      <div class="px-6 lg:px-24 py-20 lg:py-28 flex flex-col justify-center">
        <span class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-widest text-yellow-500"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> On call · {SERVICE_AREA}</span>
        <h1 class="mt-6 text-5xl lg:text-7xl font-black tracking-tighter leading-[0.9] text-white">Locked out? <br /><span id="heroState" class="text-yellow-500">We open it.</span></h1>
        <p class="mt-6 max-w-md text-zinc-400 leading-relaxed">24/7 emergency locksmith dispatch. We pick and bypass before anything destructive , drilling is the last resort, and never a surprise. Try the lock on the right.</p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href={`tel:${TEL}`} class="rounded bg-yellow-500 px-7 py-4 text-xs font-black uppercase tracking-widest text-black hover:bg-yellow-400 transition-colors">Call {PHONE}</a>
          <a href="/website24/callback" class="rounded border border-white/15 px-7 py-4 text-xs font-black uppercase tracking-widest text-white hover:border-yellow-500/50 hover:text-yellow-500 transition-all">Request callback</a>
        </div>
      </div>
      <div class="px-6 py-16 flex items-center justify-center border-t lg:border-t-0 lg:border-l border-white/5 bg-[#070707]">
        <div class="w-full"><LockPick /></div>
      </div>
    </div>
  </section>

  <!-- services teaser -->
  <section class="border-b border-white/5">
    <div class="mx-auto max-w-[1800px] grid lg:grid-cols-2">
      <div class="p-10 lg:p-24 lg:border-r border-white/5">
        <h2 class="text-sm font-bold text-yellow-500 uppercase tracking-widest mb-4">/ Services</h2>
        <h3 class="text-3xl lg:text-4xl font-black text-white mb-6 tracking-tight">Locksmith work, done properly.</h3>
        <p class="text-zinc-400 text-lg max-w-md leading-relaxed">Residential and small commercial. Emergency callouts and planned upgrades. Clean work, clear decisions, no surprises.</p>
        <a href="/website24/services" class="mt-8 inline-block text-xs font-black uppercase tracking-widest text-white border-b-2 border-yellow-500 pb-1 hover:text-yellow-500 transition-colors">All services →</a>
      </div>
      <div class="flex flex-col bg-[#080808]">
        {SERVICES.map((s) => (
          <a href="/website24/services" class="group border-b border-white/5 p-8 flex items-center justify-between hover:bg-white/[0.02] transition-colors last:border-b-0 relative overflow-hidden">
            <div class="absolute left-0 top-0 w-1 h-full bg-yellow-500 -translate-x-full group-hover:translate-x-0 transition-transform duration-300"></div>
            <div class="flex items-center gap-6 relative z-10">
              <div class="text-zinc-600 group-hover:text-yellow-500 transition-colors w-5 h-5"><Fragment set:html={ICONS[s.icon] || ICONS.bolt} /></div>
              <div><span class="text-yellow-600/50 text-[10px] font-mono mb-1 block group-hover:text-yellow-500 transition-colors">{s.code}</span><h3 class="text-lg font-bold tracking-tight text-zinc-300 group-hover:text-white transition-colors">{s.title}</h3></div>
            </div>
            <span class="hidden md:block text-xs text-zinc-500 font-mono max-w-[44%] text-right group-hover:text-zinc-300 transition-colors">{s.line}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- scenarios + loadout teaser -->
  <section class="mx-auto max-w-[1800px] px-6 lg:px-24 py-20 grid lg:grid-cols-2 gap-16">
    <div class="reveal-on-scroll">
      <h2 class="text-sm font-bold text-yellow-500 uppercase tracking-widest mb-4">/ Scenarios</h2>
      <h3 class="text-3xl font-black text-white mb-6 tracking-tight">Whatever just happened, there is a plan.</h3>
      <div class="grid grid-cols-2 gap-3">
        {INCIDENTS.map((i) => (<a href="/website24/scenarios" class="rounded-lg border border-white/10 bg-white/[0.02] px-5 py-4 hover:border-yellow-500/40 transition-colors"><div class="text-white font-bold">{i.label}</div><div class="text-[11px] font-mono text-zinc-500 mt-1">{i.title}</div></a>))}
      </div>
      <a href="/website24/scenarios" class="mt-6 inline-block text-xs font-black uppercase tracking-widest text-white border-b-2 border-yellow-500 pb-1 hover:text-yellow-500 transition-colors">Open the playbook →</a>
    </div>
    <div class="reveal-on-scroll">
      <h2 class="text-sm font-bold text-yellow-500 uppercase tracking-widest mb-4">/ Loadout</h2>
      <h3 class="text-3xl font-black text-white mb-6 tracking-tight">What rides in the van.</h3>
      <div class="flex flex-col gap-px bg-white/5 border border-white/5 rounded-lg overflow-hidden">
        {LOADOUT.map((l) => (<div class="bg-[#0a0a0a] p-5 flex items-center justify-between"><div><div class="text-white font-bold text-sm">{l.item}</div><div class="text-[11px] font-mono text-zinc-500 mt-0.5">{l.spec}</div></div><span class="text-[10px] font-mono uppercase tracking-widest text-yellow-500 border border-yellow-500/30 rounded px-2 py-1 shrink-0">{l.status}</span></div>))}
      </div>
      <a href="/website24/loadout" class="mt-6 inline-block text-xs font-black uppercase tracking-widest text-white border-b-2 border-yellow-500 pb-1 hover:text-yellow-500 transition-colors">See the loadout →</a>
    </div>
  </section>

  <section class="border-t border-white/5 bg-[#080808]">
    <div class="mx-auto max-w-3xl px-6 py-24 text-center">
      <h2 class="text-4xl lg:text-6xl font-black tracking-tighter text-white">One call. Door open.</h2>
      <p class="mt-5 text-zinc-400 max-w-lg mx-auto">Tell us where you are and what happened. Dispatch rings you back in minutes with an ETA and a price before any work starts.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-4">
        <a href={`tel:${TEL}`} class="rounded bg-yellow-500 px-9 py-4 text-xs font-black uppercase tracking-widest text-black hover:bg-yellow-400 transition-colors">Call {PHONE}</a>
        <a href="/website24/callback" class="rounded border border-white/15 px-9 py-4 text-xs font-black uppercase tracking-widest text-white hover:border-yellow-500/50 hover:text-yellow-500 transition-all">Request callback</a>
      </div>
    </div>
  </section>
</NightwatchLayout>