---
/**
 * NIGHTWATCH , Scenarios (website24, round 2). Pick your situation -> what to do now + what's included.
 */
import NightwatchLayout from '../../layouts/NightwatchLayout.astro';
import { INCIDENTS, TEL, PHONE } from '../../data/nightwatch';
const first = INCIDENTS[0];
---

<NightwatchLayout title="Scenarios | Nightwatch" description="Locked out, broken key, lost keys, or a break-in , pick your situation for what to do now and what's included." active="scenarios">
  <section class="mx-auto max-w-[1800px] px-6 lg:px-24 pt-16 pb-12">
    <h2 class="text-sm font-bold text-yellow-500 uppercase tracking-widest mb-4">/ Scenario playbook</h2>
    <h1 class="text-5xl lg:text-7xl font-black tracking-tighter text-white leading-[0.9]">What just <br />happened?</h1>
    <p class="mt-6 max-w-lg text-zinc-400 text-lg">Pick the situation. We will tell you exactly what to do right now, and exactly what the callout includes.</p>
  </section>

  <section class="mx-auto max-w-[1800px] px-6 lg:px-24 pb-24 grid lg:grid-cols-[320px_1fr] gap-8">
    <div class="flex flex-col gap-2">
      {INCIDENTS.map((i, idx) => (
        <button type="button" class={`scenario-btn text-left rounded-lg border-l-2 px-5 py-4 transition-colors ${idx === 0 ? 'text-white bg-white/5 border-l-yellow-500' : 'text-zinc-500 border-l-transparent hover:text-zinc-300 hover:bg-white/[0.02]'}`} data-key={i.key} aria-pressed={idx === 0 ? 'true' : 'false'}>
          <div class="font-black tracking-tight">{i.label}</div>
          <div class="text-[11px] font-mono text-zinc-500 mt-0.5">{i.title}</div>
        </button>
      ))}
    </div>

    <div id="displayContainer" class="rounded-2xl border border-white/10 bg-[#0a0a0a] p-8 lg:p-12 transition-opacity duration-200">
      <div class="text-[10px] font-mono uppercase tracking-widest text-yellow-500 mb-2">Response package</div>
      <h3 id="pkgTitle" class="text-3xl font-black text-white tracking-tight">{first.title}</h3>
      <p id="pkgLine" class="mt-3 text-zinc-400 leading-relaxed max-w-2xl">{first.line}</p>
      <div class="mt-8 grid sm:grid-cols-2 gap-8">
        <div>
          <div class="text-[10px] font-mono uppercase tracking-widest text-zinc-500 mb-4">What to do now</div>
          <ul id="pkgPrep" class="flex flex-col gap-3 text-sm text-zinc-300">
            {first.prep.map((p) => <li class="flex items-center gap-4"><span class="w-1.5 h-1.5 bg-yellow-500 rounded-full shadow-[0_0_8px_rgba(234,179,8,0.8)]"></span> {p}</li>)}
          </ul>
        </div>
        <div>
          <div class="text-[10px] font-mono uppercase tracking-widest text-zinc-500 mb-4">What's included</div>
          <ul id="pkgInc" class="flex flex-col gap-3 text-sm font-mono text-emerald-400/90">
            {first.includes.map((p) => <li>// {p}</li>)}
          </ul>
        </div>
      </div>
      <div class="mt-10 flex flex-wrap gap-4 border-t border-white/5 pt-8">
        <a href={`tel:${TEL}`} class="rounded bg-yellow-500 px-7 py-3.5 text-xs font-black uppercase tracking-widest text-black hover:bg-yellow-400 transition-colors">Call {PHONE}</a>
        <a href="/website24/callback" class="rounded border border-white/15 px-7 py-3.5 text-xs font-black uppercase tracking-widest text-white hover:border-yellow-500/50 hover:text-yellow-500 transition-all">Request callback</a>
      </div>
    </div>
  </section>

  <script type="application/json" id="incidentData" set:html={JSON.stringify(INCIDENTS)}></script>
  <script>
    const INCIDENTS = JSON.parse(document.getElementById('incidentData')?.textContent || '[]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const btns = Array.from(document.querySelectorAll<HTMLElement>('.scenario-btn'));
    const display = document.getElementById('displayContainer');
    const pkgTitle = document.getElementById('pkgTitle');
    const pkgLine = document.getElementById('pkgLine');
    const pkgPrep = document.getElementById('pkgPrep');
    const pkgInc = document.getElementById('pkgInc');
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => { const on = x === b; x.setAttribute('aria-pressed', String(on)); x.classList.toggle('text-white', on); x.classList.toggle('bg-white/5', on); x.classList.toggle('border-l-yellow-500', on); x.classList.toggle('text-zinc-500', !on); x.classList.toggle('border-l-transparent', !on); });
      const d = INCIDENTS.find((x: any) => x.key === b.dataset.key);
      if (!d || !display) return;
      display.style.opacity = '0.35';
      window.setTimeout(() => {
        if (pkgTitle) pkgTitle.textContent = d.title;
        if (pkgLine) pkgLine.textContent = d.line;
        if (pkgPrep) pkgPrep.innerHTML = d.prep.map((p: string) => `<li class="flex items-center gap-4"><span class="w-1.5 h-1.5 bg-yellow-500 rounded-full shadow-[0_0_8px_rgba(234,179,8,0.8)]"></span> ${p}</li>`).join('');
        if (pkgInc) pkgInc.innerHTML = d.includes.map((p: string) => `<li>// ${p}</li>`).join('');
        display.style.opacity = '1';
      }, reduce ? 0 : 150);
    }));
  </script>
</NightwatchLayout>