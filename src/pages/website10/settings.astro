---
/**
 * UNFORM / 010 , Settings (website10, round 2). Signature: a LIVE theme control panel that rewrites
 * CSS custom properties on :root and persists to localStorage, so the theme follows you everywhere.
 */
import UnformLayout from '../../layouts/UnformLayout.astro';

const ACCENTS = [
  { name: 'Cobalt', a: '#3b82f6', b: '#a855f7' },
  { name: 'Violet', a: '#8b5cf6', b: '#ec4899' },
  { name: 'Emerald', a: '#10b981', b: '#3b82f6' },
  { name: 'Amber', a: '#f59e0b', b: '#ef4444' },
  { name: 'Rose', a: '#f43f5e', b: '#8b5cf6' },
  { name: 'Cyan', a: '#06b6d4', b: '#6366f1' },
];
---

<UnformLayout title="Settings | UNFORM / 010" description="Retune UNFORM / 010 , accent, corners, density, and wallpaper. Your choices persist across every page." active="settings">
  <div class="page-hero">
    <span class="overline">Settings</span>
    <h1>Make it <em>yours</em>.</h1>
    <p class="sub">An anti-template shouldn't be fixed. Change the accent, the corners, the spacing, the wallpaper , it updates live and follows you to every page. (Saved to your browser only.)</p>
  </div>

  <section class="section tight">
    <div class="set-grid">
      <div class="win controls">
        <div class="win-bar"><span class="win-dots"><i></i><i></i><i></i></span><span class="win-title">Appearance</span></div>
        <div class="win-body set-body">
          <div class="set-row">
            <label>Accent</label>
            <div class="swatches" id="swatches">
              {ACCENTS.map((c, i) => (
                <button class={`swatch ${i === 0 ? 'active' : ''}`} data-a={c.a} data-b={c.b} title={c.name} style={`background:linear-gradient(120deg, ${c.a}, ${c.b})`} aria-label={c.name}></button>
              ))}
            </div>
          </div>
          <div class="set-row slider"><label for="rad">Corner radius <span class="val" id="radVal">16px</span></label><input id="rad" type="range" min="0" max="26" step="1" value="16" /></div>
          <div class="set-row slider"><label for="den">Density <span class="val" id="denVal">1.00×</span></label><input id="den" type="range" min="0.7" max="1.3" step="0.05" value="1" /></div>
          <div class="set-row slider"><label for="wash">Wallpaper <span class="val" id="washVal">0.10</span></label><input id="wash" type="range" min="0" max="0.26" step="0.01" value="0.10" /></div>
          <div class="set-actions">
            <button class="btn" id="saveBtn">Save theme</button>
            <button class="btn-ghost" id="resetBtn">Reset to default</button>
          </div>
          <p class="set-note" id="setNote">Changes preview instantly. Save to keep them across visits.</p>
        </div>
      </div>

      <div class="win preview">
        <div class="win-bar"><span class="win-dots"><i></i><i></i><i></i></span><span class="win-title">Preview</span></div>
        <div class="win-body">
          <span class="overline">Live preview</span>
          <h3 class="pv-h">The whole site, retuned.</h3>
          <p class="pv-p">Buttons, panels, links, and the wallpaper all read from these variables. What you see here is exactly what the rest of UNFORM / 010 looks like right now.</p>
          <div class="pv-chips"><span class="pv-chip">accent</span><span class="pv-chip">radius</span><span class="pv-chip">density</span></div>
          <div class="pv-btns"><span class="btn">Primary</span><span class="btn-ghost">Secondary</span></div>
          <a href="/website10/work" class="inline-link" style="margin-top:18px; display:inline-block;">See it on the work page →</a>
        </div>
      </div>
    </div>
  </section>

  <div id="toast" role="status" aria-live="polite"></div>

  <style>
    .set-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }
    .set-body { display: flex; flex-direction: column; gap: 24px; }
    .set-row { display: flex; flex-direction: column; gap: 12px; }
    .set-row > label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); display: flex; justify-content: space-between; align-items: center; }
    .val { color: var(--accent); }
    .swatches { display: flex; gap: 10px; flex-wrap: wrap; }
    .swatch { width: 42px; height: 42px; border-radius: 12px; border: 2px solid transparent; transition: transform 0.2s, border-color 0.2s; box-shadow: 0 6px 18px -8px rgba(0,0,0,0.6); }
    .swatch:hover { transform: scale(1.08); }
    .swatch.active { border-color: #fff; }
    .slider input[type=range] { -webkit-appearance: none; appearance: none; width: 100%; height: 4px; border-radius: 100px; background: var(--hair); outline: none; }
    .slider input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 18px; height: 18px; border-radius: 50%; background: var(--accent); cursor: pointer; box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 24%, transparent); }
    .slider input[type=range]::-moz-range-thumb { width: 18px; height: 18px; border: none; border-radius: 50%; background: var(--accent); cursor: pointer; }
    .set-actions { display: flex; gap: 12px; flex-wrap: wrap; }
    .set-note { font-family: var(--mono); font-size: 11px; color: var(--faint); }

    .preview { position: sticky; top: 70px; }
    .pv-h { font-size: 1.7rem; color: #fff; margin: 14px 0 12px; }
    .pv-p { color: var(--muted); line-height: 1.6; }
    .pv-chips { display: flex; gap: 8px; margin: 20px 0; flex-wrap: wrap; }
    .pv-chip { font-family: var(--mono); font-size: 11px; color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); padding: 6px 12px; border-radius: 100px; }
    .pv-btns { display: flex; gap: 12px; flex-wrap: wrap; }

    @media (max-width: 820px) { .set-grid { grid-template-columns: 1fr; } .preview { position: static; } }
  </style>

  <script>
    const root = document.documentElement;
    const swatches = Array.from(document.querySelectorAll<HTMLElement>('.swatch'));
    const rad = document.getElementById('rad') as HTMLInputElement;
    const den = document.getElementById('den') as HTMLInputElement;
    const wash = document.getElementById('wash') as HTMLInputElement;
    const radVal = document.getElementById('radVal')!, denVal = document.getElementById('denVal')!, washVal = document.getElementById('washVal')!;
    const toast = document.getElementById('toast');
    let tT = 0;

    const state = { accent: '#3b82f6', accent2: '#a855f7', radius: 16, density: 1, wash: 0.1 };

    function load() {
      try { Object.assign(state, JSON.parse(localStorage.getItem('unform-theme') || '{}')); } catch (e) {}
      rad.value = String(state.radius); den.value = String(state.density); wash.value = String(state.wash);
      swatches.forEach((s) => s.classList.toggle('active', s.dataset.a === state.accent));
      if (!swatches.some((s) => s.classList.contains('active')) && swatches[0]) swatches[0].classList.add('active');
      paint();
    }
    function paint() {
      root.style.setProperty('--accent', state.accent);
      root.style.setProperty('--accent2', state.accent2);
      root.style.setProperty('--radius', state.radius + 'px');
      root.style.setProperty('--density', String(state.density));
      root.style.setProperty('--wash', String(state.wash));
      radVal.textContent = state.radius + 'px';
      denVal.textContent = state.density.toFixed(2) + '×';
      washVal.textContent = Number(state.wash).toFixed(2);
    }
    swatches.forEach((s) => s.addEventListener('click', () => { swatches.forEach((x) => x.classList.toggle('active', x === s)); state.accent = s.dataset.a!; state.accent2 = s.dataset.b!; paint(); }));
    rad.addEventListener('input', () => { state.radius = Number(rad.value); paint(); });
    den.addEventListener('input', () => { state.density = Number(den.value); paint(); });
    wash.addEventListener('input', () => { state.wash = Number(wash.value); paint(); });

    const showToast = (m: string) => { if (!toast) return; toast.textContent = m; toast.classList.add('show'); clearTimeout(tT); tT = window.setTimeout(() => toast.classList.remove('show'), 4200); };
    document.getElementById('saveBtn')?.addEventListener('click', () => { localStorage.setItem('unform-theme', JSON.stringify(state)); showToast('Theme saved , it will follow you across every page.'); });
    document.getElementById('resetBtn')?.addEventListener('click', () => {
      Object.assign(state, { accent: '#3b82f6', accent2: '#a855f7', radius: 16, density: 1, wash: 0.1 });
      localStorage.removeItem('unform-theme');
      swatches.forEach((s, i) => s.classList.toggle('active', i === 0));
      rad.value = '16'; den.value = '1'; wash.value = '0.1';
      paint(); showToast('Reset to the default theme.');
    });
    load();
  </script>
</UnformLayout>