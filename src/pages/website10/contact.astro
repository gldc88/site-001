---
/**
 * UNFORM / 010 , Contact (website10, round 2). Signature: a console-styled enquiry -> ref + toast.
 */
import UnformLayout from '../../layouts/UnformLayout.astro';

const TYPES = ['Architecture', 'Identity', 'UI / UX', 'Print', 'Not sure yet'];
const BUDGETS = ['Under £10k', '£10k – £30k', '£30k – £75k', '£75k+'];
---

<UnformLayout title="Contact | UNFORM / 010" description="Open the console and say hello. UNFORM / 010 takes on four projects a quarter." active="contact">
  <div class="page-hero">
    <span class="overline">Contact</span>
    <h1>Open the <em>console</em>.</h1>
    <p class="sub">Tell us what you're trying to make. We reply to everything within two working days, even the ones that aren't a fit.</p>
  </div>

  <section class="section tight">
    <div class="con-grid">
      <div class="win console">
        <div class="win-bar"><span class="win-dots"><i></i><i></i><i></i></span><span class="win-title">unform@console , new_enquiry</span></div>
        <form id="conForm" class="win-body con-form" novalidate>
          <p class="con-line"><span class="prompt">›</span> initialise new project enquiry…</p>
          <div class="cf-row">
            <div class="fld"><label for="cname">name</label><input id="cname" name="name" type="text" autocomplete="name" /><span class="err" data-err="name"></span></div>
            <div class="fld"><label for="cemail">email</label><input id="cemail" name="email" type="email" autocomplete="email" /><span class="err" data-err="email"></span></div>
          </div>
          <div class="cf-row">
            <div class="fld"><label for="ctype">project type</label><select id="ctype" name="type">{TYPES.map((t) => <option>{t}</option>)}</select></div>
            <div class="fld"><label for="cbudget">budget</label><select id="cbudget" name="budget">{BUDGETS.map((b) => <option>{b}</option>)}</select></div>
          </div>
          <div class="fld"><label for="cmsg">message</label><textarea id="cmsg" name="message" rows="4" placeholder="what are you trying to make, and by when?"></textarea><span class="err" data-err="message"></span></div>
          <button type="submit" class="btn" style="width:100%; text-align:center;">› send enquiry</button>
          <p class="con-out" id="conOut">awaiting input…</p>
        </form>
      </div>

      <aside class="con-side">
        <div class="win">
          <div class="win-bar"><span class="win-dots"><i></i><i></i><i></i></span><span class="win-title">channels</span></div>
          <div class="win-body con-channels">
            <a href="mailto:studio@unform010.example"><span>email</span>studio@unform010.example</a>
            <a href="#"><span>signal</span>@unform010</a>
            <a href="/website10/studio"><span>studio</span>how we work →</a>
          </div>
        </div>
        <div class="win">
          <div class="win-bar"><span class="win-dots"><i></i><i></i><i></i></span><span class="win-title">availability</span></div>
          <div class="win-body con-avail">
            <p><span class="led-on"></span> Taking new work for next quarter.</p>
            <p class="ca-meta">4 projects / quarter · 2 slots open</p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <div id="toast" role="status" aria-live="polite"></div>

  <style>
    .con-grid { display: grid; grid-template-columns: 1.4fr 0.85fr; gap: 16px; align-items: start; }
    .con-form { display: flex; flex-direction: column; gap: 16px; }
    .con-line { font-family: var(--mono); font-size: 0.85rem; color: var(--muted); }
    .prompt { color: var(--accent); }
    .cf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .con-form textarea { resize: vertical; }
    .con-out { font-family: var(--mono); font-size: 0.8rem; color: var(--faint); border-top: 1px solid var(--hair); padding-top: 14px; }
    .con-out.ok { color: var(--accent); }

    .con-side { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 70px; }
    .con-channels { display: flex; flex-direction: column; gap: 4px; }
    .con-channels a { display: flex; flex-direction: column; gap: 3px; padding: 14px 0; border-bottom: 1px solid var(--hair); font-size: 1rem; color: #fff; transition: color 0.2s; }
    .con-channels a:last-child { border-bottom: none; }
    .con-channels a span { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); }
    .con-channels a:hover { color: var(--accent); }
    .con-avail p { display: flex; align-items: center; gap: 10px; color: var(--ink); }
    .led-on { width: 9px; height: 9px; border-radius: 50%; background: #28c840; box-shadow: 0 0 10px #28c840; }
    .ca-meta { font-family: var(--mono); font-size: 0.8rem; color: var(--muted); margin-top: 10px; }

    @media (max-width: 820px) { .con-grid { grid-template-columns: 1fr; } .con-side { position: static; } }
    @media (max-width: 520px) { .cf-row { grid-template-columns: 1fr; } }
  </style>

  <script>
    const form = document.getElementById('conForm') as HTMLFormElement;
    const out = document.getElementById('conOut')!;
    const toast = document.getElementById('toast');
    let tT = 0;
    const setErr = (n: string, m: string) => { const e = form.querySelector<HTMLElement>(`[data-err="${n}"]`); const i = form.querySelector<HTMLElement>(`[name="${n}"]`); if (e) e.textContent = m; if (i) i.style.borderColor = m ? '#ff7a8a' : ''; };
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const name = String(d.get('name') || '').trim();
      const email = String(d.get('email') || '').trim();
      const msg = String(d.get('message') || '').trim();
      let ok = true;
      if (name.length < 2) { setErr('name', 'enter a name'); ok = false; } else setErr('name', '');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setErr('email', 'enter a valid email'); ok = false; } else setErr('email', '');
      if (msg.length < 8) { setErr('message', 'a sentence or two'); ok = false; } else setErr('message', '');
      if (!ok) { out.textContent = '✗ enquiry not sent , check the fields above.'; out.classList.remove('ok'); return; }
      const ref = 'UF-' + Math.random().toString(36).slice(2, 6).toUpperCase();
      out.textContent = `✓ enquiry ${ref} sent , reply within 2 working days.`;
      out.classList.add('ok');
      if (toast) { toast.textContent = `Thanks ${name.split(' ')[0]} , enquiry ${ref} received. We'll reply within two working days.`; toast.classList.add('show'); clearTimeout(tT); tT = window.setTimeout(() => toast.classList.remove('show'), 6000); }
      form.reset();
    });
  </script>
</UnformLayout>