---
/**
 * UNFORM / 010 , Studio (website10, round 2). The anti-template manifesto, process, and studio facts.
 */
import UnformLayout from '../../layouts/UnformLayout.astro';

const PRINCIPLES = [
  { n: '01', t: 'Remove first', d: 'Design is subtraction. We start with too much and cut until only the load-bearing parts remain.' },
  { n: '02', t: 'Survive the strip', d: 'A brand should hold up in one typeface and one colour. If it needs the gradient to work, it does not work.' },
  { n: '03', t: 'Calm under pressure', d: 'Interfaces are judged on their worst day, not their demo. We design the error states before the happy path.' },
  { n: '04', t: 'A digital spine', d: 'Even print should be structured like software , indexed, systematic, and built to be reissued.' },
];
const PROCESS = [
  { t: 'Brief', d: 'One page. The decision, the constraints, and what success actually looks like.' },
  { t: 'Reductions', d: 'We propose less than you asked for, and explain what each cut buys you.' },
  { t: 'Build', d: 'A small number of real artifacts, not a deck of directions. Production-ready.' },
  { t: 'Handover', d: 'Files, rules, and a short loom. You own all of it, no retainer required.' },
];
const FACTS = [
  { k: 'Size', v: 'Three people' },
  { k: 'Capacity', v: 'Four projects / quarter' },
  { k: 'Founded', v: 'Studio 010' },
  { k: 'Where', v: 'Remote, GMT±3' },
];
---

<UnformLayout title="Studio | UNFORM / 010" description="UNFORM / 010 is an anti-template studio of three. We design less, on purpose , architecture, identity, UI, and print." active="studio">
  <div class="page-hero">
    <span class="overline">Studio</span>
    <h1>We design <em>less</em>, on purpose.</h1>
    <p class="sub">UNFORM / 010 is a studio of three. We take on four projects a quarter so each one gets the attention it needs. No templates, no retainers, no filler.</p>
  </div>

  <section class="section tight">
    <div class="sec-head"><div><span class="overline">Manifesto</span><h2>Four rules we don't break.</h2></div></div>
    <div class="principles">
      {PRINCIPLES.map((p) => (
        <div class="principle win" data-reveal="up">
          <div class="win-bar"><span class="win-dots"><i></i><i></i><i></i></span><span class="win-title">rule_{p.n}</span></div>
          <div class="win-body"><span class="pr-n">{p.n}</span><h3>{p.t}</h3><p>{p.d}</p></div>
        </div>
      ))}
    </div>
  </section>

  <section class="section tight">
    <div class="sec-head"><div><span class="overline">Process</span><h2>Four steps, no theatre.</h2></div></div>
    <div class="process">
      {PROCESS.map((s, i) => (
        <div class="pstep" data-reveal="up"><span class="ps-n">{String(i + 1).padStart(2, '0')}</span><div><h4>{s.t}</h4><p>{s.d}</p></div></div>
      ))}
    </div>
  </section>

  <section class="section tight">
    <div class="facts win">
      <div class="win-bar"><span class="win-dots"><i></i><i></i><i></i></span><span class="win-title">studio.info</span></div>
      <div class="win-body facts-grid">
        {FACTS.map((f) => (<div class="fact"><span class="fact-k">{f.k}</span><span class="fact-v">{f.v}</span></div>))}
      </div>
    </div>
    <div class="studio-cta" data-reveal="up">
      <a href="/website10/contact" class="btn">Start a project</a>
      <a href="/website10/work" class="btn-ghost">See the work</a>
    </div>
  </section>

  <style>
    .principles { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .principle .win-body { position: relative; padding-top: 26px; }
    .pr-n { font-family: var(--mono); font-size: 11px; color: var(--accent); }
    .principle h3 { font-size: 1.5rem; color: #fff; margin: 8px 0 10px; }
    .principle p { color: var(--muted); line-height: 1.6; }

    .process { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
    .pstep { display: flex; flex-direction: column; gap: 12px; padding: 26px 22px; border: 1px solid var(--hair); border-radius: var(--radius); background: rgba(255,255,255,0.02); }
    .ps-n { font-family: var(--mono); font-size: 1.6rem; color: color-mix(in srgb, var(--accent) 70%, #fff); }
    .pstep h4 { font-size: 1.2rem; color: #fff; }
    .pstep p { color: var(--muted); font-size: 0.9rem; margin-top: 6px; line-height: 1.55; }

    .facts-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--hair); border-radius: 10px; overflow: hidden; border: 1px solid var(--hair); }
    .fact { background: var(--glass-2); padding: 22px 18px; display: flex; flex-direction: column; gap: 8px; }
    .fact-k { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
    .fact-v { font-size: 1.2rem; color: #fff; font-weight: 600; }
    .studio-cta { margin-top: 30px; display: flex; gap: 12px; flex-wrap: wrap; }

    @media (max-width: 820px) { .principles { grid-template-columns: 1fr; } .process { grid-template-columns: 1fr 1fr; } .facts-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 480px) { .process { grid-template-columns: 1fr; } }
  </style>
</UnformLayout>