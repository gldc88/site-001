---
/**
 * AETHER CRYSTALWORKS , Craft (website12, round 2). The process, told editorially.
 */
import AetherLayout from '../../layouts/AetherLayout.astro';

const STEPS = [
  { n: '01', t: 'Annealing', d: 'Raw optical glass is heated and cooled along a precise curve over several days, releasing the internal stress left by casting. It is the slowest step and the one nobody sees , but it is why a piece stays true, and won\'t craze or cloud with age.' },
  { n: '02', t: 'Cold-cut facets', d: 'Geometry is measured first, then cut cold, one face at a time. We design the angles for how light should move through the piece and cut to them exactly. The spark is a consequence of precision, never the goal of it.' },
  { n: '03', t: 'Hand polish', d: 'Every edge is worked by hand through finer and finer grits until it disappears. What is left is not an edge but a line of light , the detail that separates an optical object from a paperweight.' },
];
---

<AetherLayout title="Craft | Aether Crystalworks" description="How each Aether piece is made , annealing, cold-cut facets, and hand polish, in optical K9 glass." active="craft">
  <section class="page-hero">
    <div class="page-hero-media"><img src="/website12/crystal.jpg" alt="A clear lab-grown crystal catching light" fetchpriority="high" /></div>
    <div class="page-hero-scrim" aria-hidden="true"></div>
    <div class="page-hero-inner">
      <span class="overline">The Craft</span>
      <h1>From melt to <em>mirror</em>.</h1>
      <p class="sub">An optical object is mostly patience. Three slow steps stand between raw glass and a piece that does something exact with light.</p>
    </div>
  </section>

  <section class="section">
    <div class="steps">
      {STEPS.map((s) => (
        <div class="step" data-reveal="up">
          <span class="st-n">{s.n}</span>
          <div class="st-body"><h2>{s.t}</h2><p>{s.d}</p></div>
        </div>
      ))}
    </div>
  </section>

  <section class="section tight why-band">
    <div class="wb-copy">
      <span class="overline" data-reveal="fade">The material</span>
      <h2 data-reveal="up">Why optical glass, not crystal.</h2>
      <p data-reveal="up">We work in optical K9 , the glass made for camera lenses, not for chandeliers. It transmits more light and scatters less of it, holds a finer polish, and keeps its clarity for decades. "Lead crystal" sparkles because it is impure; optical glass is chosen because it is not.</p>
      <p data-reveal="up" class="wb-note">Every blank is lab-grown to a known refractive index, so two pieces of the same series behave identically in the same light.</p>
    </div>
    <div class="wb-media" data-reveal="fade"><img src="/website12/crystals.jpg" alt="Sharp clear optical crystals" loading="lazy" /></div>
  </section>

  <section class="section bench-sect" id="bench">
    <div class="bench-head">
      <span class="overline" data-reveal="fade">The Bench</span>
      <h2 data-reveal="up">Route the beam.</h2>
      <p data-reveal="up">Every commission is proven on the bench before it ships. Try it: send the beam
        through all three prisms in order of <em>ascending refractive index</em>, and land it on the sensor.</p>
    </div>
    <div class="bench">
      <svg class="bench-svg" viewBox="0 0 800 340" aria-hidden="true">
        <defs>
          <linearGradient id="beamGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#9fd8ff" />
            <stop offset="0.5" stop-color="#c8b6ff" />
            <stop offset="1" stop-color="#ffd0e8" />
          </linearGradient>
        </defs>
        <rect x="30" y="150" width="44" height="40" rx="4" fill="rgba(159,216,255,0.12)" stroke="rgba(159,216,255,0.5)" />
        <circle cx="74" cy="170" r="4" fill="#9fd8ff" />
        <rect x="742" y="146" width="34" height="48" rx="4" fill="rgba(159,216,255,0.08)" stroke="rgba(159,216,255,0.35)" id="benchSensor" />
        <polyline id="beamPath" points="74,170" fill="none" stroke="url(#beamGrad)" stroke-width="2.5" stroke-linejoin="round" opacity="0.9" />
        <polygon points="280,96 256,144 304,144" fill="rgba(159,216,255,0.10)" stroke="rgba(159,216,255,0.55)" data-prism-shape="1" />
        <polygon points="470,196 446,244 494,244" fill="rgba(159,216,255,0.10)" stroke="rgba(159,216,255,0.55)" data-prism-shape="2" />
        <polygon points="620,86 596,134 644,134" fill="rgba(159,216,255,0.10)" stroke="rgba(159,216,255,0.55)" data-prism-shape="3" />
      </svg>
      <button type="button" class="prism-btn" data-prism="1" data-n="1.52" style="left:35%; top:35%;" aria-label="Prism, refractive index 1.52"><span>n 1.52</span></button>
      <button type="button" class="prism-btn" data-prism="2" data-n="1.46" style="left:58.75%; top:64.7%;" aria-label="Prism, refractive index 1.46"><span>n 1.46</span></button>
      <button type="button" class="prism-btn" data-prism="3" data-n="1.74" style="left:77.5%; top:32.4%;" aria-label="Prism, refractive index 1.74"><span>n 1.74</span></button>
      <div class="bench-hud">
        <span class="bench-status" id="benchStatus" aria-live="polite">Beam idle at the emitter.</span>
        <button type="button" class="bench-reset" id="benchReset">Reset bench</button>
      </div>
    </div>
  </section>

  <section class="section tight craft-cta" data-reveal="up">
    <a href="/website12/specs" class="btn-ghost">Read the full spec →</a>
    <a href="/website12/commission" class="btn-cta">Commission a piece</a>
  </section>

  <style>
    /* ===== R3: "Route the beam" optische bank ===== */
    .bench-sect .bench-head { max-width: 720px; margin-bottom: 34px; }
    .bench-sect h2 { font-size: clamp(2rem,3.8vw,3rem); color: #fff; margin: 12px 0 16px; }
    .bench-sect p { color: var(--muted); line-height: 1.75; }
    .bench-sect p em { color: var(--ice-soft); font-style: italic; }
    .bench { position: relative; border: 1px solid var(--hair-soft); border-radius: 8px; background: rgba(8, 14, 22, 0.5); overflow: hidden; }
    .bench-svg { display: block; width: 100%; height: auto; }
    .prism-btn { position: absolute; transform: translate(-50%, -50%); width: 72px; height: 72px; background: none; border: none; cursor: pointer; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 2px; }
    .prism-btn span { font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: rgba(180, 215, 245, 0.8); letter-spacing: 0.08em; background: rgba(8, 14, 22, 0.7); padding: 2px 7px; border-radius: 3px; transition: color .3s, box-shadow .3s; }
    .prism-btn:hover span, .prism-btn:focus-visible span { color: #dff0ff; box-shadow: 0 0 12px rgba(159, 216, 255, 0.3); }
    .prism-btn:focus-visible { outline: 1px solid #9fd8ff; outline-offset: 2px; border-radius: 6px; }
    .prism-btn.routed span { color: #0a1420; background: #9fd8ff; }
    .bench-hud { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 12px 16px; border-top: 1px solid var(--hair-soft); flex-wrap: wrap; }
    .bench-status { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: rgba(180, 215, 245, 0.85); }
    html.bench-calibrated .bench-status { color: #b8ffd9; }
    .bench-reset { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); background: none; border: 1px solid var(--hair-soft); border-radius: 3px; padding: 6px 12px; cursor: pointer; }
    .bench-reset:hover { color: #dff0ff; }

    .steps { display: flex; flex-direction: column; }
    .step { display: grid; grid-template-columns: 120px 1fr; gap: clamp(20px,4vw,48px); padding: 40px 0; border-top: 1px solid var(--hair-soft); align-items: start; }
    .step:last-child { border-bottom: 1px solid var(--hair-soft); }
    .st-n { font-family: var(--serif); font-size: clamp(2.6rem,5vw,4rem); color: var(--ice-deep); line-height: 1; }
    .st-body h2 { font-size: clamp(1.8rem,3.4vw,2.8rem); color: #fff; }
    .st-body p { color: var(--muted); margin-top: 16px; line-height: 1.8; max-width: 64ch; font-size: 1.05rem; }

    .why-band { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(28px,5vw,60px); align-items: center; }
    .wb-copy { min-width: 0; }
    .wb-copy h2 { font-size: clamp(2rem,3.8vw,3rem); color: #fff; margin: 12px 0 20px; }
    .wb-copy p { color: var(--muted); line-height: 1.8; max-width: 52ch; }
    .wb-note { margin-top: 16px; color: var(--ice-soft); font-style: italic; font-family: var(--serif); font-size: 1.2rem; }
    .wb-media { border-radius: 8px; overflow: hidden; aspect-ratio: 5/4; border: 1px solid var(--hair-soft); }
    .wb-media img { width: 100%; height: 100%; object-fit: cover; }

    .craft-cta { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }

    @media (max-width: 860px) { .step { grid-template-columns: 1fr; gap: 8px; } .why-band { grid-template-columns: 1fr; } }
  </style>

  <script>
    /* R3 "Route the beam" , volgorde-puzzel: oplopende brekingsindex. */
    (() => {
      const ORDER = ['2', '1', '3']; // n 1.46 -> 1.52 -> 1.74
      const POS: Record<string, [number, number]> = { '1': [280, 128], '2': [470, 228], '3': [620, 118] };
      const START: [number, number] = [74, 170];
      const SENSOR: [number, number] = [742, 170];
      const beam = document.getElementById('beamPath');
      const status = document.getElementById('benchStatus');
      const prisms = Array.from(document.querySelectorAll<HTMLButtonElement>('.prism-btn'));
      const resetBtn = document.getElementById('benchReset');
      if (!beam || !status || !prisms.length) return;
      let progress: string[] = [];

      const draw = () => {
        const pts = [START, ...progress.map((id) => POS[id])];
        if (progress.length === ORDER.length) pts.push(SENSOR);
        beam.setAttribute('points', pts.map((p) => p.join(',')).join(' '));
      };
      const setCalibrated = (on: boolean) => {
        document.documentElement.classList.toggle('bench-calibrated', on);
        try { localStorage.setItem('aether-bench', on ? '1' : '0'); } catch { /* private mode */ }
      };
      const reset = (msg?: string) => {
        progress = [];
        prisms.forEach((b) => b.classList.remove('routed'));
        draw();
        status.textContent = msg || 'Beam idle at the emitter.';
        setCalibrated(false);
      };
      prisms.forEach((b) => b.addEventListener('click', () => {
        const id = b.dataset.prism || '';
        if (progress.includes(id)) return;
        if (ORDER[progress.length] === id) {
          progress.push(id);
          b.classList.add('routed');
          draw();
          if (progress.length === ORDER.length) {
            status.textContent = 'BENCH CALIBRATED - dispersion 0.0042 across three indices. The sensor is lit.';
            setCalibrated(true);
          } else {
            status.textContent = `Beam through n ${b.dataset.n} - keep the index ascending.`;
          }
        } else {
          reset(`Beam lost at n ${b.dataset.n} - the index must ascend. Bench reset.`);
        }
      }));
      resetBtn?.addEventListener('click', () => reset());
      // herstel gecalibreerde staat visueel bij terugkeer
      try {
        if (localStorage.getItem('aether-bench') === '1') {
          progress = [...ORDER];
          prisms.forEach((b) => b.classList.add('routed'));
          draw();
          status.textContent = 'BENCH CALIBRATED - dispersion 0.0042 across three indices. The sensor is lit.';
          document.documentElement.classList.add('bench-calibrated');
        }
      } catch { /* private mode */ }
    })();
  </script>
</AetherLayout>