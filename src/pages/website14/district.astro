---
/**
 * NEON DISTRICT , District (website14, round 2). Signature: a live node map , click a node for its
 * role, latency, and load, with connected edges lit.
 */
import NeonLayout from '../../layouts/NeonLayout.astro';
import { NODES, EDGES } from '../../data/neon';

const pos = Object.fromEntries(NODES.map((n) => [n.id, n]));
const VB = { w: 100, h: 64 };
---

<NeonLayout title="District | Neon District" description="The Neon District live node map , ingress to egress, edge to edge. Select a node for its role, latency, and load." active="district">
  <div class="page-hero">
    <span class="kicker">District</span>
    <h1>The map is <em>live</em>.</h1>
    <p class="sub">Five nodes carry the district from ingress to egress. Select one to read its role and current pulse , latency and load update as the surface runs.</p>
  </div>

  <section class="section tight">
    <div class="dist-grid">
      <div class="map panel ticked">
        <svg viewBox={`0 0 ${VB.w} ${VB.h}`} class="dmap" role="img" aria-label="District node map">
          <g class="edges">
            {EDGES.map(([a, b]) => (
              <line class="edge" data-a={a} data-b={b} x1={pos[a].x} y1={pos[a].y * VB.h / 100} x2={pos[b].x} y2={pos[b].y * VB.h / 100} />
            ))}
          </g>
          {NODES.map((n, i) => (
            <g class={`dnode ${n.c} ${i === 2 ? 'active' : ''}`} data-id={n.id} tabindex="0" role="button" aria-label={n.id} transform={`translate(${n.x} ${n.y * VB.h / 100})`}>
              <circle class="dn-halo" r="5.4" />
              <circle class="dn-dot" r="2.4" />
              <text class="dn-label" y="-4.2" text-anchor="middle">{n.id}</text>
            </g>
          ))}
        </svg>
        <div class="map-read"><span class="dmr" id="mapRead">CORE · COMPUTE / RUNTIME</span></div>
      </div>

      <aside class="dist-readout">
        {NODES.map((n, i) => (
          <article class={`dread ${n.c} ${i === 2 ? 'active' : ''}`} id={`dr-${n.id}`}>
            <div class="dr-head"><span class="dr-id">{n.id}</span><span class="dr-dot"></span></div>
            <span class="dr-role">{n.role}</span>
            <div class="dr-metrics">
              <div class="drm"><span>Latency</span><b>{n.latency}</b></div>
              <div class="drm"><span>Load</span><b>{n.load}</b><div class="drm-track"><span style={`width:${n.load}`}></span></div></div>
            </div>
          </article>
        ))}
        <a href="/website14/pulse" class="btn-ghost" style="width:100%; text-align:center;">Watch the pulse →</a>
      </aside>
    </div>
  </section>

  <style>
    .dist-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(18px,3vw,36px); align-items: start; }
    .map { padding: 16px; position: relative; min-width: 0; }
    .dmap { width: 100%; height: auto; display: block; overflow: visible; }
    .edge { stroke: var(--line); stroke-width: 0.4; transition: stroke 0.4s, stroke-width 0.4s; }
    .edge.lit { stroke: var(--accent); stroke-width: 0.7; filter: drop-shadow(0 0 1px var(--accent)); }
    .dnode { cursor: pointer; outline: none; }
    .dn-halo { fill: transparent; opacity: 0; transition: opacity 0.4s; }
    .dn-dot { stroke-width: 0.5; transition: all 0.3s; }
    .dnode.cyan .dn-dot { fill: rgba(47,252,255,0.15); stroke: var(--cyan); } .dnode.cyan .dn-halo { fill: rgba(47,252,255,0.12); }
    .dnode.mag .dn-dot { fill: rgba(255,43,214,0.15); stroke: var(--mag); } .dnode.mag .dn-halo { fill: rgba(255,43,214,0.12); }
    .dnode.lime .dn-dot { fill: rgba(183,255,60,0.15); stroke: var(--lime); } .dnode.lime .dn-halo { fill: rgba(183,255,60,0.12); }
    .dn-label { font-family: var(--mono); font-size: 2.6px; letter-spacing: 0.1em; fill: var(--muted); transition: fill 0.3s; }
    .dnode:hover .dn-label, .dnode:focus .dn-label, .dnode.active .dn-label { fill: #fff; }
    .dnode.active .dn-halo { opacity: 1; }
    .dnode.active .dn-dot { filter: drop-shadow(0 0 1.4px currentColor); }
    .dnode.cyan.active .dn-dot { fill: rgba(47,252,255,0.4); } .dnode.mag.active .dn-dot { fill: rgba(255,43,214,0.4); } .dnode.lime.active .dn-dot { fill: rgba(183,255,60,0.4); }
    .dnode.dim { opacity: 0.4; transition: opacity 0.4s; }
    .map-read { position: absolute; left: 18px; bottom: 14px; }
    .dmr { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; color: var(--muted); }

    .dist-readout { position: sticky; top: 76px; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .dread { display: none; border: 1px solid var(--line); border-radius: 6px; padding: 24px; background: var(--panel); }
    .dread.active { display: block; animation: fade 0.4s var(--ease); }
    @keyframes fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    .dread.cyan { --nc: var(--cyan); } .dread.mag { --nc: var(--mag); } .dread.lime { --nc: var(--lime); }
    .dr-head { display: flex; justify-content: space-between; align-items: center; }
    .dr-id { font-family: var(--disp); font-weight: 700; font-size: 1.8rem; color: #fff; }
    .dr-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--nc); box-shadow: 0 0 12px var(--nc); }
    .dr-role { font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--nc); display: block; margin: 6px 0 22px; }
    .dr-metrics { display: flex; flex-direction: column; gap: 16px; }
    .drm { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .drm > span { font-family: var(--mono); font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); width: 70px; }
    .drm > b { font-family: var(--mono); font-size: 1.3rem; color: #fff; }
    .drm-track { flex: 1 1 100%; height: 4px; background: rgba(236,242,255,0.1); border-radius: 100px; overflow: hidden; margin-top: 6px; }
    .drm-track span { display: block; height: 100%; background: var(--nc); border-radius: 100px; }

    @media (max-width: 860px) { .dist-grid { grid-template-columns: 1fr; } .dist-readout { position: static; } .dn-label { font-size: 3.4px; } }
  </style>

  <script>
    const edges = Array.from(document.querySelectorAll<SVGLineElement>('.edge'));
    const nodes = Array.from(document.querySelectorAll<SVGGElement>('.dnode'));
    const reads = Array.from(document.querySelectorAll<HTMLElement>('.dread'));
    const mapRead = document.getElementById('mapRead')!;
    const roleOf: Record<string, string> = {};
    reads.forEach((r) => { roleOf[r.id.replace('dr-', '')] = r.querySelector('.dr-role')?.textContent || ''; });
    function select(id: string) {
      const nb = new Set<string>([id]);
      edges.forEach((e) => { const a = e.dataset.a!, b = e.dataset.b!; const lit = a === id || b === id; e.classList.toggle('lit', lit); if (lit) { nb.add(a); nb.add(b); } });
      nodes.forEach((n) => { const nid = n.dataset.id!; n.classList.toggle('active', nid === id); n.classList.toggle('dim', !nb.has(nid)); });
      reads.forEach((r) => r.classList.toggle('active', r.id === `dr-${id}`));
      mapRead.textContent = `${id} · ${(roleOf[id] || '').toUpperCase()}`;
    }
    nodes.forEach((n) => { n.addEventListener('click', () => select(n.dataset.id!)); n.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') { e.preventDefault(); select(n.dataset.id!); } }); });
    select('CORE');
  </script>
</NeonLayout>