---
/**
 * ATELIER PRIVATE CATERING , Sourcing (website17, round 2). The suppliers + the season-led approach.
 */
import AtelierLayout from '../../layouts/AtelierLayout.astro';
import { SOURCING } from '../../data/atelier';
---

<AtelierLayout title="Sourcing | Atelier Private Catering" description="Season-led sourcing from farms, day-boats, and small makers. Hand-dived scallops, Périgord truffle, heritage micro-herbs." active="sourcing">
  <div class="page-hero">
    <span class="eyebrow">Sourcing</span>
    <h1>We build around what's <em>best</em>.</h1>
    <p class="sub">The menu follows the supply, never the other way round. We buy from farms, day-boats, and small makers we know by name, and set the table around whatever is at its peak that week.</p>
  </div>

  <section class="section">
    <div class="src-list">
      {SOURCING.map((s) => (
        <article class="src-block" data-reveal="up">
          <span class="sb-id">{s.id}</span>
          <div class="sb-body">
            <div class="sb-top"><h2>{s.item}</h2><span class="sb-type">{s.type}</span></div>
            <span class="sb-origin">{s.origin}</span>
            <p>{s.note}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section tight">
    <div class="season-band panel copper">
      <span class="eyebrow">Season-led</span>
      <h2>If it isn't ready, it isn't on.</h2>
      <p>We would rather drop a course than serve it out of season. The shortest, freshest supply chain we can find sets what you eat , which is why the final menu is confirmed close to the date, not months before it.</p>
      <div class="sb-actions"><a href="/website17/menus" class="btn-ghost">See the menus</a><a href="/website17/reserve" class="btn-cta">Compose an evening</a></div>
    </div>
  </section>

  <style>
    .src-list { display: flex; flex-direction: column; }
    .src-block { display: grid; grid-template-columns: 90px 1fr; gap: clamp(20px,4vw,48px); padding: 44px 0; border-top: 1px solid var(--line); align-items: start; }
    .src-block:last-child { border-bottom: 1px solid var(--line); }
    .sb-id { font-family: var(--head); font-size: clamp(2.2rem,4vw,3.4rem); color: var(--copper-deep); line-height: 1; }
    .sb-top { display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; }
    .sb-top h2 { font-size: clamp(1.9rem,3.6vw,2.8rem); color: #fff; }
    .sb-type { font-family: var(--body); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--copper); border: 1px solid var(--line-copper); padding: 4px 10px; border-radius: 999px; }
    .sb-origin { font-family: var(--head); font-style: italic; font-size: 1.3rem; color: var(--copper-bright); display: block; margin: 8px 0 14px; }
    .src-block p { color: var(--muted); line-height: 1.8; max-width: 60ch; font-size: 1.05rem; }

    .season-band { padding: clamp(30px,4vw,46px); max-width: 820px; }
    .season-band .eyebrow { margin-bottom: 16px; }
    .season-band h2 { font-size: clamp(2rem,3.8vw,3rem); color: #fff; }
    .season-band p { color: var(--muted); margin: 16px 0 24px; line-height: 1.8; max-width: 58ch; }
    .sb-actions { display: flex; gap: 12px; flex-wrap: wrap; }

    @media (max-width: 860px) { .src-block { grid-template-columns: 1fr; gap: 8px; } }
  </style>
</AtelierLayout>