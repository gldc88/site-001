---
/**
 * OVERSEAS LINE , The Ship / Suites (website5, round 2). Signature: a suite-category selector.
 */
import OverseasLayout from '../../layouts/OverseasLayout.astro';

const SUITES = [
  { id: 'horizon', n: '01', name: 'Horizon Suite', size: '42 m²', view: 'Private balcony', rate: '38,000',
    desc: 'The entry to the all-suite house, and bigger than most owner cabins elsewhere. A private balcony to the sea line, a real bed, a deep bath, and a butler who appears only when wanted.',
    amen: ['Private balcony', 'Deep soaking bath', 'Dedicated butler', 'Walk-in dressing', 'Pillow & scent menu', 'In-suite dining'] },
  { id: 'garden', n: '02', name: 'Garden Terrace', size: '56 m²', view: 'Open-air garden', rate: '52,000',
    desc: 'A suite wrapped around a private open-air garden , salt air and green at once. The quietest mid-ship position, away from every thoroughfare on the ship.',
    amen: ['Open-air garden', 'Outdoor daybed', 'Mid-ship, silent', 'Twin vanities', 'Espresso & cellar', 'Heated floors'] },
  { id: 'owner', n: '03', name: "Owner's Suite", size: '78 m²', view: 'Wraparound terrace', rate: '64,000',
    desc: 'A wraparound terrace that follows the horizon from bow to beam. A separate study, a dining room for eight, and a butler plus a host who learn your hours by the second day.',
    amen: ['Wraparound terrace', 'Separate study', 'Dining for eight', 'Butler & host', 'Private spa booking', 'Forward views'] },
  { id: 'grand', n: '04', name: 'Grand Duplex', size: '120 m²', view: 'Two decks', rate: 'On Request',
    desc: 'The top of the ship across two decks, with its own stair, a private plunge on the terrace, and a crew briefed to your file. Released to a single party per crossing.',
    amen: ['Two private decks', 'Terrace plunge', 'Private stair', 'Crew to your file', 'Guaranteed spa hours', 'Discreet embark'] },
];
---

<OverseasLayout title="The Ship | OVERSEAS LINE" description="An all-suite liner , from the Horizon Suite to the Grand Duplex , quiet, butler-served, and built for the crossing." active="ship">
  <section class="page-hero">
    <div class="page-hero-media"><img src="/website5/suite.jpg" alt="A suite aboard the liner" fetchpriority="high" /></div>
    <div class="page-hero-scrim" aria-hidden="true"></div>
    <div class="page-hero-inner">
      <span class="eyebrow">The Ship</span>
      <h1>An all-suite <em>liner</em>.</h1>
      <p class="sub">No staterooms, no inside cabins, no class system , every room is a suite, and every suite has a butler. Four ways to cross, each released quietly and held for one party at a time.</p>
    </div>
  </section>

  <section class="section tight">
    <div class="picker">
      <div class="picker-list" role="tablist" aria-label="Choose a suite">
        {SUITES.map((s, i) => (
          <button class={`p-tab${i === 0 ? ' active' : ''}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-target={s.id}>
            <span class="pt-n">{s.n}</span>
            <span class="pt-b"><span class="pt-name">{s.name}</span><span class="pt-meta">{s.size} · {s.view}</span></span>
            <span class="pt-rate">{s.rate === 'On Request' ? 'Enquire' : `¥${s.rate}`}</span>
          </button>
        ))}
      </div>
      <div class="picker-stage">
        {SUITES.map((s, i) => (
          <article class={`s-panel${i === 0 ? ' active' : ''}`} id={s.id} aria-hidden={i === 0 ? 'false' : 'true'}>
            <span class="eyebrow">Suite {s.n}</span>
            <h2>{s.name}</h2>
            <div class="s-stats">
              <div class="s-stat"><span class="ss-k">Size</span><span class="ss-v">{s.size}</span></div>
              <div class="s-stat"><span class="ss-k">Aspect</span><span class="ss-v">{s.view}</span></div>
              <div class="s-stat"><span class="ss-k">Service</span><span class="ss-v">Butler</span></div>
            </div>
            <p class="s-desc">{s.desc}</p>
            <div class="s-amen">{s.amen.map((a) => <span class="chip">{a}</span>)}</div>
            <div class="s-foot">
              <div class="s-rate"><span class="rl">From, per crossing</span><span class="rv">{s.rate === 'On Request' ? 'On Request' : `¥${s.rate}`}</span></div>
              <a href="/website5/concierge" class="btn-cta">Hold this suite</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <style>
    .picker { display: grid; grid-template-columns: 0.9fr 1.4fr; gap: clamp(22px,4vw,50px); align-items: start; }
    .picker-list, .picker-stage { min-width: 0; }
    .picker-list { display: flex; flex-direction: column; border-top: 1px solid var(--hair-soft); }
    .p-tab { display: grid; grid-template-columns: 32px 1fr auto; align-items: center; gap: 14px; text-align: left; padding: 24px 12px; border-bottom: 1px solid var(--hair-soft); position: relative; transition: background 0.4s var(--ease), padding 0.4s var(--ease); }
    .p-tab::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--gold); transform: scaleY(0); transform-origin: top; transition: transform 0.45s var(--ease); }
    .p-tab:hover { background: rgba(255,255,255,0.02); }
    .p-tab.active { background: rgba(214,184,135,0.05); padding-left: 20px; }
    .p-tab.active::before { transform: scaleY(1); }
    .pt-n { font-family: var(--serif); font-size: 17px; color: var(--faint); }
    .p-tab.active .pt-n { color: var(--gold); }
    .pt-b { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .pt-name { font-family: var(--serif); font-size: clamp(1.15rem,1.7vw,1.5rem); color: #fff; }
    .pt-meta { font-family: var(--mono); font-size: 8px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
    .pt-rate { font-family: var(--mono); font-size: 10px; color: var(--gold); white-space: nowrap; }

    .s-panel { display: none; min-width: 0; }
    .s-panel.active { display: block; animation: fadeup 0.5s var(--ease); }
    @keyframes fadeup { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
    .s-panel h2 { font-size: clamp(2.2rem,4vw,3.4rem); color: #fff; margin-top: 12px; }
    .s-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--hair-soft); border: 1px solid var(--hair-soft); margin-top: 24px; }
    .s-stat { background: var(--bg); padding: 18px 16px; display: flex; flex-direction: column; gap: 6px; }
    .ss-k { font-family: var(--mono); font-size: 8px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
    .ss-v { font-family: var(--serif); font-size: 1.2rem; color: #fff; }
    .s-desc { color: var(--muted); line-height: 1.85; margin-top: 24px; max-width: 60ch; }
    .s-amen { margin-top: 26px; display: flex; flex-wrap: wrap; gap: 8px; }
    .chip { font-family: var(--mono); font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; color: #cfc7b6; border: 1px solid var(--hair-soft); padding: 8px 12px; transition: border-color 0.3s, color 0.3s; }
    .chip:hover { border-color: var(--hair); color: var(--gold); }
    .s-foot { margin-top: 36px; display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap; }
    .s-rate { display: flex; flex-direction: column; gap: 4px; }
    .s-rate .rl { font-family: var(--mono); font-size: 8.5px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
    .s-rate .rv { font-family: var(--serif); font-size: 2rem; color: var(--gold); }
    @media (max-width: 900px) { .picker { grid-template-columns: 1fr; } }
    @media (max-width: 480px) { .s-stats { grid-template-columns: 1fr; } }
  </style>

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.p-tab'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.s-panel'));
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      const id = tab.dataset.target;
      tabs.forEach((t) => { const on = t === tab; t.classList.toggle('active', on); t.setAttribute('aria-selected', String(on)); });
      panels.forEach((p) => { const on = p.id === id; p.classList.toggle('active', on); p.setAttribute('aria-hidden', String(!on)); });
    }));
  </script>
</OverseasLayout>