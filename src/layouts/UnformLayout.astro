---
/**
 * UnformLayout , shared shell for UNFORM / 010 (website10, round 2).
 * OS menu bar + live clock, persistent WebGL wireframe-window field, glass status bar.
 * Restores the Settings-chosen theme (CSS vars) from localStorage on every page.
 * Props: title, description, active.
 */
import '../styles/unform.css';
import MotionRuntime from '../components/motion/MotionRuntime.astro';

interface Props { title: string; description?: string; active?: string; }
const { title, description = '', active = '' } = Astro.props;

const NAV = [
  { key: 'work', label: 'Work', href: '/website10/work' },
  { key: 'studio', label: 'Studio', href: '/website10/studio' },
  { key: 'settings', label: 'Settings', href: '/website10/settings' },
  { key: 'contact', label: 'Contact', href: '/website10/contact' },
];
const YEAR = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      // Apply saved theme before paint so it carries across pages (no flash).
      try {
        const t = JSON.parse(localStorage.getItem('unform-theme') || '{}');
        const r = document.documentElement;
        if (t.accent) r.style.setProperty('--accent', t.accent);
        if (t.accent2) r.style.setProperty('--accent2', t.accent2);
        if (t.radius != null) r.style.setProperty('--radius', t.radius + 'px');
        if (t.density != null) r.style.setProperty('--density', t.density);
        if (t.wash != null) r.style.setProperty('--wash', t.wash);
      } catch (e) {}
    </script>
  </head>

  <body>
    <canvas id="bg-gl" class="bg-gl" aria-hidden="true"></canvas>

    <div class="menubar" id="menubar">
      <div class="mb-left">
        <a href="/website10" class="mb-brand"><span class="led"></span>UNFORM / 010</a>
        <div class="mb-links">
          {NAV.map((i) => <a href={i.href} class={active === i.key ? 'active' : ''}>{i.label}</a>)}
        </div>
      </div>
      <div class="mb-right">
        <a href="/" class="mb-index">/ index</a>
        <span class="mb-clock" id="clock">--:--</span>
      </div>
    </div>

    <main class="content" id="top">
      <slot />
    </main>

    <footer class="statusbar">
      <span>UNFORM / 010 , anti-template studio · © {YEAR} · demonstration only</span>
      <div class="sb-links">
        <a href="/website10/work">Work</a><a href="/website10/studio">Studio</a><a href="/website10/settings">Settings</a><a href="/website10/contact">Contact</a><a href="#top">↑ top</a>
      </div>
    </footer>

    <button type="button" class="cmdk-chip" id="cmdkChip" aria-haspopup="dialog">
      <kbd>Ctrl</kbd><kbd>K</kbd><span>run</span>
    </button>
    <div class="cmdk" id="cmdk" role="dialog" aria-label="Command palette" hidden>
      <div class="cmdk-box">
        <input type="text" class="cmdk-input" id="cmdkInput" placeholder="Type a command…" aria-label="Command" autocomplete="off" spellcheck="false" />
        <ul class="cmdk-list" id="cmdkList" role="listbox" aria-label="Commands"></ul>
        <div class="cmdk-out" id="cmdkOut" aria-live="polite"></div>
      </div>
    </div>

    <MotionRuntime />

    <script>
      import { supportsWebGL } from '../lib/three/webgl';
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- R3 "010 Command Palette" ---- */
      type Cmd = { label: string; hint: string; run: () => string | void };
      const THEMES: Record<string, { a: string; b: string }> = {
        cobalt: { a: '#3b82f6', b: '#a855f7' },
        violet: { a: '#8b5cf6', b: '#ec4899' },
        emerald: { a: '#10b981', b: '#3b82f6' },
        amber: { a: '#f59e0b', b: '#ef4444' },
        rose: { a: '#f43f5e', b: '#8b5cf6' },
        cyan: { a: '#06b6d4', b: '#6366f1' },
      };
      const applyTheme = (name: string): string => {
        const t = THEMES[name];
        if (!t) return 'unknown theme';
        let saved: Record<string, unknown> = {};
        try { saved = JSON.parse(localStorage.getItem('unform-theme') || '{}'); } catch { /* private mode */ }
        saved.accent = t.a; saved.accent2 = t.b;
        try { localStorage.setItem('unform-theme', JSON.stringify(saved)); } catch { /* private mode */ }
        document.documentElement.style.setProperty('--accent', t.a);
        document.documentElement.style.setProperty('--accent2', t.b);
        return `theme set: ${name}`;
      };
      const COMMANDS: Cmd[] = [
        { label: 'open desktop', hint: 'home', run: () => { location.href = '/website10'; } },
        { label: 'open work', hint: 'file browser', run: () => { location.href = '/website10/work'; } },
        { label: 'open studio', hint: 'manifesto', run: () => { location.href = '/website10/studio'; } },
        { label: 'open settings', hint: 'theme lab', run: () => { location.href = '/website10/settings'; } },
        { label: 'open contact', hint: 'console', run: () => { location.href = '/website10/contact'; } },
        ...Object.keys(THEMES).map((n) => ({ label: `theme: ${n}`, hint: 'accent swap', run: () => applyTheme(n) })),
        { label: 'reset theme', hint: 'factory defaults', run: () => { try { localStorage.removeItem('unform-theme'); } catch { /* private */ } ['--accent','--accent2','--radius','--density','--wash'].forEach((v) => document.documentElement.style.removeProperty(v)); return 'theme reset'; } },
        { label: 'whoami', hint: 'identity', run: () => 'guest @ 010 , the anti-template studio' },
        { label: 'log out', hint: 'back to index', run: () => { location.href = '/'; } },
      ];

      const cmdk = document.getElementById('cmdk');
      const cmdkChip = document.getElementById('cmdkChip');
      const cmdkInput = document.getElementById('cmdkInput') as HTMLInputElement | null;
      const cmdkList = document.getElementById('cmdkList');
      const cmdkOut = document.getElementById('cmdkOut');
      let matches: Cmd[] = [];
      let sel = 0;

      const renderList = () => {
        const q = (cmdkInput?.value || '').toLowerCase().trim();
        matches = COMMANDS.filter((c) => c.label.includes(q) || c.hint.includes(q));
        sel = Math.min(sel, Math.max(0, matches.length - 1));
        if (cmdkList) cmdkList.innerHTML = matches.map((c, i) =>
          `<li role="option" id="cmd-${i}" aria-selected="${i === sel}" class="${i === sel ? 'sel' : ''}"><span>${c.label}</span><em>${c.hint}</em></li>`).join('')
          || '<li class="none">no such command</li>';
        cmdkInput?.setAttribute('aria-activedescendant', matches.length ? `cmd-${sel}` : '');
      };
      const openPalette = () => {
        cmdk?.removeAttribute('hidden');
        if (cmdkInput) { cmdkInput.value = ''; }
        if (cmdkOut) cmdkOut.textContent = '';
        sel = 0;
        renderList();
        cmdkInput?.focus();
      };
      const closePalette = () => { cmdk?.setAttribute('hidden', ''); cmdkChip?.focus(); };
      const runSel = () => {
        const c = matches[sel];
        if (!c) return;
        const out = c.run();
        if (typeof out === 'string') { if (cmdkOut) cmdkOut.textContent = out; }
        else closePalette();
      };
      cmdkChip?.addEventListener('click', openPalette);
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); if (cmdk?.hasAttribute('hidden')) openPalette(); else closePalette(); return; }
        if (cmdk?.hasAttribute('hidden')) return;
        if (e.key === 'Escape') { closePalette(); }
        else if (e.key === 'ArrowDown') { e.preventDefault(); sel = Math.min(sel + 1, matches.length - 1); renderList(); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); sel = Math.max(sel - 1, 0); renderList(); }
        else if (e.key === 'Enter') { e.preventDefault(); runSel(); }
      });
      cmdkInput?.addEventListener('input', () => { sel = 0; renderList(); });
      cmdkList?.addEventListener('click', (e) => {
        const li = (e.target as HTMLElement).closest('li[role=option]');
        if (!li) return;
        sel = Number(li.id.replace('cmd-', ''));
        renderList();
        runSel();
      });
      cmdk?.addEventListener('click', (e) => { if (e.target === cmdk) closePalette(); });

      // live clock
      const clock = document.getElementById('clock');
      const tick = () => { if (clock) clock.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); };
      tick(); setInterval(tick, 10000);

      const canvas = document.getElementById('bg-gl');
      if (!reduce && canvas instanceof HTMLCanvasElement && supportsWebGL()) {
        import('../scenes/unform-scene')
          .then(({ initUnformScene }) => {
            const scene = initUnformScene(canvas);
            window.addEventListener('pagehide', () => scene.dispose(), { once: true });
          })
          .catch(() => { if (canvas) canvas.style.opacity = '0'; });
      } else if (canvas instanceof HTMLCanvasElement) {
        canvas.style.opacity = '0';
      }
    </script>
  </body>
</html>