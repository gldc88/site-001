---
/**
 * CaliberLayout , shared shell for CALIBER STUDIO (website29, round 2). Deep technical palette, monospace,
 * technical-blue accent. Nav, footer, global #toast (window.showToast). Props: title, description, active.
 */
import '../styles/global.css';
import { BRAND, TAGLINE, AREA, EMAIL, PHONE, TEL } from '../data/caliber';

interface Props { title: string; description?: string; active?: string; }
const { title, description = '', active = '' } = Astro.props;

const NAV = [
  { key: 'craft', label: 'Craft', href: '/website29/craft' },
  { key: 'platforms', label: 'Platforms', href: '/website29/platforms' },
  { key: 'configurator', label: 'Configurator', href: '/website29/configurator' },
];
const YEAR = new Date().getFullYear();
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <style>
      :root { --bg0:#050608; --bg1:#0a0c10; --ink:#eef2f6; --mut:rgba(238,242,246,.70); --line:rgba(238,242,246,.12); --accent:#7aaadd; --accent-glow:rgba(122,170,221,.25); }
      body { color: var(--ink); font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Courier New", monospace; -webkit-font-smoothing: antialiased;
        background: radial-gradient(circle at 50% 0%, rgba(160,190,220,.12), transparent 70%), radial-gradient(circle at 10% 90%, rgba(255,200,150,.06), transparent 60%), linear-gradient(180deg, var(--bg0), var(--bg1)); background-attachment: fixed; }
      .accent { color: var(--accent); }
      .reveal-on-scroll { opacity:0; transform: translateY(18px); transition: all .8s cubic-bezier(0.2,0.8,0.2,1); }
      .reveal-visible { opacity:1; transform: translateY(0); }
      .k-link { position:relative; }
      .k-link::after { content:''; position:absolute; left:0; bottom:-4px; height:1px; width:0; background: var(--accent); transition: width .3s ease; }
      .k-link:hover::after, .k-link.active::after { width:100%; }
      .sec { transform-origin: 130px 175px; animation: tick 8s steps(60) infinite; }
      @keyframes tick { to { transform: rotate(360deg); } }
      @media (prefers-reduced-motion: reduce) { .sec { animation: none; } }
    </style>
  </head>

  <body class="min-h-screen overflow-x-hidden selection:bg-[#7aaadd] selection:text-black">
    <header class="sticky top-0 z-50 border-b border-[var(--line)] bg-[#050608]/85 backdrop-blur-md">
      <div class="mx-auto max-w-[1100px] px-6 h-16 flex items-center justify-between">
        <a href="/website29" class="flex items-center gap-2.5">
          <span class="grid place-items-center w-7 h-7 rounded-full border border-[var(--accent)]/50"><span class="w-2.5 h-2.5 rounded-full bg-[var(--accent)]"></span></span>
          <span class="font-bold tracking-[0.25em] text-sm uppercase">{BRAND}</span>
        </a>
        <nav class="hidden md:flex items-center gap-7 text-[10px] font-semibold uppercase tracking-[0.2em] text-[var(--mut)]">
          {NAV.map((i) => <a href={i.href} class={`k-link hover:text-[var(--ink)] transition-colors ${active === i.key ? 'active text-[var(--ink)]' : ''}`}>{i.label}</a>)}
          <a href="/" class="hover:text-[var(--ink)]">Index</a>
        </nav>
        <a href="/website29/commission" class="text-[10px] font-bold uppercase tracking-[0.2em] text-black bg-[var(--accent)] hover:bg-white px-4 py-2.5 rounded transition-colors">Commission</a>
      </div>
    </header>

    <main id="top"><slot /></main>

    <footer class="border-t border-[var(--line)] mt-10">
      <div class="mx-auto max-w-[1100px] px-6 py-12 grid md:grid-cols-[2fr_1fr_1fr] gap-10">
        <div>
          <div class="flex items-center gap-2.5 mb-3"><span class="grid place-items-center w-7 h-7 rounded-full border border-[var(--accent)]/50"><span class="w-2.5 h-2.5 rounded-full bg-[var(--accent)]"></span></span><span class="font-bold tracking-[0.2em] text-sm uppercase">{BRAND}</span></div>
          <p class="text-sm text-[var(--mut)] max-w-xs leading-relaxed">{TAGLINE} {AREA}. Fictional brand, demonstration only.</p>
        </div>
        <div class="text-[10px] font-semibold uppercase tracking-[0.2em] text-[var(--mut)] flex flex-col gap-3">
          <a href="/website29/craft" class="hover:text-[var(--accent)]">Craft</a>
          <a href="/website29/platforms" class="hover:text-[var(--accent)]">Platforms</a>
          <a href="/website29/configurator" class="hover:text-[var(--accent)]">Configurator</a>
          <a href="/website29/commission" class="hover:text-[var(--accent)]">Commission</a>
        </div>
        <div class="text-[10px] font-semibold uppercase tracking-[0.2em] text-[var(--mut)] flex flex-col gap-3">
          <a href={`mailto:${EMAIL}`} class="hover:text-[var(--accent)] normal-case tracking-normal">{EMAIL}</a>
          <a href={`tel:${TEL}`} class="hover:text-[var(--accent)]">{PHONE}</a>
          <a href="/" class="hover:text-[var(--accent)]">Return to index</a>
        </div>
      </div>
      <div class="border-t border-[var(--line)] py-5 text-center text-[10px] uppercase tracking-[0.25em] text-[var(--mut)]">© {YEAR} {BRAND} · commission desk / AMS · demonstration only</div>
    </footer>

    <div id="toast" role="status" aria-live="polite" class="fixed left-1/2 bottom-8 z-[80] -translate-x-1/2 translate-y-6 opacity-0 pointer-events-none rounded bg-[#0e1117] border border-[var(--accent)]/40 text-[var(--ink)] px-6 py-4 text-sm shadow-[0_0_40px_var(--accent-glow)] transition-all duration-500" style="max-width:min(92vw,470px)"></div>

    <script>
      const toastEl = document.getElementById('toast');
      let tT = 0;
      (window as any).showToast = (html: string) => {
        if (!toastEl) return;
        toastEl.innerHTML = html; toastEl.style.opacity = '1'; toastEl.style.transform = 'translate(-50%,0)';
        window.clearTimeout(tT); tT = window.setTimeout(() => { toastEl.style.opacity = '0'; toastEl.style.transform = 'translate(-50%,24px)'; }, 5400);
      };
      const obs = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('reveal-visible'); obs.unobserve(e.target); } }), { threshold: 0.1 });
      document.querySelectorAll('.reveal-on-scroll').forEach((el) => obs.observe(el));
    </script>
  </body>
</html>