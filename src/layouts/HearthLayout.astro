---
/**
 * HearthLayout , shared shell for HEARTH & GROVE (website21, round 2). Tailwind + scroll-season.
 * Persistent topographic WebGL survey + a scroll-driven seasonal colour shift (stone -> forest) that
 * writes CSS vars on body (the whole UI reads them) and drives the scene. Props: title, description, active.
 */
import '../styles/global.css';
import MotionRuntime from '../components/motion/MotionRuntime.astro';

interface Props { title: string; description?: string; active?: string; }
const { title, description = '', active = '' } = Astro.props;

const BRAND = 'HEARTH & GROVE.';
const NAV = [
  { key: 'services', label: 'Services', href: '/website21/services' },
  { key: 'specimens', label: 'Specimens', href: '/website21/specimens' },
  { key: 'process', label: 'Process', href: '/website21/process' },
];
const YEAR = new Date().getFullYear();
const Icon = {
  leaf: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="w-5 h-5"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path></svg>`,
  back: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-4 h-4"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>`,
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>

  <body class="antialiased font-sans" style="background-color: var(--bg-color, #0a0a0a); color: var(--text-color, #d6d3d1);">
    <canvas id="bg-gl" class="fixed inset-0 z-0 w-full h-full pointer-events-none" aria-hidden="true"></canvas>
    <div id="bgFallback" class="fixed inset-0 z-0 pointer-events-none" aria-hidden="true"
      style="background: radial-gradient(800px 600px at 78% 12%, rgba(120,113,108,0.08), transparent 60%), radial-gradient(800px 700px at 12% 88%, rgba(16,185,129,0.07), transparent 64%), #0a0a0a;"></div>
    <div class="fixed inset-0 z-[1] pointer-events-none" style="background: linear-gradient(180deg, rgba(8,9,9,0.55), transparent 30%, transparent 70%, rgba(8,9,9,0.7));"></div>

    <header class="fixed top-0 inset-x-0 z-50 border-b backdrop-blur-md transition-colors duration-300"
      style="border-color: var(--border-color, rgba(255,255,255,0.05)); background-color: var(--glass-bg, rgba(10,10,10,0.7))">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <div class="flex items-center gap-8">
          <a href="/" class="group flex items-center gap-2 text-[10px] uppercase tracking-widest hover:text-white transition-colors" style="color: var(--text-muted, #78716c)">
            <span class="group-hover:-translate-x-1 transition-transform duration-300"><Fragment set:html={Icon.back} /></span>
            Index
          </a>
          <a href="/website21" class="flex items-center gap-3 pl-8 border-l" style="border-color: var(--border-color, rgba(255,255,255,0.05))">
            <div style="color: var(--accent-color, #10b981)"><Fragment set:html={Icon.leaf} /></div>
            <span class="font-serif italic text-lg tracking-wide text-white">{BRAND}</span>
          </a>
        </div>
        <nav class="hidden md:flex items-center gap-10 text-[11px] font-semibold uppercase tracking-[0.15em]">
          {NAV.map((i) => <a href={i.href} class="hover:text-white transition-colors" style={`color: ${active === i.key ? 'var(--accent-color)' : 'var(--text-muted)'}`}>{i.label}</a>)}
        </nav>
        <a href="/website21/contact" class="text-[11px] font-bold uppercase tracking-widest px-5 py-2.5 rounded text-black transition-transform hover:-translate-y-0.5" style="background-color: var(--accent-color, #10b981)">Contact</a>
      </div>
    </header>

    <main class="relative z-10" id="top">
      <slot />
    </main>

    <footer class="relative z-10 border-t mt-20" style="border-color: var(--border-color, rgba(255,255,255,0.06)); background-color: var(--card-bg-dark, rgba(8,8,8,0.86))">
      <div class="max-w-7xl mx-auto px-6 py-16 flex flex-col md:flex-row justify-between gap-10">
        <div>
          <div class="flex items-center gap-3 mb-4"><div style="color: var(--accent-color)"><Fragment set:html={Icon.leaf} /></div><span class="font-serif italic text-xl text-white">{BRAND}</span></div>
          <p class="text-sm max-w-xs" style="color: var(--text-muted)">Landscape architecture , garden design, build, and care, planned in advance and executed without noise. Amsterdam · Haarlem · Utrecht. Fictional studio, demonstration only.</p>
        </div>
        <div class="flex gap-12 text-xs font-bold uppercase tracking-widest" style="color: var(--text-muted)">
          <div class="flex flex-col gap-3">
            <a href="/website21/services" class="hover:text-white transition-colors">Services</a>
            <a href="/website21/specimens" class="hover:text-white transition-colors">Specimens</a>
            <a href="/website21/process" class="hover:text-white transition-colors">Process</a>
            <a href="/website21/contact" class="hover:text-white transition-colors">Contact</a>
          </div>
          <div class="flex flex-col gap-3">
            <a href="mailto:hello@hearthgrove.example" class="hover:text-white transition-colors normal-case tracking-normal font-normal">hello@hearthgrove.example</a>
            <a href="/" class="hover:text-white transition-colors">Return to index</a>
          </div>
        </div>
      </div>
      <div class="border-t py-6 text-center text-[10px] uppercase tracking-widest" style="border-color: var(--border-color); color: var(--text-muted)">© {YEAR} Hearth &amp; Grove · built with restraint · demonstration only</div>
    </footer>

    <MotionRuntime />

    <script>
      import { supportsWebGL } from '../lib/three/webgl';
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const body = document.body;

      let scene: any = null;
      const mix = (a: number[], b: number[], p: number) => a.map((c, i) => Math.round(c + (b[i] - c) * p));
      const START = { bg: [10, 10, 10], text: [214, 211, 209], muted: [120, 113, 108], accent: [16, 185, 129] };
      const END = { bg: [6, 18, 13], text: [236, 253, 245], muted: [110, 200, 165], accent: [52, 211, 153] };
      let ticking = false;
      const paint = () => {
        ticking = false;
        const doc = document.documentElement;
        const p = Math.min(1, Math.max(0, window.scrollY / Math.max(1, doc.scrollHeight - doc.clientHeight)));
        const bg = mix(START.bg, END.bg, p), text = mix(START.text, END.text, p), muted = mix(START.muted, END.muted, p), accent = mix(START.accent, END.accent, p);
        body.style.setProperty('--bg-color', `rgb(${bg.join(',')})`);
        body.style.setProperty('--card-bg', `rgba(${bg.join(',')},0.55)`);
        body.style.setProperty('--card-bg-dark', `rgba(${Math.max(0, bg[0] - 4)},${Math.max(0, bg[1] - 4)},${Math.max(0, bg[2] - 4)},0.86)`);
        body.style.setProperty('--text-color', `rgb(${text.join(',')})`);
        body.style.setProperty('--text-muted', `rgb(${muted.join(',')})`);
        body.style.setProperty('--accent-color', `rgb(${accent.join(',')})`);
        body.style.setProperty('--border-color', `rgba(${accent.join(',')},${(0.06 + p * 0.16).toFixed(3)})`);
        body.style.setProperty('--glass-bg', `rgba(${bg.join(',')},0.7)`);
        scene?.setScroll(p); scene?.setSeason(p);
      };
      window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(paint); } }, { passive: true });
      paint();

      const canvas = document.getElementById('bg-gl');
      const fallback = document.getElementById('bgFallback');
      if (!reduce && canvas instanceof HTMLCanvasElement && supportsWebGL()) {
        import('../scenes/topo-scene')
          .then(({ initTopoScene }) => {
            scene = initTopoScene(canvas);
            if (fallback) fallback.style.display = 'none';
            paint();
            window.addEventListener('pagehide', () => scene?.dispose(), { once: true });
          })
          .catch(() => { if (canvas) canvas.style.display = 'none'; });
      } else if (canvas instanceof HTMLCanvasElement) {
        canvas.style.display = 'none';
      }
    </script>
  </body>
</html>